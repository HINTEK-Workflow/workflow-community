{
  "name": "workflow-community",
  "version": "0.78.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/sitemap/generate.cjs --build",
    "sitemap": "node scripts/sitemap/generate.cjs",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "licenses": "node scripts/licenses/collect.mjs",
    "integrity:check": "tsx scripts/ops/job.ts integrity:check scripts/integrity/check.ts",
    "credits:reconcile": "tsx scripts/credits/reconcile.ts",
    "credits:check": "tsx scripts/ops/job.ts credits:check scripts/credits/reconcile.ts --check --alert",
    "rounds:reminders": "tsx scripts/ops/job.ts rounds:reminders scripts/rounds/run-round-reminders.ts",
    "ai:digest": "tsx scripts/ops/job.ts ai:digest scripts/ai/run-daily-digest.ts",
    "keys:alerts": "tsx scripts/ops/job.ts keys:alerts scripts/integrations/run-key-alerts.ts",
    "secrets:reseal": "tsx scripts/secrets/reseal.ts",
    "secrets:sync": "tsx scripts/ops/job.ts secrets:sync scripts/secrets/run-sync.ts",
    "history:retention": "tsx scripts/ops/job.ts history:retention scripts/history/run-retention.ts",
    "companies:closure": "tsx scripts/ops/job.ts companies:closure scripts/history/run-company-closure.ts",
    "ops:alert": "tsx scripts/ops/send-alert.ts",
    "mailings:send": "tsx scripts/ops/job.ts mailings:send scripts/mail/run-mailings.ts",
    "notices:send": "tsx scripts/ops/job.ts notices:send scripts/notices/run-notice-delivery.ts",
    "machine:rules": "tsx scripts/ops/job.ts machine:rules scripts/machine/run-rules.ts",
    "machine:alarms": "tsx scripts/ops/job.ts machine:alarms scripts/machine/run-alarms.ts",
    "maintenance:plans": "tsx scripts/ops/job.ts maintenance:plans scripts/maintenance/run-plans.ts",
    "schedule:publish": "tsx scripts/ops/job.ts schedule:publish scripts/schedule/run-scheduled.ts",
    "register:sync": "tsx scripts/ops/job.ts register:sync scripts/catalogue/run-register-sync.ts",
    "admin:create": "tsx scripts/admin/create-admin.ts",
    "admin:recover": "tsx scripts/admin/recover.ts",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.8.3",
    "dotenv": "^18.0.6",
    "driver.js": "^1.9.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "^16.4.5",
    "next-auth": "4.24.15",
    "nodemailer": "^10.0.15",
    "openai": "^7.28.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "prisma": "^7.5.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.5",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2",
      "effect": "^3.22.1"
    },
    "prisma": {
      "mysql2": "^3.24.5"
    },
    "exceljs": {
      "uuid": "^11.1.1",
      "unzipper": "^0.12.3"
    },
    "source-map-js": "^1.2.2"
  },
  "license": "AGPL-3.0-only"
}

# Workflow Community Edition – copy to .env and change every value marked replace-with.
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql://workflow:workflow@localhost:5432/workflow?schema=public

POSTGRES_DB=workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow

# Your installation (lib/instance.ts).
# INSTANCE_ADMIN_EMAIL is the owner account: `npm run admin:create` sets it up, and it can always sign in. Until you choose
# "Vem får logga in" or switch on "Tillåt nya konton" under Installation → Drift och säkerhet, only the owner, invited members
# and PILOT_ACCESS_EMAILS (on an HTTPS server) may sign in. Empty = nobody can sign in.
INSTANCE_NAME=Workflow
INSTANCE_OPERATOR=Workflow
INSTANCE_OPERATOR_DOMAINS=
INSTANCE_OPERATOR_SLUGS=workflow
INSTANCE_ADMIN_EMAIL=
INSTANCE_SUPPORT_EMAIL=
# The source link in Om Workflow. Change it if you run a changed copy for others over a network.
# INSTANCE_SOURCE_URL=https://github.com/HINTEK-Workflow/workflow-community
# AI calls per company an hour (default 300; 0 turns the limit off).
# AI_COMPANY_CALLS_PER_HOUR=300
# Comma-separated addresses that may also sign in; honoured only when APP_URL uses HTTPS on a public host.
PILOT_ACCESS_EMAILS=

# E-mail (password reset, invitations). Delivery flags stay off until SMTP is configured.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM_NAME=Workflow
MAIL_FROM_ADDRESS=noreply@example.com
INVITATION_DELIVERY_ENABLED=false
ROUND_EMAIL_DELIVERY_ENABLED=false
ALERT_EMAIL_DELIVERY_ENABLED=false
ALERT_EMAIL=

STORAGE_ROOT=./storage
# The backups are always encrypted (INSTALLATION.md, section 6). age is the default; gpg (GnuPG: AES-256 and RSA 4096) is the
# second choice. install.sh/install.ps1 fill these in: the public age key, or the path of the public GnuPG key file.
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT_FILE=
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24
INVITATION_TTL_HOURS=72
SESSION_MAX_AGE_HOURS=8
# Reverse proxy trust for the caller's IP address (rate limits). Empty = one proxy in production, none in development.
# Set either the number of proxies in front of the app (TRUSTED_PROXY_HOPS) or their addresses/CIDR ranges (TRUSTED_PROXIES).
TRUSTED_PROXY_HOPS=
TRUSTED_PROXIES=
# Encrypts the keys companies store under Inställningar → Kopplingar; changing it means entering those keys again.
INTEGRATION_KEYS_SECRET=replace-with-32-plus-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only used by `npm run db:seed` in development.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-seed-password
SEED_ADMIN_NAME=Administratör
SEED_ADMIN_EMAIL_VERIFIED=true
SEED_ORGANIZATION_NAME=Workflow Internal
SEED_ORGANIZATION_SLUG=workflow-internal

# docker-compose.yml. The scripts in scripts/ops get the Compose project's name from cron (COMPOSE_PROJECT in
# INSTALLATION.md, section 5), not from this file. install.ps1 and install.sh name the image and the containers after the
# folder, so two installations on one computer never share them.
APP_IMAGE=workflow-community:local
APP_PORT=3000
POSTGRES_PORT=5432
CONTAINER_PREFIX=workflow
STORAGE_PATH=

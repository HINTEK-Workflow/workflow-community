# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the documented template tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local storage
storage/*
!storage/.gitkeep
!storage/attachments/.gitkeep

/storage-test/
/storage-qa/
/storage-local/
/storage-local-qa/
# build logs and screenshots from local verification runs
/tmp/
/.test-storage/
/backups/
/tests/artifacts/
/db-restore-drill.*/
/storage-restore-drill.*/

# locally installed development tools
/.tools/

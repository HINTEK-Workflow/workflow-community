enum IntegrationKeyKind {
  API
  MCP
  EXTERNAL
}

/// Every key a company uses with Workflow, in one place under the company administration (2026-09-29).
/// API and MCP keys are issued by Workflow: shown once, stored only as a SHA-256 hash of the secret part, and they act on
/// behalf of the admin who created them within their scopes. External keys (the company's own AI key, integrations) are
/// fetched from the provider, stored encrypted (AES-256-GCM) and never shown again, only their last four characters.
model IntegrationKey {
  id              String             @id @default(cuid())
  organizationId  String
  kind            IntegrationKeyKind
  name            String
  provider        String?
  scopes          String[]           @default([])
  displayHint     String
  secretHash      String?
  encryptedValue  String?
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokedById     String?
  createdById     String
  // The member the key acts for (API/MCP server, 2026-09-30); null = the admin who created it.
  actingUserId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, revokedAt])
}

enum PriceVersionStatus {
  DRAFT
  READY
  ACTIVE
  RETIRED
}

/// Versioned amounts (2026-09-29): amounts change only through a new version mirrored to new Stripe prices.
/// A version is editable only as DRAFT; READY has validated Stripe prices; exactly one version is ACTIVE.
model PriceVersion {
  id                      String             @id @default(cuid())
  version                 Int                @unique
  status                  PriceVersionStatus @default(DRAFT)
  cloudBaseAmountOre      Int
  cloudExtraUserAmountOre Int
  includedUsers           Int
  /// [{ key, name, credits, amountOre }]
  creditPackages          Json
  /// { cloud: { priceId, lookupKey }, cloudExtraUser: {...}, credits: { [key]: {...} } }
  stripePrices            Json               @default("{}")
  note                    String             @default("")
  termsVersion            String?
  creditTermsVersion      String?
  createdById             String
  activatedById           String?
  activatedAt             DateTime?
  retiredAt               DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  notices                 PriceChangeNotice[]

  @@index([status])
}

enum PriceChangeNoticeStatus {
  NOTIFIED
  MOVED
  CANCELED
}

/// In-app notice to a company that its Cloud subscription moves to a new price version; the move is allowed first
/// when effectiveNotBefore (notice + 30 days) has passed and takes effect from the next period.
model PriceChangeNotice {
  id                  String                  @id @default(cuid())
  organizationId      String
  subscriptionId      String
  priceVersionId      String
  fromPriceAmountOre  Int
  fromExtraUserAmountOre Int?
  status              PriceChangeNoticeStatus @default(NOTIFIED)
  noticedAt           DateTime                @default(now())
  effectiveNotBefore  DateTime
  movedAt             DateTime?
  amendmentOrderId    String?
  createdById         String
  movedById           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  priceVersion        PriceVersion            @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, priceVersionId])
  @@index([organizationId, status])
}


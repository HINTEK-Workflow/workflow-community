enum IntegrationKeyKind {
  API
  MCP
  EXTERNAL
}

/// Every key a company uses with Workflow, in one place under the company administration (2026-09-29).
/// API and MCP keys are issued by Workflow: shown once, stored only as a SHA-256 hash of the secret part, and they act on
/// behalf of the admin who created them within their scopes. External keys (the company's own AI key, integrations) are
/// fetched from the provider, stored encrypted (AES-256-GCM) and never shown again, only their last four characters.
model IntegrationKey {
  id             String             @id @default(cuid())
  organizationId String
  kind           IntegrationKeyKind
  name           String
  provider       String?
  scopes         String[]           @default([])
  displayHint    String
  secretHash     String?
  encryptedValue String?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedById    String?
  createdById    String
  // The member the key acts for (API/MCP server, 2026-09-30); null = the admin who created it.
  actingUserId   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, revokedAt])
}

/// Företagets datanyckel (2026-10-25, beslut 3a): a random 256-bit key per company that seals the company's external
/// keys (IntegrationKey.encryptedValue, format v3, bound to company and key). Stored only wrapped by the installation's key
/// ring (sealing purpose org-data-key, bound to the company); a rotation of the ring rewraps these rows and nothing else.
/// Deleted with the company, which leaves its sealed values unreadable in every backup made afterwards.
model OrganizationDataKey {
  id             String       @id @default(cuid())
  organizationId String
  wrappedKey     String
  createdAt      DateTime     @default(now())
  /// Set when a newer key took over; a retired key still opens what it sealed until that is resealed.
  retiredAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, retiredAt])
}

// OAuth 2.1 for the MCP server (2026-10-02): an external app (ChatGPT and other MCP clients) registers itself,
// a company admin approves it in Workflow, and the app gets short-lived tokens that act as that admin in that company.
model OAuthClient {
  id           String                   @id @default(cuid())
  name         String
  redirectUris String[]
  // "none" (public client with PKCE), "client_secret_post" or "client_secret_basic".
  authMethod   String
  secretHash   String?
  createdAt    DateTime                 @default(now())
  lastUsedAt   DateTime?
  codes        OAuthAuthorizationCode[]
  grants       OAuthGrant[]
}

model OAuthAuthorizationCode {
  id             String       @id @default(cuid())
  codeHash       String       @unique
  clientId       String
  organizationId String
  userId         String
  redirectUri    String
  codeChallenge  String
  scopes         String[]
  resource       String
  expiresAt      DateTime
  usedAt         DateTime?
  grantId        String?
  createdAt      DateTime     @default(now())
  client         OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// One approved connection: an app acting as a person in a company, until the person or an admin disconnects it.
model OAuthGrant {
  id             String       @id @default(cuid())
  clientId       String
  organizationId String
  userId         String
  scopes         String[]
  resource       String
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedById    String?
  client         OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens         OAuthToken[]

  @@index([organizationId, revokedAt])
}

model OAuthToken {
  id         String     @id @default(cuid())
  grantId    String
  // ACCESS (short-lived) or REFRESH (rotated on every use).
  kind       String
  secretHash String
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  grant      OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, kind])
  @@index([expiresAt])
}

enum PriceVersionStatus {
  DRAFT
  READY
  ACTIVE
  RETIRED
}

/// Versioned amounts (2026-09-29): amounts change only through a new version mirrored to new Stripe prices.
/// A version is editable only as DRAFT; READY has validated Stripe prices; exactly one version is ACTIVE.
model PriceVersion {
  id                      String              @id @default(cuid())
  version                 Int                 @unique
  status                  PriceVersionStatus  @default(DRAFT)
  cloudBaseAmountOre      Int
  cloudExtraUserAmountOre Int
  includedUsers           Int
  /// [{ key, name, credits, amountOre }]
  creditPackages          Json
  /// Prissteg (2026-11-20): [{ key, name, minUsers, maxUsers, amountOre }]; empty = base price + price per extra user.
  cloudTiers              Json                @default("[]")
  /// { cloud: { priceId, lookupKey }, cloudExtraUser: {...}, credits: { [key]: {...} }, tiers: { [key]: {...} } }
  stripePrices            Json                @default("{}")
  note                    String              @default("")
  termsVersion            String?
  creditTermsVersion      String?
  createdById             String
  activatedById           String?
  activatedAt             DateTime?
  retiredAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  notices                 PriceChangeNotice[]

  @@index([status])
}

enum PriceChangeNoticeStatus {
  NOTIFIED
  MOVED
  CANCELED
}

/// In-app notice to a company that its Cloud subscription moves to a new price version; the move is allowed first
/// when effectiveNotBefore (notice + 30 days) has passed and takes effect from the next period.
model PriceChangeNotice {
  id                     String                  @id @default(cuid())
  organizationId         String
  subscriptionId         String
  priceVersionId         String
  fromPriceAmountOre     Int
  fromExtraUserAmountOre Int?
  status                 PriceChangeNoticeStatus @default(NOTIFIED)
  noticedAt              DateTime                @default(now())
  effectiveNotBefore     DateTime
  movedAt                DateTime?
  amendmentOrderId       String?
  createdById            String
  movedById              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  priceVersion           PriceVersion            @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, priceVersionId])
  @@index([organizationId, status])
}


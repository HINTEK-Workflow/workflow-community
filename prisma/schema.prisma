  unitAmountOre     Int
  subtotalOre       Int
  taxAmountOre      Int
  totalAmountOre    Int
  discountAmountOre Int                  @default(0)
  credits           Int?
  periodStart       DateTime?
  periodEnd         DateTime?
  providerPriceId   String?
  createdAt         DateTime             @default(now())
  order             BillingOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, kind])
}

model BillingInvoice {
  id                      String                  @id @default(cuid())
  organizationId          String
  subscriptionId          String?
  orderId                 String?                 @unique
  providerInvoiceId       String?                 @unique
  providerPaidEventId     String?                 @unique
  paidOutOfBandRequestKey String?                 @unique
  providerNumber          String?
  paymentReference        String?
  paymentMode             BillingPaymentMode?
  invoiceDueDays          Int?
  status                  BillingInvoiceStatus    @default(DRAFT)
  subtotalOre             Int
  taxAmountOre            Int
  totalAmountOre          Int
  amountPaidOre           Int                     @default(0)
  currency                String                  @default("SEK")
  periodStart             DateTime?
  periodEnd               DateTime?
  dueAt                   DateTime?
  finalizedAt             DateTime?
  paidAt                  DateTime?
  voidedAt                DateTime?
  replacesInvoiceId       String?                 @unique
  replacementRequestKey   String?                 @unique
  replacementReason       String?
  replacementActorId      String?
  firstPaymentFailedAt    DateTime?
  lastPaymentAttemptAt    DateTime?
  paymentAttemptCount     Int                     @default(0)
  nextPaymentAttemptAt    DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription            CloudSubscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  order                   BillingOrder?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentAllocations      BankPaymentAllocation[]
  entitlements            CloudEntitlement[]
  adjustments             BillingAdjustment[]
  notices                 BillingNotice[]
  replacesInvoice         BillingInvoice?         @relation("InvoiceReplacement", fields: [replacesInvoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  replacedByInvoice       BillingInvoice?         @relation("InvoiceReplacement")

  @@unique([id, organizationId])
  @@unique([replacesInvoiceId, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([subscriptionId])
}

model BillingNotice {
  id                 String                   @id @default(cuid())
  organizationId     String
  invoiceId          String
  stage              BillingNoticeStage
  title              String
  message            String
  effectiveAt        DateTime
  emailStatus        BillingNoticeEmailStatus @default(NOT_REQUESTED)
  emailSentAt        DateTime?
  emailLastAttemptAt DateTime?
  emailAttemptCount  Int                      @default(0)
  emailFailure       String?
  resolvedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice            BillingInvoice           @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([invoiceId, stage])
  @@index([organizationId, resolvedAt, effectiveAt])
  @@index([emailStatus, createdAt])
}

model BankPayment {
  id              String                  @id @default(cuid())
  organizationId  String
  requestKey      String                  @unique
  amountOre       Int
  currency        String                  @default("SEK")
  paidAt          DateTime
  reference       String
  internalComment String
  verifiedBy      String
  status          BankPaymentStatus       @default(UNALLOCATED)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  allocations     BankPaymentAllocation[]

  @@index([organizationId, status, paidAt])
  @@index([reference])
}

model BankPaymentAllocation {
  id            String         @id @default(cuid())
  bankPaymentId String
  invoiceId     String
  amountOre     Int
  createdAt     DateTime       @default(now())
  bankPayment   BankPayment    @relation(fields: [bankPaymentId], references: [id], onDelete: Restrict)
  invoice       BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([bankPaymentId, invoiceId])
  @@index([invoiceId])
}

model CloudEntitlement {
  id                   String                 @id @default(cuid())
  organizationId       String
  invoiceId            String?
  sourcePaymentEventId String?
  sourceKey            String                 @unique
  source               CloudEntitlementSource
  status               CloudEntitlementStatus @default(ACTIVE)
  periodStart          DateTime
  periodEnd            DateTime
  grantedAt            DateTime               @default(now())
  revokedAt            DateTime?
  revokeReason         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice              BillingInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sourcePaymentEvent   PaymentEvent?          @relation(fields: [sourcePaymentEventId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, periodEnd])
  @@index([invoiceId])
}

model BillingAuditEvent {

model OrganizationMember {
  canDeleteControls          Boolean                     @default(false)
  workflowPermissions        Json?
  weeklyWorkMinutes          Int?
  /// Ingen fast arbetstid (2026-10-30, hourly staff): no expected time, no capacity, never "saknar tidrapport".
  noFixedHours               Boolean                     @default(false)
  isActive                   Boolean                     @default(true)
  id                         String                      @id @default(cuid())
  organizationId             String
  userId                     String
  role                       OrganizationMemberRole      @default(MEMBER)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workScheduleEvents         WorkScheduleEvent[]         @relation("WorkScheduleMember")
  plannedActivityAssignments PlannedActivityAssignment[]
  selfInspectionRoles        SelfInspectionRoleMember[]
  selfInspectionCompetence   SelfInspectionCompetence[]
  planningDelegateProjects   Project[]                   @relation("ProjectPlanningDelegate")
  /// Integrationsmotorn E6: objekt där personen är ansvarig eller ersättare för maskinlarm.
  machineAlarmContacts       MachineAlarmContact[]
  /// Anställningsnummer (frånvaro och lön, 2026-10-29): the person's number in the company's payroll or HR system, used to
  /// match imported absence and in exports. Unique within the company; null = not set.
  employeeNumber             String?
  absences                   Absence[]
  timePeriods                TimePeriod[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@unique([organizationId, employeeNumber])
  @@index([userId])
}

/// Frånvaro (2026-10-29; lib/workflow/absence.ts): whole days or some hours of one day. Only the type is stored, never a
/// diagnosis; the type is shown only to the person and the Teamet right. An imported absence keeps its source and external key,
/// so the same file imported again changes nothing, and it is locked in Workflow unless the company's setting allows changes.
model Absence {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  /// SICK | VAB | VACATION | LEAVE | COMP | FLEX | TRAINING | PARENTAL | OTHER (CHECK in the migration).
  type           String
  /// Only for OTHER: the own reason, at most 120 characters.
  note           String             @default("")
  /// Swedish days YYYY-MM-DD; toDate included.
  fromDate       String
  toDate         String
  /// HH:MM for some hours of one day; both null = the whole day.
  startTime      String?
  endTime        String?
  /// APPLIED | APPROVED | REJECTED | WITHDRAWN; only APPROVED counts in planning.
  status         String             @default("APPROVED")
  /// MANUAL | FILE | SFTP | API.
  source         String             @default("MANUAL")
  /// The master system's label (e.g. "Flex HRM") and the record's key there (its id, or a key made from the row).
  externalSystem String?
  externalKey    String?
  /// The code the master system used, as read.
  externalCode   String?
  /// Hash of the external values at the latest import: equal = unchanged.
  externalHash   String?
  importRunId    String?
  /// Affected work a person chose to leave as it is (Låt vänta).
  handled        String[]           @default([])
  createdById    String
  updatedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([organizationId, externalSystem, externalKey])
  @@index([organizationId, userId, fromDate])
  @@index([organizationId, toDate])
}

/// Tidsperiod (2026-10-30): a person's month of time sent in and approved before it goes to payroll. The person sends in
/// (SUBMITTED), a supervisor approves (APPROVED) or returns it with a note (RETURNED). A submitted or approved month is locked:
/// no time entry in it is created, changed or removed until it is returned or reopened. No row = open.
model TimePeriod {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  /// The month, YYYY-MM (Swedish time).
  period         String
  /// SUBMITTED | APPROVED | RETURNED (CHECK in the migration).
  status         String
  note           String             @default("")
  submittedAt    DateTime?
  submittedById  String?
  decidedAt      DateTime?
  decidedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([organizationId, userId, period])
  @@index([organizationId, period, status])
}

/// Frånvarons historik: who created, changed, imported or removed an absence, and when. Never the reason.
model AbsenceEvent {
  id             String       @id @default(cuid())
  organizationId String
  /// No foreign key: the history stays when the absence is removed.
  absenceId      String
  userId         String
  actorId        String?
  /// created | updated | deleted | imported | import_changed | replaced | handled
  action         String
  detail         String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, absenceId, createdAt])
  @@index([organizationId, createdAt])
}

/// Lön och frånvaro (2026-10-29; lib/payroll/settings.ts): one row per company – the external system, the mode (manual file,
/// SFTP or API), code mappings, saved import and export templates and the SFTP settings. Secrets (SFTP password or key, API
/// key) are never here: they are company keys (IntegrationKey, sealed per company) referenced by provider.
model PayrollIntegration {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  /// none | flex_hrm | fortnox | spiris | visma | other
  system           String       @default("none")
  /// The name shown for system "other".
  systemName       String       @default("")
  /// manual | sftp | api
  mode             String       @default("manual")
  /// Whether imported absence may be changed in Workflow (false = locked; changed in the master system).
  importedEditable Boolean      @default(false)
  /// External absence code (normalised) → Workflow type, or "IGNORE".
  codeMap          Json         @default("{}")
  /// Workflow type → external time code, for exports.
  exportCodes      Json         @default("{}")
  /// Saved column mappings for absence files, per heading fingerprint.
  importTemplates  Json         @default("[]")
  /// Saved export templates (lib/payroll/export.ts).
  exportTemplates  Json         @default("[]")
  /// SFTP: host, port, username, importDir, exportDir, hostKey, schedule (no secret).
  sftp             Json         @default("{}")
  lastImportAt     DateTime?
  lastExportAt     DateTime?
  lastError        String       @default("")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Import and export history for payroll and absence files: what was read or written, counts and a row error report (never
/// reasons). The content hash stops the same file from being imported twice by a scheduled transfer.
model IntegrationRun {
  id             String       @id @default(cuid())
  organizationId String
  /// import | export
  direction      String
  /// manual | sftp | api
  mode           String
  system         String       @default("")
  /// absence | employee_numbers | worked_time
  kind           String
  fileName       String       @default("")
  contentHash    String       @default("")
  /// ok | partial | failed
  status         String
  counts         Json         @default("{}")
  errors         Json         @default("[]")
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, direction, contentHash])
}

model WorkScheduleEvent {
  id              String              @id @default(cuid())
  organizationId  String
  memberId        String?
  scope           String
  previousMinutes Int?
  nextMinutes     Int?
  actorName       String              @default("")
  createdAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member          OrganizationMember? @relation("WorkScheduleMember", fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, memberId, createdAt])
}

model LocalWorkspaceBinding {
  id                               String       @id @default(cuid())
  organizationId                   String
  userId                           String
  localIdentityId                  String
  memberWeeklyWorkMinutesAtBinding Int?
  scheduleBaselineCapturedAt       DateTime?
  lastLocalScheduleUpdatedAt       DateTime?
  lastScheduleSyncedAt             DateTime?
  createdAt                        DateTime     @default(now())
  revokedAt                        DateTime?
  revokedByUserId                  String?
  organization                     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, localIdentityId])
  @@index([organizationId, userId, revokedAt])
}

model OrganizationInvitation {
  id                  String                       @id @default(cuid())
  organizationId      String
  email               String
  name                String
  role                OrganizationMemberRole       @default(MEMBER)
  canDeleteControls   Boolean                      @default(false)
  workflowPermissions Json?
  status              OrganizationInvitationStatus @default(PREPARED)
  activeKey           String?                      @unique
  tokenHash           String?                      @unique
  expiresAt           DateTime?
  sentAt              DateTime?
  acceptedAt          DateTime?
  revokedAt           DateTime?
  invitedBy           String
  acceptedUserId      String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@index([expiresAt])
}

model LegalDocument {

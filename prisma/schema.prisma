model Customer {
  id                         String                              @id @default(cuid())
  organizationId             String
  name                       String
  company                    String                              @default("")
  address                    String                              @default("")
  postalCode                 String                              @default("")
  city                       String                              @default("")
  email                      String                              @default("")
  phone                      String                              @default("")
  mobile                     String                              @default("")
  lat                        Float?
  lng                        Float?
  notes                      String                              @default("")
  /// Särskilda krav (2026-10-07): what the customer requires beyond the ordinary way of working, written on the
  /// customer card by anyone who may edit customers and shown in the customer's projects and tasks. Replaces the
  /// requirements that were kept per programme (SelfInspectionCustomerRequirement), which the migration copied here.
  specialRequirements        String                              @default("")
  /// Kundtyp (2026-10-10): a company or a private person, the same values as the quote's. A new quote for the
  /// customer starts with it and may be changed there as an exception; the quote never writes it back.
  customerType               QuoteCustomerType                   @default(COMPANY)
  /// Kundnummer i bokföringen (driftklar-plan 2026-10-11, migration 20261012150100_customer_accounting_number): the
  /// customer's number in the company's accounting system (Fortnox), kept on the customer so the export never asks
  /// for it again. Company data; "" when unknown.
  accountingCustomerNumber   String                              @default("")
  /// Eget företag (2026-10-24: "Bygg likadant – kundföretag har ju också egna objekt"): the company's own places
  /// (workshop, store, vehicles) live under one customer record of its own, so they are the same tree, page and rules as a
  /// customer's. At most one per company (a partial unique index in the migration); never in the customer register, its
  /// places reached under Företaget and chosen in a work order as "Eget företag".
  ownCompany                 Boolean                             @default(false)
  version                    Int                                 @default(1)
  deletedAt                  DateTime?
  createdAt                  DateTime                            @default(now())
  updatedAt                  DateTime                            @updatedAt
  organization               Organization                        @relation(fields: [organizationId], references: [id])
  controls                   Control[]
  workflowTasks              WorkflowTask[]
  projects                   Project[]
  facilities                 CustomerFacility[]
  /// Underhåll (2026-10-30): maskinträd som kunden äger (bara som ägare; kunden ser dem inte).
  machineParts               MachinePart[]
  formSchedules              FormSchedule[]
  selfInspectionPrograms     SelfInspectionProgram[]
  selfInspectionRequirements SelfInspectionCustomerRequirement[]
  quotes                     Quote[]
  invoiceBases               InvoiceBasis[]
  customerInvoices           CustomerInvoice[]
  purchases                  Purchase[]

  // Tenant relations (2026-10-08): places point at their customer through [id, organizationId].
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt, name])
}

// A customer's facility (2026-09-26, decision 11/D9 B): a property, switchgear or other object under the
// customer that projects, work orders, risk assessments and controls can be linked to. Paused rather than deleted so that linked work keeps its reference; purging the
// customer removes its facilities and clears the links. Same-tenant links are enforced by a database trigger.
/// Platser (2026-10-04): a tree under the customer with optional levels. The older facilities are the top level
/// (kind FACILITY); a place below one has its parent here and the same customer. The address belongs on the top level
/// and is inherited downwards; country and town are part of the address, never levels of their own.
model CustomerFacility {
  id                   String                @id @default(cuid())
  organizationId       String
  customerId           String
  parentId             String?
  /// FACILITY (anläggning), BUILDING (byggnad/avdelning), SPACE (utrymme), OBJECT (objekt) or OTHER (annat).
  kind                 String                @default("FACILITY")
  /// Optional position in WGS 84 (decimal degrees), from the phone or pasted.
  latitude             Float?
  longitude            Float?
  name                 String
  address              String                @default("")
  postalCode           String                @default("")
  city                 String                @default("")
  description          String                @default("")
  isActive             Boolean               @default(true)
  /// Object data (Underhåll stage 2, 2026-10-06), all optional free text entered by the user. Marking (code) and
  /// criticality moved to the work order 2026-10-24.
  objectType           String                @default("")
  /// "", IN_SERVICE, OUT_OF_SERVICE or DECOMMISSIONED; separate from isActive (paused in Workflow).
  operatingState       String                @default("")
  manufacturer         String                @default("")
  model                String                @default("")
  serialNumber         String                @default("")
  /// YYYY-MM-DD or "".
  installedOn          String                @default("")
  /// Free technical values: [{ label, value }], at most 30.
  attributes           Json                  @default("[]")
  version              Int                   @default(1)
  createdBy            String
  updatedBy            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite tenant relations (2026-10-08): the customer and the parent place are always in the same company. The
  // triggers from 20260927130000/20261004090000 stay for the finer rules (same customer, no cycles).
  customer             Customer              @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  parent               CustomerFacility?     @relation("PlaceTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  children             CustomerFacility[]    @relation("PlaceTree")
  projects             Project[]
  workflowTasks        WorkflowTask[]
  controls             Control[]
  limitProfiles        FormLimitProfile[]
  formSchedules        FormSchedule[]
  quotes               Quote[]
  invoiceBases         InvoiceBasis[]
  /// Integrationsmotorn E1 (2026-10-24): källor med platsen som standardobjekt, händelser och larmrader på objektet.
  machineSources       MachineSource[]
  machineEvents        MachineEvent[]
  machineAlarmOrders   MachineAlarmOrder[]
  machineSignals       MachineSignal[]
  /// Integrationsmotorn E6: ansvarig och ersättare för objektets maskinlarm, och objektets dygnssammanfattningar.
  machineAlarmContacts MachineAlarmContact[]
  machineDaySummaries  MachineDaySummary[]

  @@unique([id, organizationId])
  @@index([organizationId, customerId, isActive])
  @@index([organizationId, objectType])
  @@index([parentId])
}

model Project {
  id                        String                     @id @default(cuid())
  organizationId            String
  customerId                String?
  name                      String
  description               String                     @default("")
  // The project's frame (2026-09-26): start and end, Swedish calendar days; both are required for new projects.
  startDate                 String                     @default("")
  dueDate                   String                     @default("")
  // Fixed project fields shown read-only in every task and printed in reports; description is the work description.
  client                    String                     @default("")
  contactPerson             String                     @default("")
  reference                 String                     @default("")
  workSite                  String                     @default("")
  // Personalliggare, steg 0 (2026-10-08): { required, siteId, builder, system } – no identity numbers, no check-ins.
  staffRegister             Json                       @default("{}")
  taskTypes                 Json                       @default("[]")
  workMoments               Json                       @default("[]")
  responsibleUserId         String?
  responsibleName           String                     @default("")
  // Ställföreträdare för bokningar (2026-10-09): the project's responsible person or an admin can hand the right
  // to change other people's bookings on the project to one named member (e.g. when sick) and take it back. A member of
  // the same organization only (composite key); removing the member clears just this column.
  planningDelegateUserId    String?
  planningDelegate          OrganizationMember?        @relation("ProjectPlanningDelegate", fields: [organizationId, planningDelegateUserId], references: [organizationId, userId], onDelete: SetNull)
  timeBudgetMinutes         Int                        @default(0)
  archivedAt                DateTime?
  // Manual "Avsluta projekt" (2026-09-26); only allowed when every task is completed and no planning is active.
  closedAt                  DateTime?
  closedBy                  String?
  createdBy                 String
  updatedBy                 String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Same-tenant customer is enforced by the database trigger from migration 20260925180000_tenant_hardening;
  // a single-column FK is kept so purging a customer still only clears customerId.
  customer                  Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facilityId                String?
  facility                  CustomerFacility?          @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  controls                  Control[]
  workflowTasks             WorkflowTask[]
  events                    ProjectEvent[]
  decisions                 ProjectDecision[]
  plannedActivities         PlannedActivity[]
  selfInspectionAssignments SelfInspectionAssignment[]
  staffRegisterEvents       StaffRegisterEvent[]
  quotes                    Quote[]
  invoiceBases              InvoiceBasis[]
  purchases                 Purchase[]
  /// Projekttid (2026-10-26): time reported on the project itself, without a work order.
  timeEntries               WorkflowTimeEntry[]
  comments                  Comment[]

  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, customerId])
  @@index([organizationId, facilityId])
}

model ProjectEvent {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  kind           String
  summary        String
  taskId         String?
  actorName      String   @default("")
  createdBy      String?
  createdAt      DateTime @default(now())
  // Composite key: a history row can only belong to a project in the same organization.
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}

// The project's decision log (2026-09-26): date, text and who decided. Append-only; never edited or deleted.
model ProjectDecision {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  decidedOn      String
  text           String
  decidedBy      String
  createdBy      String
  actorName      String   @default("")
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, projectId, decidedOn])
}

model WorkflowTask {
  id                        String                     @id @default(cuid())
  organizationId            String
  projectId                 String?
  customerId                String?
  kind                      String
  title                     String
  description               String                     @default("")
  status                    String                     @default("PLANNED")
  progress                  Int                        @default(0)
  assignedToUserId          String?
  assignedToName            String                     @default("")
  dueDate                   String                     @default("")
  /// Tidplan (Gantt v1, 2026-10-09): the job's planned start (YYYY-MM-DD, "" = utan datum); the period runs to
  /// dueDate ("Klart senast" = the period's end). estimatedMinutes is the estimated work time ("Uppskattad tid").
  /// Set from the project's Tidplan (app/api/project-schedule; migration 20261011993000_task_schedule).
  plannedStartDate          String                     @default("")
  estimatedMinutes          Int?
  /// Börjar efter (projektförslaget steg 4, 2026-10-09): finish-to-start predecessors – ids of jobs in the same
  /// project and company, written only by app/api/project-schedule after its checks (no circle, at most 20); an id of a
  /// job that is gone is ignored when read (migration 20261012108100_task_predecessors).
  predecessorIds            String[]                   @default([])
  /// Etapp (2026-10-11, projektförslaget 2026-10-09 steg 5, migration 20261012150200_task_stage): an optional text label
  /// that groups a project's jobs in the list and the Tidplan. No table of its own; "" = no stage.
  stage                     String                     @default("")
  data                      Json
  version                   Int                        @default(1)
  startedAt                 DateTime?
  completedAt               DateTime?
  /// Utgår (2026-10-09): status CANCELLED with when, by whom, the required reason and the status it had before,
  /// so Återuppta can give it back (lib/workflow/task-cancel.ts; migration 20261011992000_task_cancelled).
  cancelledAt               DateTime?
  cancelledBy               String?
  cancelReason              String                     @default("")
  cancelledFromStatus       String?
  createdBy                 String
  updatedBy                 String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                   Project?                   @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer                  Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facilityId                String?
  facility                  CustomerFacility?          @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  revisions                 WorkflowTaskRevision[]
  timeEntries               WorkflowTimeEntry[]        @relation("TimeEntryOwner")
  /// Rapporterad från (2026-10-27): time on the work order that was reported from this task.
  sourcedTimeEntries        WorkflowTimeEntry[]        @relation("TimeEntrySource")
  attachments               WorkflowTaskAttachment[]
  plannedActivities         PlannedActivity[]
  selfInspectionAssignments SelfInspectionAssignment[]
  // A protocol from a published form (kind FORM): the exact template version it was created from.
  formTemplateId            String?
  // The permission area of the protocol's form (forms, kfid or risk-assessment); NULL is forms.
  formArea                  String?
  formTemplateVersion       Int?
  formVersion               FormTemplateVersion?       @relation(fields: [formTemplateId, formTemplateVersion], references: [templateId, version], onDelete: SetNull)
  /// Sök (2026-10-05): folded text kept by a database trigger (migration 20261005160000_search_indexes).
  searchText                String?                    @ignore
  /// Arbetsordern styr (2026-10-26; was "Hör till arbetsorder", Fas 2 2026-10-08): every protocol, control or risk
  /// assessment belongs to one work order in the same company and inherits its customer and project; its time is recorded
  /// on the work order. A trigger requires the target to be a WORK_ORDER and keeps work orders themselves unlinked
  /// (migration 20261009900000_task_work_order_link). Since 2026-10-27 a task may be a draft without one (Planerad or Utgår,
  /// never started or completed); a CHECK requires the link on every other task (migrations 20261026120000_work_order_required
  /// and 20261027120000_task_draft_round_holder). Deleting a work order removes its tasks first after a confirmation and
  /// is refused while any of them is completed or signed (the route); NoAction lets a whole company be removed in one statement.
  workOrderId               String?
  workOrder                 WorkflowTask?              @relation("TaskWorkOrder", fields: [workOrderId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: Cascade)
  linkedTasks               WorkflowTask[]             @relation("TaskWorkOrder")
  /// Offert → arbetsorder (steg C, 2026-10-09): accepted quotes this work order was made from.
  quotes                    Quote[]                    @relation("QuoteWorkOrder")
  /// Fakturaunderlag (2026-10-10): the bases made from this job.
  invoiceBases              InvoiceBasis[]
  /// Inköp (2026-10-16): purchases made for this work order.
  purchases                 Purchase[]                 @relation("PurchaseWorkOrder")
  /// Avvikelse ↔ arbetsorder (2026-10-10): the deviation-log entries this work order fixes.
  selfInspectionDeviations  SelfInspectionDeviation[]  @relation("DeviationWorkOrder")
  comments                  Comment[]
  /// Driftrond i arbetsordern (2026-10-27, punkt 3): a work order that holds a round for its period
  /// (plannedStartDate – dueDate, roundOccurrence empty); every occurrence in the period is registered in it. The periods of
  /// a round's work orders never overlap (trigger, migration 20261027120000_task_draft_round_holder). 0.24.0 made one work
  /// order per occurrence (roundOccurrence = the day, "YYYY-MM-DD"); those are kept, and the unique key still holds for them.
  roundScheduleId           String?
  roundOccurrence           String?
  roundSchedule             FormSchedule?              @relation("RoundWorkOrder", fields: [roundScheduleId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: Cascade)
  /// Underhåll (2026-10-30): maskindelen arbetsordern gäller (larm, felanmälan, senare återkommande arbeten). Enkel FK
  /// med SET NULL och triggern WorkflowTask_machine_part_tenant (samma företag).
  machinePartId             String?
  machinePart               MachinePart?               @relation(fields: [machinePartId], references: [id], onDelete: SetNull)
  /// Underhållsposterna arbetsordern håller och uttagen ur förrådet som gjorts till den.
  maintenanceItems          MaintenanceItem[]
  storeTransactions         StoreTransaction[]
  /// Återkommande underhåll (2026-10-30, lib/maintenance/plan-model.ts): one work order per occurrence of a plan.
  /// maintenanceDue is the occurrence's day (YYYY-MM-DD). The order is vilande (dormant) while it is Planerad, not activated
  /// and its day is ahead – no time and no start until then. maintenancePinned: the day was moved by a person (kept as it is
  /// when the plan fills its days again). Migration 20261031100000_maintenance_plans.
  maintenancePlanId         String?
  maintenanceDue            String?
  maintenancePinned         Boolean                    @default(false)
  maintenanceActivatedAt    DateTime?
  maintenancePlan           MaintenancePlan?           @relation(fields: [maintenancePlanId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, roundScheduleId, roundOccurrence])
  @@index([organizationId, workOrderId])
  @@index([organizationId, formTemplateId])
  @@index([organizationId, kind, status, updatedAt])
  @@index([organizationId, projectId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, facilityId])
  @@index([organizationId, assignedToUserId])
  @@index([machinePartId])
  @@index([organizationId, maintenancePlanId, maintenanceDue])
}

model WorkflowTaskRevision {
  id        String       @id @default(cuid())
  taskId    String
  version   Int
  snapshot  Json
  createdBy String
  createdAt DateTime     @default(now())
  task      WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([taskId, createdAt])
}

// A time entry belongs to exactly one work order/risk assessment (taskId) or one commissioning control (controlId,
// 2026-09-26 decision 13: manual registration only, controls have no start/pause). A CHECK constraint in the
// migration enforces exactly one of the two.
/// A time entry has exactly one owner (CHECK WorkflowTimeEntry_one_owner_check): a work order (`taskId`; a trigger requires
/// a WORK_ORDER since migration 20261026120000_work_order_required), a project (`projectId`: project time without a work
/// order such as project management and meetings, 2026-10-26 svar 5a), or – frozen, no route writes it – a control.
model WorkflowTimeEntry {
  id           String        @id @default(cuid())
  taskId       String?
  controlId    String?
  projectId    String?
  /// Rapporterad från (2026-10-27): the task the time was started or written in when it lands on its work order – a
  /// round occurrence keeps its own time this way. NULL for time reported on the work order or project itself. A trigger
  /// requires the task to be in the entry's work order (migration 20261027120000_task_draft_round_holder).
  sourceTaskId String?
  /// Tidstyp (2026-10-29, lib/workflow/time-types.ts): NULL = the company's standard type (every entry from before,
  /// timers, API calls without a type). The route checks that the type belongs to the entry's own company.
  timeTypeId   String?
  userId       String
  startedAt    DateTime
  endedAt      DateTime?
  durationSec  Int           @default(0)
  note         String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  task         WorkflowTask? @relation("TimeEntryOwner", fields: [taskId], references: [id], onDelete: Cascade)
  control      Control?      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  // Cascade so a whole company can be removed; the project route refuses to delete a project that has time of its own.
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTask   WorkflowTask? @relation("TimeEntrySource", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  timeType     TimeType?     @relation(fields: [timeTypeId], references: [id], onDelete: SetNull)

  @@index([taskId, startedAt])
  @@index([sourceTaskId])
  @@index([controlId, startedAt])
  @@index([projectId, startedAt])
  @@index([userId, startedAt])
}

/// Tidstyper (2026-10-29, lib/workflow/time-types.ts): the company's own list of kinds of time – name, an optional payroll
/// code for exports, active, order. Exactly one standard type per company (partial unique index in the migration); it cannot be
/// deactivated or removed. A type with time reported on it is deactivated, never removed.
model TimeType {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  payrollCode    String              @default("")
  active         Boolean             @default(true)
  isDefault      Boolean             @default(false)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timeEntries    WorkflowTimeEntry[]

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
}

// Append-only audit of manual time registration and corrections. Deliberately not a foreign key
// to WorkflowTimeEntry so the history survives deletion of the entry or its task.
model WorkflowTimeEntryEvent {
  id             String       @id @default(cuid())
  organizationId String
  entryId        String
  userId         String
  action         String
  previous       Json?
  next           Json?
  reason         String       @default("")
  actorUserId    String
  actorName      String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entryId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model PlannedActivity {
  id               String                      @id @default(cuid())
  organizationId   String
  projectId        String?
  workflowTaskId   String?
  controlId        String?
  title            String
  description      String                      @default("")
  kind             String                      @default("TASK")
  status           String                      @default("PLANNED")
  startsAt         DateTime
  endsAt           DateTime
  assignedToUserId String?
  assignedToName   String                      @default("")
  version          Int                         @default(1)
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?                    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workflowTask     WorkflowTask?               @relation(fields: [workflowTaskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  control          Control?                    @relation(fields: [controlId, organizationId], references: [id, organizationId], onDelete: Restrict)
  events           PlannedActivityEvent[]
  assignments      PlannedActivityAssignment[]

  @@unique([id, organizationId])
  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, projectId, startsAt])
  @@index([organizationId, workflowTaskId, startsAt])
  @@index([organizationId, controlId, startsAt])

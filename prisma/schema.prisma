/// What HINTEK AI proposed and what the person did with it. The payload is the validated input of the ordinary tool
/// that carries it out; the result holds what was created, so it can be undone (plan 2026-10-01, fas 2). A proposal
/// made on a page has no conversation.
model AiProposal {
  id                  String           @id @default(cuid())
  conversationId      String?
  organizationId      String
  /// The person the proposal was made for; only they may use, dismiss or undo it.
  createdById         String?
  runId               String?
  result              Json             @default("{}")
  proposedByMessageId String?
  moduleId            String
  resourceType        String
  resourceId          String
  kind                String
  status              AiProposalStatus @default(PENDING)
  payload             Json
  baseVersion         Int?
  reviewedById        String?
  reviewedAt          DateTime?
  appliedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  conversation        AiConversation?  @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  proposedByMessage   AiMessage?       @relation(fields: [proposedByMessageId], references: [id], onDelete: Restrict)
  reviewedBy          User?            @relation("AiProposalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([conversationId, createdAt])
  @@index([resourceType, resourceId, status])
  @@index([organizationId, createdById, createdAt])
}


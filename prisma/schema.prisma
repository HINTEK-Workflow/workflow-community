model BillingAdjustment {
  id                   String                  @id @default(cuid())
  organizationId       String
  invoiceId            String?
  purchaseId           String?
  sourcePaymentEventId String?
  providerAdjustmentId String                  @unique
  kind                 BillingAdjustmentKind
  status               BillingAdjustmentStatus
  amountOre            Int
  currency             String                  @default("SEK")
  reason               String?
  appliedCredits       Int                     @default(0)
  effectiveAt          DateTime?
  appliedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice              BillingInvoice?         @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchase             CreditPurchase?         @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Restrict)

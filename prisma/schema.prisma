model PaymentEvent {
  id                  String              @id @default(cuid())
  organizationId      String?
  providerEventId     String              @unique
  eventType           String
  payloadHash         String?
  status              PaymentEventStatus  @default(RECEIVED)
  processedAt         DateTime?
  /// One delivery at a time (security review 2026-10-04): set when a delivery starts processing the event; a claim
  /// older than ten minutes (a crashed process) may be taken over.
  processingStartedAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  cloudEntitlements   CloudEntitlement[]
  billingAdjustments  BillingAdjustment[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model GeneratedResult {
  id             String   @id @default(cuid())
  organizationId String
  controlId      String
  requestKey     String   @unique
  kind           String
  status         String   @default("PENDING")
  content        String?
  storagePath    String?
  mimeType       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  control        Control  @relation(fields: [controlId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, controlId])
}

model WorkspaceSettings {
  id                 String  @id @default(cuid())
  organizationId     String  @unique
  companyName        String  @default("")
  contactEmail       String  @default("")
  logoPath           String?
  /// Loggans varianter (2026-11-13): the logo for a dark background (white), for a light background (colour) and in black,
  /// stored like the logo (PNG, so a white logo keeps its transparency); posts choose the one that reads on the template.
  logoOnDarkPath     String?
  logoOnLightPath    String?
  logoBlackPath      String?
  themePrimary       String?
  reportPrimary      String  @default("#174C72")
  reportAccent       String  @default("#2E7EAA")
  reportSoft         String  @default("#EDF5F9")
  suggestions        Json    @default("{}")
  profile            Json    @default("{}")
  aiPolicy           Json    @default("{}")
  /// Underhåll (2026-10-06, decision B1): maintenance fields and the object register; off by default.
  maintenance        Boolean @default(false)
  /// Tvåstegsverifiering krävs (2026-10-10): members signing in with a password must use TOTP; off by default.
  requireTwoFactor   Boolean @default(false)
  /// Microsoft-inloggning låst till företagets katalog (2026-10-11): an Entra tenant id (tid). Members may then sign in
  /// with Microsoft only through accounts from that tenant. Null = no lock.
  microsoftTenantId  String?
  /// Priser och offerter (2026-10-09): markup on material, default hourly rate, a quote's validity and the
  /// company's own quote terms (lib/quotes/settings.ts). Shown only to those who may see prices.
  priceSettings      Json    @default("{}")
  /// Bokföring (2026-10-09, steg D): the company's own account numbers and verification series for the SIE
  /// export of accepted quotes (lib/quotes/accounting.ts). Empty until the company fills it in.
  accountingSettings Json    @default("{}")
  /// Företagets mål (2026-10-28): the company's own goals – completed work orders per month for the statistics, and
  /// invoiced per month and quote win rate for Ekonomi (lib/workflow/company-goals.ts). Empty = no goal set.
  goalSettings       Json    @default("{}")
}

model UserPreferences {
  userId String @id
  data   Json   @default("{}")
}

/// One short digest per company and day (plan 2026-10-01, fas 4): what the rules counted (facts) and the text, written
/// by the AI model (source AI) or by the rules when it could not run (RULES). Numbers and project names only.
model AiDailyDigest {
  id             String   @id @default(cuid())
  organizationId String
  /// The Swedish calendar day the digest is about, YYYY-MM-DD.
  day            String
  text           String
  facts          Json
  source         String
  runId          String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, day])
  @@index([organizationId, createdAt])
}

model AdministrationEvent {
  id             String   @id @default(cuid())
  actorId        String
  organizationId String
  action         String
  detail         String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

/// PDF-mallar (2026-11-03, lib/pdf-templates): the product owner's change of one block of a document's default template,
/// product-wide. Null fields follow the default. `basedOnVersion` and `basedOnText` are the default when the block was
/// last edited or confirmed, so an upgrade that changes the default is flagged. A block that an upgrade removed keeps
/// its row with `archivedAt` set; nothing here is a company's data.
model PdfTemplateOverride {
  id             String    @id @default(cuid())
  documentType   String
  blockId        String
  text           String?
  visible        Boolean?
  orderIndex     Int?
  basedOnVersion String
  basedOnText    String?
  updatedById    String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([documentType, blockId])
}

/// PLC-apparater (2026-11-06): the product owner's designs of the simulator's devices, product-wide like PdfTemplateOverride.
/// `draft` is what the editor saved, `published` what every simulator draws with; both validated by
/// lib/machine/simulator/surface/device-designs.ts. Read with parameterised SQL (lib/machine/simulator/device-designs-server.ts).
model PlcDeviceDesign {
  key           String    @id
  draft         Json?
  published     Json?
  revision      Int       @default(1)
  updatedById   String?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
}

/// Min webbsida (2026-11-10; first the product owner's own site 2026-11-09): a company's connection to its own WordPress – the
/// site's address, the REST address found from it, the user and the application password sealed with the company's own data
/// key (lib/integrations/company-keys.ts). One per company (organizationId). The row 'site' is the first site's, migrated to
/// its company (20261110120000_website_per_company); its password was sealed before and is resealed on first read.
model WebsiteConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The site's normal address as the admin wrote it (https://example.se/); null on the first site's row.
  siteUrl        String?
  /// The REST address (…/wp-json/, …/index.php/wp-json/ or …/?rest_route=/).
  baseUrl        String
  username       String?
  passwordCipher String?
  /// What an extension's automatic blocks were last written from (ee/ only); the core never reads it.
  auto           Json?
  /// The site's typography as the editor shows it (lib/website/site-look.ts), read from the site's css on connecting and on Kontrollera.
  look           Json?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

/// A page of the company's website being edited in Workflow: the whole block markup, and WordPress's `modified` when it was opened.
model WebsitePageDraft {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pageId         Int
  title          String
  content        String
  baseModified   String
  /// Sökmotorer och delning (2026-11-11), only for a site with the SEO meta: the edited values and WordPress's when the editor opened the page.
  seo            Json?
  seoBase        Json?
  revision       Int          @default(1)
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  @@unique([organizationId, pageId])
}

/// The page as it was in WordPress just before Workflow wrote it (Publicera, Återställ, an automatic block).
model WebsitePageBackup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pageId         Int
  title          String
  content        String
  modified       String
  /// The page's SEO meta as it was (2026-11-11); null when the site had none.
  seo            Json?
  reason         String
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, pageId, createdAt])
}

/// A web font the company's site uses, copied to Workflow (Min webbsida's editor shows the site's own type without the browser
/// loading anything from the font's host). Replaced whenever the site's look is read again.
model WebsiteFont {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  family         String
  weight         String
  style          String
  format         String
  unicodeRange   String?
  bytes          Bytes
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// Facebook och Instagram (2026-11-10): the company's own Meta app and the page and Instagram account it posts to. The app
/// secret and the tokens are sealed with the company's own key (lib/integrations/company-keys.ts) and never returned.
/// Nothing is ever posted while publishingApproved is false (the company admin switches it on deliberately; off by default).
model MetaConnection {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appId                  String?
  appSecretCipher        String?
  /// The long-lived user token (about 60 days).
  userTokenCipher        String?
  userTokenExpiresAt     DateTime?
  dataAccessExpiresAt    DateTime?
  pageId                 String?
  pageName               String?
  pageTokenCipher        String?
  instagramId            String?
  instagramUsername      String?
  /// The pages the token reaches (id, name, Instagram account) – never their tokens; the admin chooses when there are several.
  pages                  Json?
  scopes                 String[]     @default([])
  /// unchecked, choose, ok, action (permissions missing), invalid.
  status                 String       @default("unchecked")
  statusMessage          String?
  checkedAt              DateTime?
  publishingApproved     Boolean      @default(false)
  publishingApprovedAt   DateTime?
  publishingApprovedById String?
  updatedById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
}

/// LinkedIn (2026-11-11): the company's own LinkedIn app (Client ID and secret), the member who connected it with LinkedIn's
/// 3-legged OAuth and where posts go (the member's own profile or a company page the member administers). The secret and
/// the tokens are sealed with the company's own key and never returned. Nothing is posted while publishingApproved is false.
model LinkedInConnection {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId               String?
  clientSecretCipher     String?
  /// What Koppla LinkedIn asks for: personal (openid profile w_member_social) or organization (also the company page's scopes).
  scopeSet               String       @default("personal")
  accessTokenCipher      String?
  accessTokenExpiresAt   DateTime?
  /// Only when LinkedIn grants the app programmatic refresh tokens.
  refreshTokenCipher     String?
  refreshTokenExpiresAt  DateTime?
  scopes                 String[]     @default([])
  memberId               String?
  memberName             String?
  /// person (the member's own profile) or organization (a company page).
  authorType             String       @default("person")
  authorId               String?
  authorName             String?
  /// The company pages the member administers (id and name), never a token; the admin chooses when there are several.
  organizations          Json?
  /// unchecked, choose, ok, action, invalid.
  status                 String       @default("unchecked")
  statusMessage          String?
  checkedAt              DateTime?
  publishingApproved     Boolean      @default(false)
  publishingApprovedAt   DateTime?
  publishingApprovedById String?
  /// The open Koppla LinkedIn: the hash of its state, who started it and until when it may come back (single use).
  pendingStateHash       String?      @unique
  pendingUserId          String?
  pendingExpiresAt       DateTime?
  pendingScopes          String[]     @default([])
  updatedById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
}

/// YouTube (2026-11-20): the company's own Google API project (OAuth client id and secret), the channel the admin chose after
/// signing in with Google, and the channel's playlists and categories. The secret, the tokens and the open sign-in's PKCE
/// verifier are sealed with the company's own key and never returned. Nothing is uploaded while publishingApproved is false.
model YouTubeConnection {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId               String?
  clientSecretCipher     String?
  accessTokenCipher      String?
  accessTokenExpiresAt   DateTime?
  refreshTokenCipher     String?
  scopes                 String[]     @default([])
  /// The Google account's channels (id and name, never a token); the admin chooses when there are several.
  channels               Json?
  channelId              String?
  channelName            String?
  /// The chosen channel's playlists and the assignable categories (id and name), read on Kontrollera and on opening.
  playlists              Json?
  categories             Json?
  /// unchecked, choose, ok, action, invalid.
  status                 String       @default("unchecked")
  statusMessage          String?
  checkedAt              DateTime?
  /// An upload asked for Olistad or Offentlig and YouTube kept it private: the API project has not passed Google's audit yet.
  privateLocked          Boolean      @default(false)
  privateLockedAt        DateTime?
  publishingApproved     Boolean      @default(false)
  publishingApprovedAt   DateTime?
  publishingApprovedById String?
  /// The open Koppla YouTube: the hash of its state, the sealed PKCE verifier, who started it and until when (single use).
  pendingStateHash       String?      @unique
  pendingVerifierCipher  String?
  pendingUserId          String?
  pendingExpiresAt       DateTime?
  updatedById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt
}

/// Filmer (2026-11-20): a finished film the company uploads to its YouTube channel – a draft until an admin presses Publicera
/// or Schemalägg. The file lies in the installation's own storage (STORAGE_ROOT/youtube-videos/<company>/) and goes to YouTube
/// from the server in a resumable upload; the browser never talks to Google. Removing the film from Workflow removes the file.
model YouTubeVideo {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// draft, uploading, published, failed (Schemalagd is an active ScheduledPublish of kind video).
  status             String       @default("draft")
  title              String       @default("")
  description        String       @default("")
  tags               String[]     @default([])
  categoryId         String?
  /// private, unlisted, public.
  privacy            String       @default("private")
  /// YouTube requires the answer before a film is published; null until it is given.
  madeForKids        Boolean?
  playlistId         String?
  playlistName       String?
  /// The stored film: its random name in storage, the name it had, its type, its size and how much of it has arrived.
  fileKey            String?
  fileName           String?
  fileType           String?
  fileSize           BigInt?
  fileReceived       BigInt       @default(0)
  fileUpload         String?
  /// The cover picture (JPEG or PNG in storage): own (an uploaded picture) or frame (a frame of the film, chosen in the browser).
  thumbnailKey       String?
  thumbnailSource    String?
  thumbnailUpdatedAt DateTime?
  /// What YouTube answered: the video's id, its privacy as YouTube keeps it, and the channel it went to.
  youtubeId          String?
  youtubePrivacy     String?
  youtubeChannelId   String?
  /// Steps still to do on YouTube after the upload (tried again by the upload job).
  thumbnailPending   Boolean      @default(false)
  playlistPending    Boolean      @default(false)
  /// The resumable upload: the sealed session address, how far YouTube has the file, the attempts and the lock.
  uploadSessionCipher String?
  uploadOffset       BigInt       @default(0)
  uploadAttempts     Int          @default(0)
  uploadNextAt       DateTime?
  uploadLockedUntil  DateTime?
  uploadStartedAt    DateTime?
  uploadById         String?
  uploadError        String?
  publishedAt        DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([status, uploadNextAt])
}

/// Inlägg (2026-11-10): a post for the company's Facebook page and Instagram account – always a draft until an admin presses
/// Publicera. The picture is drawn from heading, text and template on the server; imageKeyHash is the hash of the short-lived
/// address Instagram fetches it from.
model SocialPost {
  id                     String            @id @default(cuid())
  organizationId         String
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// manual, website (a published page) or release (a new version, HINTEK only).
  source                 String            @default("manual")
  sourceRef              String?
  /// draft, publishing, published, partial, failed.
  status                 String            @default("draft")
  heading                String            @default("")
  body                   String            @default("")
  caption                String            @default("")
  /// Hashtaggar (2026-11-12): "#tag #tag", added after the caption on Facebook, Instagram and LinkedIn; never in the newsletter.
  hashtags               String            @default("")
  link                   String?
  template               String            @default("color")
  /// A picture behind the template (from the site, a page or an upload), 1080 x 1080 JPEG; null: the template's own colour.
  background             Bytes?
  /// Where the background came from: the address, or "uppladdad".
  backgroundSource       String?
  toFacebook             Boolean           @default(true)
  toInstagram            Boolean           @default(true)
  facebookPostId         String?
  instagramMediaId       String?
  /// LinkedIn (2026-11-11): off unless chosen; the post's URN once published.
  toLinkedIn             Boolean           @default(false)
  linkedInPostId         String?
  /// Även som nyhetsbrev (2026-11-12): only the installation's superadmin may tick it; Publicera or the schedule then sends the
  /// post as one newsletter mailing (Mailing.socialPostId), exactly once.
  toNewsletter           Boolean           @default(false)
  /// The newsletter's own fields (2026-11-12): { subject, text, link, image }; a missing or null field follows the post
  /// (the heading, the caption without hashtags, the post's link and picture). Part of the approved content when ticked.
  newsletterMail         Json?
  /// Även som story (2026-11-13): off unless chosen; the post's picture in 9:16 also goes out as a story on the chosen Facebook
  /// page and/or Instagram account. The stories' own ids once published (retried alone like a channel).
  toStory                Boolean           @default(false)
  /// Logga (2026-11-13): auto (the variant that reads on the template), main, onDark, onLight or black; and small, medium or large.
  logoVariant            String            @default("auto")
  logoSize               String            @default("medium")
  /// Bakgrund bakom logotypen (2026-11-15): box (Ruta, the template's plate) or none (Ingen, the logo straight on the template); null is box.
  logoPlate              String?
  storyFacebookId        String?
  storyInstagramId       String?
  publishedAt            DateTime?
  publishedById          String?
  lastError              String?
  testedAt               DateTime?
  testResult             String?
  imageKeyHash           String?           @unique
  imageKeyExpiresAt      DateTime?
  /// The story picture's own short-lived address (Instagram fetches it separately from the post's picture).
  storyImageKeyHash      String?           @unique
  storyImageKeyExpiresAt DateTime?
  /// Bara på Instagram (2026-11-16): a text added only to Instagram's caption, after the post's text (e.g. "Länk i bio").
  instagramText          String            @default("")
  /// Kampanjlänkar (2026-11-16): links to the installation's own addresses get ?via=facebook|instagram|linkedin per channel.
  /// Off for every post made before 0.67.0 (the migration), on for new ones.
  campaignLinks          Boolean           @default(true)
  /// Innehåller AI-genererat ljud eller bild (2026-11-16): sent as Instagram's is_ai_generated; Facebook has no such field.
  aiGenerated            Boolean           @default(false)
  /// Publiceringens förlopp (2026-11-16, lib/meta/progress.ts): the steps of the latest Testpublicering or Publicera and its result.
  publishProgress        Json?
  /// Fler bilder (2026-11-16): picture 2–10 after the drawn one (an Instagram carousel, several photos on Facebook).
  images                 SocialPostImage[]
  createdById            String?
  updatedById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @default(now()) @updatedAt

  @@unique([organizationId, source, sourceRef])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}

/// Fler bilder (2026-11-16): a post's own extra picture, 1080 x 1350 JPEG; always read with the post's company. Instagram fetches it
/// from a short-lived address of its own (imageKeyHash), like the post's drawn picture.
model SocialPostImage {
  id                String     @id @default(cuid())
  organizationId    String
  postId            String
  // Tenant relation (2026-10-08 rule): the image and its post are always the same company.
  post              SocialPost @relation(fields: [postId, organizationId], references: [id, organizationId], onDelete: Cascade)
  position          Int        @default(0)
  bytes             Bytes
  /// The address it was fetched from, or "uppladdad".
  source            String     @default("uppladdad")
  imageKeyHash      String?    @unique
  imageKeyExpiresAt DateTime?
  createdAt         DateTime   @default(now())

  @@index([organizationId, postId, position])
}

/// Schemalägg (2026-11-11): a publication an admin approved for a later time (lib/schedule/). The job schedule:publish
/// publishes it when the time has come, as the admin who scheduled it and with exactly the content approved then.
model ScheduledPublish {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// post (Inlägg, to the post's channels) or website (a page on Min webbsida); lib/schedule/targets.ts.
  kind            String
  /// The post's id, or the WordPress page's id.
  targetId        String
  title           String         @default("")
  /// scheduled, needs_approval, running, published, failed, cancelled.
  status          String         @default("scheduled")
  /// The time the admin chose.
  runAt           DateTime
  /// runAt, or later after an attempt that may be tried again.
  nextAttemptAt   DateTime
  attempts        Int            @default(0)
  lockedUntil     DateTime?
  /// sha256 of the approved content; a post whose content no longer matches is not published.
  contentHash     String
  /// What is published: for a page the markup and search values themselves.
  payload         Json           @default("{}")
  channels        String[]       @default([])
  seriesId        String?
  /// Same company by the database itself; Ta bort serien clears the link first (lib/schedule/series-server.ts).
  series          ContentSeries? @relation(fields: [seriesId, organizationId], references: [id, organizationId], onDelete: NoAction)
  scheduledById   String
  scheduledAt     DateTime       @default(now())
  lastError       String?
  result          String?
  publishedAt     DateTime?
  failureMailedAt DateTime?
  cancelledById   String?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([status, nextAttemptAt])
  @@index([organizationId, runAt])
  @@index([organizationId, kind, targetId])
}

/// Innehållsserie (2026-11-11): a period, a rhythm and channels; one post per slot with a theme from Workflow's own functions.
model ContentSeries {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// themes (Ny serie: one draft per slot with a theme) or queue (Schemalägg i tur och ordning: the company's own drafts, 2026-11-12).
  kind           String              @default("themes")
  /// YYYY-MM-DD in Swedish time, both included.
  startDay       String
  endDay         String
  /// 0 = Monday … 6 = Sunday.
  weekdays       Int[]
  /// HH:MM in Swedish time.
  time           String
  channels       String[]            @default([])
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  items          ContentSeriesItem[]
  publishes      ScheduledPublish[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}

model ContentSeriesItem {
  id         String        @id @default(cuid())
  seriesId   String
  series     ContentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  /// The series' post (SocialPost.id, the same company).
  postId     String        @unique
  slotAt     DateTime
  theme      String
  position   Int
  /// rules (the theme's own short text) or ai (a draft from HINTEK AI that the admin reviews).
  textSource String        @default("rules")

  @@index([seriesId, position])
}

/// Återkommande (2026-11-12): the company's own publishing rhythm for posts – the weekdays and the clock time (Swedish time) that
/// Schemalägg suggests and that Schemalägg i tur och ordning spreads the waiting drafts over. A rhythm, never a repeated post.
model PostingRhythm {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 0 = Monday … 6 = Sunday.
  weekdays       Int[]
  /// HH:MM in Swedish time.
  time           String
  updatedById    String?
  updatedAt      DateTime     @default(now()) @updatedAt
}

model SystemSettings {
  id                         String  @id @default("global")
  suggestions                Json    @default("{}")
  commercial                 Json    @default("{}")
  /// E-post settings made in the app (lib/mail/settings.ts); empty = the server's .env values.
  mail                       Json    @default("{}")
  /// Webbpush (lib/push/settings.ts): the VAPID key pair (the private key sealed), the contact address and on/off; empty = off.
  push                       Json    @default("{}")
  /// HINTEK AI credit settings made in the app (ee/ai/credit-settings.ts); empty = the defaults.
  ai                         Json    @default("{}")
  /// HINTEK's own AI provider set in the app (ee/ai/provider-settings.ts): the sealed key and the switches; empty = .env.
  aiProvider                 Json    @default("{}")
  /// Inloggning: whether "Fortsätt med Google" is offered and accepted (lib/auth/login-settings.ts).
  googleSignIn               Boolean @default(true)
  /// "Tillåt nya konton": self-registration. Before "Vem får logga in" is chosen it also opens sign-in for everyone with an account.
  registrationOpen           Boolean @default(false)
  /// "Vem får logga in" (lib/auth/login-rule.ts): { mode: ALL | ONLY | BLOCK, allow: [], block: [] }; empty = not chosen yet.
  loginAccess                Json    @default("{}")
  /// Företagsuppslag: the sealed SCB key for looking up a company by organisation number (lib/kfid/company-lookup.ts).
  companyLookup              Json    @default("{}")
  /// Karta från Lantmäteriet (lib/map/topowebb.ts): the sealed Geotorget sign-in, the layer, the cache limit and the last check.
  map                        Json    @default("{}")
  /// Veckobrev (lib/mail/release-newsletter.ts): whether a draft is made, weekday, Swedish time and the last handled slot.
  newsletter                 Json    @default("{}")
  /// Beteendeanalys (lib/analytics/settings.ts): { usage, funnel, retentionMonths }; empty = the installation's defaults.
  analytics                  Json    @default("{}")
  /// Tvåstegsverifiering krävs för superadmin (2026-10-10): off by default; Google sign-in counts as Google's own.
  requireTwoFactorSuperadmin Boolean @default(false)
  /// Servernycklar (lib/integrations/server-secrets.ts): the Stripe and Google keys entered in the app, each sealed; empty = .env.
  serverKeys                 Json    @default("{}")
  /// Inloggning med Microsoft (lib/auth/microsoft.ts): { enabled, clientId, secretCipher, tenant, lastCheck }; empty = off.
  microsoftSignIn            Json    @default("{}")
  /// Radering efter avslut (lib/company-closure, 2026-10-10): "Automatisk radering påslagen". Off by default: the job then
  /// only counts down and notifies; the superadmin turns it on under Produktadministration → Kundföretag after seeing the list.
  autoEraseEndedCompanies    Boolean @default(false)
  /// Centrala nycklar (lib/secrets/central-store.ts, 2026-10-25): { entries, vault } – the sealed local copy of the
  /// installation's central keys and the state of the sync with the primary store (the installation's key vault).
  centralSecrets             Json    @default("{}")
  /// Operatörssidan (2026-10-30, lib/operator): the product owner's switches, { aiTroubleshooting }; empty = all off.
  operatorPage               Json    @default("{}")
}

/// Beteendeanalys (2026-10-07): anonymous daily counters, never tied to a person, a company, an address or a
/// browser. kind page = views of a page in the app, feature = a function used, funnel = visitors who reached a step on
/// the public pages (only with the visitor's consent), consent = the answers given in the cookie box. Rows older than
/// the retention time (14 months unless changed) are removed by the nightly system cleanup.
model AnalyticsCounter {
  day   String
  kind  String
  key   String
  count Int    @default(0)

  @@id([day, kind, key])
  @@index([kind, day])
}

model ControlVisit {
  userId         String
  organizationId String
  controlId      String
  openedAt       DateTime @default(now())

  @@id([userId, organizationId, controlId])
  @@index([userId, organizationId, openedAt])
}

// Forms (2026-09-26, design v2): published centrally by the superadmin, not tenant-bound, and never customer
// data. A version is append-only (a database trigger refuses updates and deletes); protocols point to their version.
model FormTemplate {
  id               String                @id @default(cuid())
  // Company forms (2026-09-27): NULL = HINTEK's forms, shown to everyone; otherwise only that company's.
  organizationId   String?
  publisherName    String                @default("HINTEK")
  // Who made the form (2026-09-28): HINTEK, the company, or – later – a community author with a licence.
  origin           String                @default("COMPANY")
  authorName       String                @default("")
  authorUrl        String                @default("")
  license          String                @default("")
  // An imported form: the original publisher, whether the file's signature was verified, and the source form.
  importedFrom     Json?
  // A company's own version of a HINTEK original (2026-09-27): the original and the published version it started from.
  baseTemplateId   String?
  baseVersion      Int?
  // Whose permission governs the protocols: forms, kfid (Kontroll före idrifttagning) or risk-assessment.
  permissionArea   String                @default("forms")
  name             String
  description      String                @default("")
  color            String                @default("green")
  displayName      String                @default("")
  internalNote     String                @default("")
  icon             String                @default("file-spreadsheet")
  category         String                @default("OTHER")
  allowStandalone  Boolean               @default(true)
  allowInProject   Boolean               @default(true)
  status           String                @default("DRAFT")
  draft            Json
  draftRevision    Int                   @default(1)
  publishedVersion Int?
  createdBy        String
  updatedBy        String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  versions         FormTemplateVersion[]
  events           FormTemplateEvent[]
  organization     Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseTemplate     FormTemplate?         @relation("FormTemplateCopies", fields: [baseTemplateId], references: [id], onDelete: SetNull)
  copies           FormTemplate[]        @relation("FormTemplateCopies")

  @@unique([organizationId, baseTemplateId])
  @@index([status, updatedAt])
  @@index([organizationId, status, updatedAt])
}

model FormTemplateVersion {
  id              String         @id @default(cuid())
  templateId      String
  version         Int
  name            String
  description     String         @default("")
  color           String         @default("green")
  displayName     String         @default("")
  icon            String         @default("file-spreadsheet")
  category        String         @default("OTHER")
  allowStandalone Boolean        @default(true)
  allowInProject  Boolean        @default(true)
  document        Json
  hash            String
  publishedBy     String
  publisherName   String         @default("HINTEK")
  importedFrom    Json?
  createdAt       DateTime       @default(now())
  template        FormTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  protocols       WorkflowTask[]

  @@unique([templateId, version])
}

model FormTemplateEvent {
  id          String       @id @default(cuid())
  templateId  String
  action      String
  summary     String
  actorUserId String
  actorName   String
  createdAt   DateTime     @default(now())
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
}

/// Limit profiles (2026-09-28): a company's own limit values for one form family at one facility, optionally per
/// object there (objectName, e.g. unit G1). The form only names the limits; the numbers belong to the facility.
model FormLimitProfile {
  id             String           @id @default(cuid())
  organizationId String
  // The form family: the HINTEK original's id also for a company's version of it. No foreign key, so the values
  // survive a deleted or replaced form.
  templateId     String
  facilityId     String
  objectName     String           @default("")
  values         Json
  version        Int              @default(1)
  updatedBy      String
  updatedByName  String           @default("")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite tenant relation (2026-10-08): a limit profile belongs to a place in the same company.
  facility       CustomerFacility @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, templateId, facilityId, objectName])
  @@index([organizationId, facilityId])
}

/// Värden och referenser (2026-10-06): the company's own values for the limits its forms declare (the same shape
/// as a form's limit: alarm and warning range), with the source the company names – a standard, a document, a version.
/// Organisation data: strictly per company, never global, never in a form file. A protocol takes the object's, the
/// facility's, then the company's value, and last the form's own.
model CompanyReferenceValue {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  low            Float?
  high           Float?
  warnLow        Float?
  warnHigh       Float?
  source         String       @default("")
  reference      String       @default("")
  version        Int          @default(1)
  updatedBy      String
  updatedByName  String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

/// Återkommande kontroller (2026-09-28): a round of one form at a facility, customer or project, repeated daily,
/// weekly or monthly (rule, lib/workflow/form-schedule.ts). Protocols are made when a round is started and carry
/// the schedule and the day in their answers (values.round); nothing is created in advance.
model FormSchedule {
  id                 String                   @id @default(cuid())
  organizationId     String
  templateId         String
  title              String
  customerId         String?
  facilityId         String?
  projectId          String?
  assignedToUserId   String?
  assignedToName     String                   @default("")
  rule               Json
  // Round reminders (2026-09-30): { bell, email }.
  reminders          Json                     @default("{}")
  // Tillfällig plats (2026-10-08): { address, postalCode, city, latitude, longitude } or null; follows into the protocols.
  tempPlace          Json?
  active             Boolean                  @default(true)
  version            Int                      @default(1)
  deletedAt          DateTime?
  createdBy          String
  updatedBy          String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facility           CustomerFacility?        @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  reminderDeliveries RoundReminderDelivery[]
  /// Ej utfört (2026-10-28): the recorded outcomes of the round's occurrences, kept by day whatever the rule becomes.
  occurrenceOutcomes RoundOccurrenceOutcome[]
  /// Driftrond i arbetsordern (2026-10-27): the work orders that hold the round (and 0.24.0's per occurrence).
  workOrders         WorkflowTask[]           @relation("RoundWorkOrder")

  // Tenant relations (2026-10-08): customerId, facilityId, projectId, templateId and assignedToUserId are checked by
  // triggers from migration 20261009200000_tenant_composite_relations, because a composite FK cannot keep SET NULL on
  // only the id (organizationId is required), templateId may name one of HINTEK's global forms, and a project or a
  // membership that is removed later must not block that removal. Reminder deliveries use [id, organizationId].
  @@unique([id, organizationId])
  @@index([organizationId, active, deletedAt])
  @@index([organizationId, facilityId])
}

/// One e-mail reminder per round, day and recipient (2026-09-30), so the job never sends twice.
model RoundReminderDelivery {
  id             String       @id @default(cuid())
  organizationId String
  scheduleId     String
  occurrence     String
  userId         String
  status         String
  failure        String?
  createdAt      DateTime     @default(now())
  schedule       FormSchedule @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([scheduleId, occurrence, userId])
  @@index([organizationId, createdAt])
}

/// Ej utfört (2026-10-28, 0.28.0 etapp 5): an occurrence of a round that will not be done, with the required reason,
/// who said so and when. Append-only history keyed by the day (YYYY-MM-DD), never by the rule, so it is kept when the
/// round's rule changes. A mistake is revoked (revoked*), never deleted; marking again makes a new row. At most one active
/// NOT_DONE per round and day (partial unique index in the migration). No protocol is made for it. workOrderId is the work
/// order that held the day when it was recorded – no foreign key, the history outlives it (as ReportArchiveEntry).
model RoundOccurrenceOutcome {
  id             String       @id @default(cuid())
  organizationId String
  scheduleId     String
  occurrence     String
  /// NOT_DONE (CHECK in the migration).
  outcome        String       @default("NOT_DONE")
  reason         String
  userId         String
  userName       String       @default("")
  recordedAt     DateTime     @default(now())
  workOrderId    String?
  revokedAt      DateTime?
  revokedById    String?
  revokedByName  String?
  schedule       FormSchedule @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, scheduleId, occurrence])
  @@index([organizationId, recordedAt])
}

/// HINTEK AI memory (2026-09-30): the company's general memory (scope COMPANY, subject "company") and a
/// pseudonymised memory per user (scope USER, subject = keyed hash of company and user). At most 2000 characters.
model AiMemory {
  id             String       @id @default(cuid())
  organizationId String
  scope          String
  subject        String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, subject])
}

/// Utskick (2026-10-03): a newsletter to those who said yes, or important information to every company's
/// administrators, written by the superadmin and sent from a queue (npm run mailings:send).
enum MailingAudience {
  NEWSLETTER
  ADMINS
}

enum MailingStatus {
  /// Waits for its time (scheduledAt); the recipients are fixed when it is queued.
  SCHEDULED
  QUEUED
  SENT
  /// Veckobrev (2026-10-07): written by the weekly job (or saved by the superadmin) and waiting for approval. A
  /// draft has no recipients and nothing ever sends it by itself; only "Godkänn och skicka" queues it.
  DRAFT
  /// A veckobrev draft the superadmin chose to skip: kept without recipients, so the same notes are not drafted again.
  DISMISSED
}

enum MailingRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Mailing {
  id             String             @id @default(cuid())
  subject        String
  body           String
  audience       MailingAudience
  status         MailingStatus      @default(QUEUED)
  createdById    String
  createdAt      DateTime           @default(now())
  finishedAt     DateTime?
  /// Schemalagt utskick (2026-10-06): when it is queued, Swedish time chosen by the superadmin.
  scheduledAt    DateTime?
  /// Veckobrev: the newest version whose notes it carries, so the next one starts after it.
  releaseVersion String?
  /// Veckobrev (2026-10-07): who approved a draft and when; a mailing that was a draft is never sent without it.
  approvedById   String?
  approvedAt     DateTime?
  /// Även som nyhetsbrev (2026-11-12): the post (Inlägg) this newsletter was made from; unique, so a post is mailed once. No
  /// foreign key: removing the post keeps the sent mailing in the history.
  socialPostId   String?            @unique
  recipients     MailingRecipient[]

  @@index([createdAt])
}

model MailingRecipient {
  id           String                 @id @default(cuid())
  mailingId    String
  mailing      Mailing                @relation(fields: [mailingId], references: [id], onDelete: Cascade)
  userId       String?
  /// A subscriber from the landing page (NewsletterSubscriber) instead of a user; its own way to say no.
  subscriberId String?
  email        String
  status       MailingRecipientStatus @default(PENDING)
  sentAt       DateTime?

  @@unique([mailingId, email])
  @@index([status, mailingId])
}

/// Följ nyhetsbrevet (2026-11-12): an address given on the landing page. Double opt-in: pending until the link in the
/// confirmation mail is used (only the token's sha256 is kept, 48 hours); unconfirmed rows are deleted when the token expires,
/// and saying no deletes the row. No IP address or other detail is stored (lib/mail/newsletter-subscribers.ts).
model NewsletterSubscriber {
  id                 String    @id @default(cuid())
  /// Trimmed and lower-cased.
  email              String    @unique
  /// pending or active.
  status             String    @default("pending")
  tokenHash          String?   @unique
  tokenExpiresAt     DateTime?
  /// The last confirmation mail; at most one a day per address.
  confirmationSentAt DateTime?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([status, tokenExpiresAt])
}

/// Notiser per e-post och webbpush (2026-10-07): the person's own choice, never prefilled; the bell is always on.
/// No foreign key to the person (like UserPreferences); erasing the person removes the row (lib/auth/erasure.ts).
model NoticePreference {
  userId            String   @id
  email             Boolean  @default(false)
  /// Set while at least one device of the person has a push subscription.
  push              Boolean  @default(false)
  /// Which kinds of notice (lib/workflow/notice-channels.ts); empty means none.
  kinds             String[] @default([])
  /// Integrationsmotorn E6: personens eget ja till maskinlarm även på natten (20–06). Gäller bara när företaget har valt
  /// larmnotiser dygnet runt; av från början.
  machineAlarmNight Boolean  @default(false)
  /// Notiser som kräver åtgärd (beslut 4, 2026-11-01) går med e-post och push från början; personen kan stänga av dem här.
  requiredNotices   Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// A browser or device that said yes to web push (the Push API's subscription), one row per endpoint. The keys are the
/// device's public key and authentication secret, which only that device and the server hold.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

/// One e-mail or push per notice, channel and person, so the job never sends the same notice twice. The company is kept
/// so a company's rows go with it (lib/auth/erasure.ts); rows older than a year are cleared by history:retention.
model NoticeDelivery {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// The notice and the stage it was in (lib/workflow/notice-channels.ts noticeKey).
  key            String
  /// "EMAIL" or "PUSH".
  channel        String
  createdAt      DateTime @default(now())

  @@unique([userId, channel, key])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

/// Kommentarer (beslut 14, 2026-11-01): one thread per work order, project and deviation. Exactly one parent column is set
/// (CHECK in the migration). Each parent goes through [parent, organizationId], so the database refuses a comment on another
/// company's row, and the thread goes with its parent. Internal unless inCustomerReport is set. Followers and the notices of
/// a comment are NoticeDelivery rows (lib/comments/model.ts). The author's name is kept with the comment.
model Comment {
  id               String                   @id @default(cuid())
  organizationId   String
  workflowTaskId   String?
  projectId        String?
  deviationId      String?
  authorUserId     String?
  authorName       String
  body             String
  inCustomerReport Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowTask     WorkflowTask?            @relation(fields: [workflowTaskId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  project          Project?                 @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  deviation        SelfInspectionDeviation? @relation(fields: [deviationId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, workflowTaskId, createdAt])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, deviationId, createdAt])
  @@index([authorUserId])
}

/// Rapportarkiv (2026-10-07): a PDF or Excel report a person chose to keep when exporting. The file lives in the
/// ordinary storage (lib/kfid/storage.ts) and is kept as long as the company's history (history:retention). Read by those
/// who may read what it is a report of – `subject` is that permission area, checked again at every read. No foreign key
/// to the task or project: the report outlives them.
model ReportArchiveEntry {
  id             String   @id @default(cuid())
  organizationId String
  /// WORK_ORDER, RISK_ASSESSMENT, FORM or PROJECT.
  kind           String
  /// The workflow permission subject of what it reports (work-order, risk-assessment, forms, kfid or projects).
  subject        String
  taskId         String?
  projectId      String?
  /// The task's or project's title when the report was made.
  title          String
  /// PDF or XLSX.
  format         String
  filename       String
  storagePath    String   @unique
  mimeType       String
  size           Int
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, createdById, createdAt])
  @@index([organizationId, taskId])
}

/// Hastighetsbegränsning (säkerhetsgenomgång 2026-10-04): one counter per key (for example a sign-in address or an IP
/// address) and its current window, shared by every app process and kept through a restart. Old rows are cleared nightly.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

/// Egenkontrollprogram, etapp 1 (2026-10-06, docs/proposals/egenkontrollprogram.md): one programme per company
/// (scopeKey "company"), copied from HINTEK's original in lib/self-inspection/template.ts and edited as a draft.
/// Etapp 2 (beslut 1) adds programmes for a customer in the register: scopeKey "customer:<id>" with customerId set.
/// Approved versions, read confirmations, reviews and the deviation log are never removed through the app; only the
/// erasure of a whole company takes them. Children carry organizationId and point to the programme through
/// (programId, organizationId), so a row can never belong to another company's programme.
model SelfInspectionProgram {
  id                         String                              @id @default(cuid())
  organizationId             String
  scopeKey                   String                              @default("company")
  customerId                 String?
  title                      String
  templateVersion            String
  activityTypes              String[]
  worksOnOthersInstallations Boolean                             @default(true)
  /// YYYY-MM-DD: when the registration at Elsäkerhetsverket was last checked.
  registrationCheckedAt      String?
  revision                   Int                                 @default(1)
  createdById                String
  updatedById                String
  createdAt                  DateTime                            @default(now())
  updatedAt                  DateTime                            @updatedAt
  organization               Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                   Customer?                           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sections                   SelfInspectionSection[]
  roles                      SelfInspectionRole[]
  competence                 SelfInspectionCompetence[]
  versions                   SelfInspectionVersion[]
  reviews                    SelfInspectionReview[]
  deviations                 SelfInspectionDeviation[]
  customerRequirements       SelfInspectionCustomerRequirement[]

  @@unique([organizationId, scopeKey])
  @@unique([id, organizationId])
}

model SelfInspectionSection {
  id             String                @id @default(cuid())
  organizationId String
  programId      String
  /// The template section it came from ("" for the company's own).
  key            String                @default("")
  title          String
  body           String
  legalRef       String                @default("")
  sortOrder      Int
  program        SelfInspectionProgram @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([programId, sortOrder])
}

model SelfInspectionRole {
  id             String                     @id @default(cuid())
  organizationId String
  programId      String
  key            String                     @default("")
  name           String
  description    String                     @default("")
  duties         String                     @default("")
  /// Elinstallatör för regelefterlevnad (ERE).
  isEre          Boolean                    @default(false)
  /// Roller med nivå (2026-10-07): 1–3. A person's level is the highest among their roles; a task above it cannot
  /// be assigned to, started, filled in, completed or signed by the person (see lib/self-inspection/levels.ts).
  level          Int                        @default(1)
  /// What the role does in the programme (plan, perform, inspect, approve, deviations); never a Workflow permission.
  capabilities   String[]
  sortOrder      Int
  program        SelfInspectionProgram      @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Cascade)
  members        SelfInspectionRoleMember[]

  @@unique([id, organizationId])
  @@index([programId, sortOrder])
}

/// A person in the company with a programme role; the membership key keeps it inside the company.
model SelfInspectionRoleMember {
  id                  String             @id @default(cuid())
  organizationId      String
  roleId              String
  userId              String
  /// A, AL or B; "" when not stated.
  authorizationLevel  String             @default("")
  /// Optional (beslut 7); shown only to admins and the person, never in a version or the PDF.
  authorizationNumber String             @default("")
  /// The ERE who stands in the company's registration.
  registered          Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  role                SelfInspectionRole @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  member              OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([roleId, userId])
  @@index([organizationId, userId])
}

/// What the programme says about one person's competence (2026-10-06): the work the person may do, the
/// assessment, limitations and supervision. Part of the draft; an approved version freezes it in its content.
model SelfInspectionCompetence {
  id             String                @id @default(cuid())
  organizationId String
  programId      String
  userId         String
  /// Activity type keys (lib/self-inspection/model.ts ACTIVITY_TYPES) the person may work in.
  workTypes      String[]
  scope          String                @default("")
  assessment     String                @default("")
  /// YYYY-MM-DD.
  assessedAt     String?
  limitations    String                @default("")
  supervised     Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  program        SelfInspectionProgram @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Cascade)
  member         OrganizationMember    @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([organizationId, userId])
}

/// An approved version: the content as it stood, its SHA-256, who approved it and why. A trigger refuses changes.
model SelfInspectionVersion {
  id             String                           @id @default(cuid())
  organizationId String
  programId      String
  number         Int
  content        Json
  contentHash    String
  changeReason   String
  approvedById   String
  /// The approver's name as it was at approval (2026-10-09: names stay in approved versions for traceability).
  /// Empty for versions approved before 2026-10-11; those read the name from the person.
  approvedByName String                           @default("")
  approvedAt     DateTime                         @default(now())
  program        SelfInspectionProgram            @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Restrict)
  confirmations  SelfInspectionReadConfirmation[]

  @@unique([programId, number])
  @@unique([id, organizationId])
}

/// "Jag har läst": one per person and version (like LegalAcceptance).
model SelfInspectionReadConfirmation {
  id             String                @id @default(cuid())
  organizationId String
  versionId      String
  userId         String
  confirmedAt    DateTime              @default(now())
  version        SelfInspectionVersion @relation(fields: [versionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([versionId, userId])
  @@index([organizationId, userId])
}

/// The yearly review (3 kap. 13 §).
model SelfInspectionReview {
  id                  String                @id @default(cuid())
  organizationId      String
  programId           String
  /// YYYY-MM-DD.
  reviewedAt          String
  reviewedById        String
  versionNumber       Int?
  registrationChecked Boolean
  deviationsReviewed  Boolean
  competenceFollowed  Boolean
  /// NO_CHANGES or CHANGES_NEEDED.
  outcome             String
  notes               String                @default("")
  createdAt           DateTime              @default(now())
  program             SelfInspectionProgram @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([programId, reviewedAt])
}

/// The deviation log and action plan: a deviation or an improvement with its action, responsible person and date.
model SelfInspectionDeviation {
  id                      String                              @id @default(cuid())
  organizationId          String
  /// Avvikelser (2026-10-30: a general deviation log, not a part of the egenkontroll programme): the programme is
  /// optional – set for entries made while the company has one, null otherwise. Numbered per company.
  programId               String?
  number                  Int
  /// DEVIATION or IMPROVEMENT.
  kind                    String                              @default("DEVIATION")
  title                   String
  description             String                              @default("")
  /// IMMEDIATE (omedelbar åtgärd) or ROUTINE (rutinöversyn).
  category                String                              @default("ROUTINE")
  systematic              Boolean                             @default(false)
  /// OPEN, IN_PROGRESS or DONE.
  status                  String                              @default("OPEN")
  action                  String                              @default("")
  responsibleUserId       String?
  /// YYYY-MM-DD or "".
  dueDate                 String                              @default("")
  followUp                String                              @default("")
  reportedById            String
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt
  closedAt                DateTime?
  /// Etapp 2: the protocol row it was taken from ("Till avvikelseloggen"); no key, so the log outlives the task.
  sourceTaskId            String?
  sourceTitle             String                              @default("")
  sourceRowId             String                              @default("")
  /// Avvikelse ↔ arbetsorder (2026-10-10, migration 20261012140100_deviation_work_order): the work order that
  /// fixes the entry. Linked both ways (the order's page shows the entry, the log shows the order); finishing the order
  /// marks the entry DONE (Åtgärdad) with who and when. Cleared if the work order is deleted.
  workOrderId             String?
  /// Who closed the entry (a person, or the person who finished the linked work order) and their name as it was then.
  closedById              String?
  closedByName            String                              @default("")
  /// Typ (2026-10-30, tillbud i avvikelseloggen): SELF_INSPECTION (egenkontroll, the default and everything from
  /// before) | RISK_OBSERVATION | NEAR_MISS (tillbud) | ACCIDENT (olycksfall); CHECK in the migration. A near miss or an
  /// accident is seen only by its reporter, admins and the Teamet right, and needs whatHappened, cause and action to close.
  type                    String                              @default("SELF_INSPECTION")
  /// When it happened (near miss, accident); null for the others.
  occurredAt              DateTime?
  /// Vad hände and Varför (the investigation); Åtgärd is `action`.
  whatHappened            String                              @default("")
  cause                   String                              @default("")
  /// Allvarligt tillbud or allvarlig olycka: shown with "ska anmälas till Arbetsmiljöverket"; ticked when it was reported.
  /// Allvarlighetsgrad (2026-10-30): LOW | NORMAL | HIGH | ACUTE, chosen when reporting; it colours the list card.
  severity                String                              @default("NORMAL")
  serious                 Boolean                             @default(false)
  personalInjury          Boolean                             @default(false)
  /// Electrical: also shows the link to the electrical safety authority's form.
  electrical              Boolean                             @default(false)
  reportedToAuthorityAt   DateTime?
  reportedToAuthorityById String?
  /// The short line written when it was marked done (Markera klar).
  doneNote                String                              @default("")
  /// Lagringstid (2026-11-04, lib/self-inspection/retention.ts): set while the company keeps the entry for a claim; the nightly job leaves it alone.
  retentionHoldAt         DateTime?
  retentionHoldById       String?
  /// Set when the nightly job took a near miss's or an accident's names, text, comments and photos away; the entry can no longer be changed.
  personalDataRemovedAt   DateTime?
  attachments             SelfInspectionDeviationAttachment[]
  comments                Comment[]
  workOrder               WorkflowTask?                       @relation("DeviationWorkOrder", fields: [workOrderId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Cascade)
  program                 SelfInspectionProgram?              @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([programId, number])
  @@unique([organizationId, number])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, reportedById])
  @@index([organizationId, sourceTaskId])
  @@index([organizationId, workOrderId])
  @@index([organizationId, type, status])
}

/// Bilder på avvikelser (2026-10-30): photos on any deviation type, "before" when reported and "after" when marked done.
/// Stored like work order attachments (lib/kfid/storage.ts); seen by whoever may see the deviation; removed with it.
model SelfInspectionDeviationAttachment {
  id             String                  @id @default(cuid())
  organizationId String
  deviationId    String
  /// BEFORE | AFTER (CHECK in the migration).
  phase          String                  @default("BEFORE")
  filename       String
  storagePath    String                  @unique
  mimeType       String
  size           Int
  createdById    String
  createdAt      DateTime                @default(now())
  deviation      SelfInspectionDeviation @relation(fields: [deviationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, deviationId])
}

/// Etapp 2 (2026-10-06): who performs and who inspects a project or a task, chosen among the people with the
/// programme role, and the kind of work. Exactly one of projectId and taskId; the person ids are checked on write.
model SelfInspectionAssignment {
  id              String        @id @default(cuid())
  organizationId  String
  projectId       String?
  taskId          String?
  /// Legacy (2026-10-07): roles are given in advance with a level now; nothing new is written here, what is stored is kept.
  performerUserId String?
  inspectorUserId String?
  /// An activity type key (lib/self-inspection/model.ts ACTIVITY_TYPES).
  activityType    String?
  updatedById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  task            WorkflowTask? @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, projectId])
  @@unique([organizationId, taskId])
}

/// Riskklasser (2026-10-07): the company's own risk class 1–3 for a task type. The key is "kind:WORK_ORDER" or
/// "form:<form family id>" (the HINTEK original's id also for the company's version of it, so the class follows the form);
/// a type without a row uses HINTEK's proposal (lib/self-inspection/levels.ts). Organisation data, never global.
model TaskRiskClass {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  riskClass      Int
  updatedById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

/// A customer's special requirements that the programme refers to (etapp 2): the company's own text.
/// Not read or written any more (2026-10-07): the text is the field "Särskilda krav" on the customer card
/// (Customer.specialRequirements), where migration 20261008200000 copied it. The rows stay until a later release drops the table.
model SelfInspectionCustomerRequirement {
  id             String                @id @default(cuid())
  organizationId String
  programId      String
  customerId     String
  requirements   String
  updatedById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  program        SelfInspectionProgram @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Cascade)
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([programId, customerId])
  @@index([organizationId, customerId])
}

/// A line of a person's competence card (etapp 3): a training or certificate with dates. Personal data: admins and the
/// person read it. When the person leaves the company (the membership is removed or the person is erased by an admin)
/// the card is kept for three months and then deleted by the nightly job (2026-10-07): `leftAt` is set by a
/// trigger on OrganizationMember and cleared when the person is a member again. An admin can delete a card at any time.
/// No key to the membership – the card outlives it; a trigger checks that a new line is for a member of the company.
model SelfInspectionCredential {
  id             String                         @id @default(cuid())
  organizationId String
  userId         String
  title          String
  /// Who gave the training (kompetenskort v2, 2026-10-08); "" when not stated.
  provider       String                         @default("")
  /// YYYY-MM-DD.
  issuedAt       String?
  /// YYYY-MM-DD; the bell reminds 30 days before.
  validUntil     String?
  note           String                         @default("")
  /// When the person left the company; null while the person is a member.
  leftAt         DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files          SelfInspectionCredentialFile[]

  @@unique([id, organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, validUntil])
  @@index([leftAt])
}

/// A certificate or proof attached to a line of a competence card (2026-10-07): stored like every other private
/// attachment (lib/kfid/storage.ts, 10 MB, the same file types) and deleted with the line, the card and by the nightly job.
model SelfInspectionCredentialFile {
  id             String                   @id @default(cuid())
  organizationId String
  credentialId   String
  filename       String
  storagePath    String                   @unique
  mimeType       String
  size           Int
  createdAt      DateTime                 @default(now())
  credential     SelfInspectionCredential @relation(fields: [credentialId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, credentialId])
}

/// Kompetenskort v2 (2026-10-08): the rest of a person's competence card beside the training lines – driving
/// licence, languages, the company's competence groups, a suggestion from the person and the card's versions. Personal
/// data like the lines: admins and the person read it. It follows the lines' three-month rule: `leftAt` is set by the
/// same membership triggers, and the nightly job deletes the card with its versions and groups. A trigger checks that a
/// new card is for a member of the company.
model SelfInspectionCompetenceCard {
  id                String                                @id @default(cuid())
  organizationId    String
  userId            String
  /// Driving licence classes (designations only, e.g. "B", "BE", "C").
  licenceClasses    String[]
  /// YYYY-MM-DD; the bell reminds 30 days before.
  licenceValidUntil String?
  /// [{ language, level }] with the levels of lib/self-inspection/model.ts LANGUAGE_LEVELS.
  languages         Json                                  @default("[]")
  /// The person's own suggestion of a change (a member never edits the card); cleared by an admin.
  suggestion        String                                @default("")
  suggestedAt       DateTime?
  /// The number of the latest version (0 before the first).
  revision          Int                                   @default(0)
  leftAt            DateTime?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt
  organization      Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups            SelfInspectionCompetenceGroupMember[]
  versions          SelfInspectionCompetenceCardVersion[]

  @@unique([organizationId, userId])
  @@index([organizationId, licenceValidUntil])
  @@index([leftAt])
}

/// The company's own competence groups (e.g. one per kind of role or work); organisation data, never global.
model SelfInspectionCompetenceGroup {
  id             String                                @id @default(cuid())
  organizationId String
  name           String
  description    String                                @default("")
  sortOrder      Int                                   @default(0)
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt
  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        SelfInspectionCompetenceGroupMember[]

  @@unique([id, organizationId])
  @@index([organizationId, sortOrder])
}

/// A person's place in a competence group; both keys carry the company, so a card never joins another company's group.
model SelfInspectionCompetenceGroupMember {
  id             String                        @id @default(cuid())
  organizationId String
  groupId        String
  userId         String
  createdAt      DateTime                      @default(now())
  group          SelfInspectionCompetenceGroup @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Cascade)
  card           SelfInspectionCompetenceCard  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([organizationId, userId])
}

/// Every save of a competence card keeps a version: the whole card as it then stood. A trigger refuses changes; the
/// versions go with the card (removed by an admin, or by the nightly job three months after the person left).
model SelfInspectionCompetenceCardVersion {
  id             String                       @id @default(cuid())
  organizationId String
  userId         String
  number         Int
  content        Json
  /// What the save changed, in a few words ("Utbildning tillagd: …").
  change         String                       @default("")
  savedById      String
  savedAt        DateTime                     @default(now())
  card           SelfInspectionCompetenceCard @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([organizationId, userId, number])
}

/// The company's measuring instruments (etapp 3) with calibration; a protocol can take type, S/N and date from here.
model Instrument {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  serialNumber      String       @default("")
  /// YYYY-MM-DD.
  calibratedAt      String?
  /// YYYY-MM-DD; the bell reminds admins 30 days before.
  nextCalibrationAt String?
  note              String       @default("")
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive, nextCalibrationAt])
}

// Artiklar och priser, steg 1 (2026-10-08, docs/proposals/grossistimport-2026-10-08.md): each company's own
// catalogue, filled from its own files on the Import page. The supplier is the company's own record (never a fixed list
// or a name in the code), prices are history (append-only; a trigger refuses UPDATE), and a work order's material row
// holds a copy of the price, so nothing here ever changes a saved work order. Never shared between companies, never
// shown to superadmin, never sent to AI. Every link is a composite [x, organizationId] key.
model CatalogueSupplier {
  id             String                   @id @default(cuid())
  organizationId String
  name           String
  /// Lower-cased, trimmed name: one supplier per name in a company.
  nameKey        String
  /// The company's customer number at the supplier (optional).
  customerNumber String                   @default("")
  /// Which of the four wholesalers this is (solar/ahlsell/sonepar/rexel), null for another supplier (2026-10-13 natt).
  wholesaler     String?
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles       CatalogueArticle[]
  imports        CatalogueImport[]
  profiles       CatalogueImportProfile[]
  rebates        CatalogueRebate[]
  filePrices     CatalogueFilePrice[]

  @@unique([id, organizationId])
  @@unique([organizationId, nameKey])
  @@index([organizationId, wholesaler])
}

model CatalogueArticle {
  id                    String            @id @default(cuid())
  organizationId        String
  supplierId            String
  /// The supplier's article number as in the file ("" when the file only has an E-nummer).
  supplierArticleNo     String            @default("")
  /// Swedish E-nummer from the company's own file (digits only), optional.
  eNumber               String            @default("")
  /// The manufacturer's article number from the company's own file, optional (2026-10-09); "" when none.
  manufacturerArticleNo String            @default("")
  /// What an article is matched on at the next import: the article number, otherwise "e:" + E-nummer.
  articleKey            String
  name                  String
  unit                  String            @default("")
  /// The supplier's discount group from the company's own file (Rabattgrupp/Produktgrupp), "" when none; for steg 2.
  discountGroup         String            @default("")
  /// RSK-nummer (VVS) from the company's own file, digits only, "" when none (prisfiler etapp 1, 2026-10-12).
  rskNumber             String            @default("")
  /// GTIN/EAN (14 digits, check digit right) and the manufacturer's name from the company's own file, "" when none (2026-10-14).
  gtin                  String            @default("")
  manufacturer          String            @default("")
  /// Förpackning, multipel, minsta beställning, lagerförd och status from the company's own file (2026-10-15), "" when
  /// the file has none: pieces per package (Sonepar Antsort), the order multiple in the article's unit (Ahlsell Multipel,
  /// Sonepar Stdfp) and the minimum order quantity (Solar MinBestKvant) as decimals with a dot, stocked J/N (Ahlsell
  /// Lagerförd J/N, Rexel L), and the status UTGAR (going out, Rexel UL) or PRIS_PA_BEGARAN (Rexel PPB, Sonepar Påbeg).
  packageSize           String            @default("")
  orderMultiple         String            @default("")
  minOrderQuantity      String            @default("")
  stocked               String            @default("")
  status                String            @default("")
  /// The company's product with the same common number (E-nummer, RSK, GTIN or manufacturer's number); null = the supplier's own product.
  productId             String?
  /// Kept by the trigger of 20261012170000_catalogue_products_search (lib/catalogue/normalize.ts); never written by Prisma.
  articleNoNorm         String            @default("") @ignore
  articleNoCore         String            @default("") @ignore
  searchText            String            @default("") @ignore
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier              CatalogueSupplier @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product               CatalogueProduct? @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: NoAction)
  prices                CataloguePrice[]
  /// Underhåll (2026-10-30): förrådets artiklar som pekar hit.
  storeItems            StoreItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, supplierId, articleKey])
  @@index([organizationId, eNumber])
  @@index([organizationId, name])
  @@index([organizationId, supplierId, discountGroup])
  @@index([organizationId, productId])
  @@index([organizationId, gtin])
}

/// Ett artikelregister per företag (2026-10-12): one product of ONE company per common number – the E-nummer
/// (el) or the RSK-nummer (VVS), seven digits. Each supplier's article with that number links here, so the search shows
/// the product once with every supplier's own article number and price side by side. Never merged on names or on
/// another numbering system's digits; never shared between companies; HINTEK owns no supplier data. Removed by the app
/// when no article links to it any more. Migration 20261012170000_catalogue_products_search.
model CatalogueProduct {
  id             String             @id @default(cuid())
  organizationId String
  /// "E" or "RSK".
  numberKind     String
  /// Seven digits.
  number         String
  /// The name of the first article that brought the number; each supplier's own name stays on its article.
  name           String
  unit           String             @default("")
  /// The GTIN and the manufacturer key ("maker:number") the product is also known by (2026-10-14), "" when none.
  gtin           String             @default("")
  mpnKey         String             @default("")
  /// Master data from a wholesaler's catalogue (Solar's API), with its source and time; never a price.
  master         Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles       CatalogueArticle[]

  @@unique([id, organizationId])
  @@unique([organizationId, numberKind, number])
  @@index([organizationId, gtin])
  @@index([organizationId, mpnKey])
}

/// Append-only: an import adds a row when an article is new or its price (amount or per-quantity) changed; a trigger
/// refuses UPDATE (20261009400000_article_catalogue). An unchanged price gets a CataloguePriceConfirmation instead.
model CataloguePrice {
  id             String                       @id @default(cuid())
  organizationId String
  articleId      String
  importId       String
  /// The price as written in the file, SEK excluding VAT, for `perQuantity` units.
  amount         Decimal                      @db.Decimal(14, 4)
  perQuantity    Int                          @default(1)
  /// amount / perQuantity, the price of one unit.
  unitPrice      Decimal                      @db.Decimal(14, 4)
  currency       String                       @default("SEK")
  /// NET = the company's own price, BASE = the wholesaler's base price before the company's discount (2026-10-13 natt).
  priceKind      String                       @default("NET")
  /// The file's own date column when mapped, otherwise the import's date.
  priceDate      DateTime                     @db.Date
  sourceFileName String
  createdAt      DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article        CatalogueArticle             @relation(fields: [articleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  import         CatalogueImport              @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)
  confirmations  CataloguePriceConfirmation[]

  @@unique([id, organizationId])
  @@index([organizationId, articleId, createdAt])
  @@index([importId])
}

/// Re-import (2026-10-08): an import that finds an article's latest price unchanged records that the price was
/// confirmed on the file's date, instead of a new price row. The price date stays when the price was set; the latest
/// confirmation is "bekräftad <datum>" and what the age hint counts from. Removing the import removes its confirmations,
/// so the previous one applies again (20261009700000_price_confirmed).
model CataloguePriceConfirmation {
  id             String          @id @default(cuid())
  organizationId String
  priceId        String
  importId       String
  /// The file's own date column when mapped, otherwise the import's date.
  confirmedDate  DateTime        @db.Date
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  price          CataloguePrice  @relation(fields: [priceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  import         CatalogueImport @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, priceId, createdAt])
  @@index([importId])
}

model CatalogueImport {
  /// Rader i en fil som synkats mot grossistens katalog men inte hittat någon artikel där, eller bara med annan enhet (2026-10-17).
  notInCatalogue  Int                          @default(0)
  id              String                       @id @default(cuid())
  organizationId  String
  supplierId      String
  fileName        String
  /// SHA-256 of the rows read, to recognise the same file again.
  contentHash     String
  createdById     String?
  rowCount        Int                          @default(0)
  newArticles     Int                          @default(0)
  changedPrices   Int                          @default(0)
  unchangedPrices Int                          @default(0)
  failedRows      Int                          @default(0)
  /// Articles of the supplier with a price of this import's kind that the file did not have (2026-10-15): they keep their
  /// latest price and are marked "inte i senaste prisfilen". Counted when the import finishes.
  missingArticles Int                          @default(0)
  /// What the file's prices are: NET (the company's own) or BASE (before the company's discount).
  priceKind       String                       @default("NET")
  /// PRICES = a price list, REBATE = a discount letter (2026-10-14); only the latest finished letter of a supplier applies.
  kind            String                       @default("PRICES")
  createdAt       DateTime                     @default(now())
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        CatalogueSupplier            @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)
  prices          CataloguePrice[]
  confirmations   CataloguePriceConfirmation[]
  rebates         CatalogueRebate[]
  wholesalePrices WholesalePrice[]
  seen            WholesaleImportSeen[]
  filePrices      CatalogueFilePrice[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, contentHash])
  @@index([organizationId, supplierId, kind, createdAt])
}

/// Rabattbrev (2026-10-14, lib/catalogue/rebate.ts): one rule of a supplier's discount letter – a discount per
/// group (with a follow-on discount in the chain), a discount per article or a fixed net price per article. The
/// company's net price is computed from the base price when an article is searched or picked; nothing is stored per article.
model CatalogueRebate {
  id             String            @id @default(cuid())
  organizationId String
  supplierId     String
  importId       String
  /// GROUP, ARTICLE or NET.
  kind           String
  /// GROUP: the group code upper-cased; ARTICLE/NET: the article number's core (lib/catalogue/normalize.ts).
  key            String
  label          String            @default("")
  percent        Decimal           @default(0) @db.Decimal(7, 4)
  percent2       Decimal           @default(0) @db.Decimal(7, 4)
  netPrice       Decimal?          @db.Decimal(14, 4)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       CatalogueSupplier @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)
  import         CatalogueImport   @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([importId, kind, key])
  @@index([organizationId])
}

/// Grossistens katalog (2026-10-14, lib/catalogue/master-data.ts): a wholesaler's catalogue answer per identifier,
/// kept briefly and shared, since it is the wholesaler's product data and not a company's. Never a price.
model ExternalProductCache {
  id             String   @id @default(cuid())
  source         String
  identifierKind String
  identifier     String
  found          Boolean
  data           Json?
  fetchedAt      DateTime @default(now())

  @@unique([source, identifierKind, identifier])
}

/// Solars kategorier (2026-10-15, lib/catalogue/solar-categories.ts): the wholesaler's category tree from Get
/// Categories, fetched by the product owner. Global HINTEK product data – one row per Solar category for every company,
/// never per organization. `id` is Solar's category id (not a product id, not a catalogue id).
model SolarCategory {
  id          Int      @id
  name        String
  displayName String   @default("")
  imageUrl    String   @default("")
  etimClass   String   @default("")
  etimName    String   @default("")
  /// The parent category's id as Solar gives it ("" or "0" at the top).
  parent      String   @default("")
  /// The `countrycode` the names were fetched with.
  countryCode String
  fetchedAt   DateTime

  @@index([parent])
}

/// Gemensamt artikelregister (2026-10-17, docs/proposals/gemensamt-artikelregister-forslag-2026-10-17.md): a
/// wholesaler's catalogue article as HINTEK keeps it for every company's article search – its numbers, words, product type
/// and status. Global HINTEK product data: no organizationId, never a price, never a company's data. Written only by the
/// register sync (lib/catalogue/register-sync.ts); every company reads it, and its own prices join it by the product key.
model WholesaleArticle {
  id                    String           @id @default(cuid())
  /// A running number, never reused (2026-10-17, alternativ C): the companies' price rows and the import bit lists point
  /// at the article with it (4 bytes instead of 25). A gap is harmless; the sync takes a new number only for a new article.
  seq                   Int              @unique @default(autoincrement())
  /// "solar" (Ahlsell, Rexel and Sonepar later as rows with their own code).
  wholesaler            String
  /// The wholesaler's own article number (Solar: SapMaterialNumber), the key of the sync and of the detail lookup.
  articleNo             String
  /// E-nummer (seven digits), GTIN/EAN (14 digits, check digit right), manufacturer and the manufacturer's number; "" when none.
  eNumber               String           @default("")
  gtin                  String           @default("")
  manufacturer          String           @default("")
  manufacturerArticleNo String           @default("")
  /// The manufacturer's number folded to letters and digits, for an exact hit.
  mpnNorm               String           @default("")
  /// The short name (Solar: MaterialName), the short description (MaterialDescription) and the product type (the ETIM class's Swedish name).
  name                  String           @default("")
  description           String           @default("")
  productType           String           @default("")
  etimClass             String           @default("")
  series                String           @default("")
  unit                  String           @default("")
  /// The wholesaler's status as written (Solar: 10 active, 11, 33 going out, 40 obsolete – hidden from the search).
  status                String           @default("")
  /// The product key of lib/catalogue/normalize.ts productKeyOf ("E:…", "GTIN:…", "MPN:…"), "" when none: the same product
  /// at several wholesalers, and the key a company's own article with a price joins on.
  productKey            String           @default("")
  /// One folded text in technical form (lib/catalogue/register-text.ts), written with the row; the trigram index serves it.
  searchText            String           @default("")
  lastChanged           DateTime?
  /// The run that last wrote the row, and – for a row a full import added – that run until it has finished (hidden until then).
  seenRun               String           @default("")
  pendingRun            String?
  updatedAt             DateTime         @default(now()) @updatedAt
  /// Companies' prices on this article: an article with a price is never deleted by the sync (marked 40, obsolete, instead).
  prices                WholesalePrice[]

  @@unique([wholesaler, articleNo])
  @@index([eNumber])
  @@index([gtin])
  @@index([mpnNorm])
  @@index([productKey])
  @@index([wholesaler, seenRun])
}

/// The register sync's state per wholesaler (one row each): the latest successful sync, the run in progress and what the
/// product owner asked for under Produktadministration → Tjänster och nycklar. No company data.
model WholesaleRegisterSync {
  wholesaler        String    @id
  /// The start of the latest successful run; the next changes run asks Solar for what changed since an hour before it.
  syncedFrom        DateTime?
  /// The start of the latest complete full import (the first import and the monthly check).
  lastFullAt        DateTime?
  runId             String?
  runKind           String?
  runStartedAt      DateTime?
  runHeartbeatAt    DateTime?
  /// The running run's counters (pages fetched, articles written), shown as progress under Tjänster och nycklar; empty when no run is alive.
  runPages          Int?
  runWritten        Int?
  /// The product owner asked the running run to stop; the job checks between pages and removes what the run added.
  cancelRequestedAt DateTime?
  /// "full" when the product owner asked for a full import; the scheduled job takes it at its next turn.
  requestedKind     String?
  requestedAt       DateTime?
  requestedBy       String?
  /// The latest finished run: kind, start, end, result, pages, articles written and removed, in plain words.
  lastRun           Json?
  /// The latest runs (at most 20, newest first), the same shape: the import history under Tjänster och nycklar.
  history           Json?
  updatedAt         DateTime  @default(now()) @updatedAt
}

/// A company's price on a wholesaler's catalogue article (2026-10-17, alternativ C in
/// docs/proposals/priser-mot-katalogartikel-2026-10-17.md): the article exists once, in WholesaleArticle; the company stores only its
/// price for it, from its own price file. Append-only like CataloguePrice (a trigger refuses UPDATE): a row is written when the
/// article is new to the company or the price, the discount group or one of the file's extras changed. "Confirmed" and "missing from
/// the latest file" are read from the imports' bit lists (WholesaleImportSeen), not from rows. The supplier is the import's.
/// Own suppliers (no wholesaler) keep CatalogueArticle/CataloguePrice untouched. Migration 20261018100000_wholesale_prices.
model WholesalePrice {
  /// A running number (8 bytes, not a 25-character id): the table has a row per company, article and price – the smaller the row, the less
  /// the catalogue costs (≈ 250 bytes with indexes, 2026-10-17). Nothing points at a price row, so no (id, organizationId) key either.
  id               BigInt           @id @default(autoincrement())
  organizationId   String
  importId         String
  /// WholesaleArticle.seq – restricted: an article with a price is never deleted.
  seq              Int
  /// The price as written in the file, SEK excluding VAT, for `perQuantity` units.
  amount           Decimal          @db.Decimal(14, 4)
  perQuantity      Int              @default(1)
  /// amount / perQuantity, the price of one unit.
  unitPrice        Decimal          @db.Decimal(14, 4)
  currency         String           @default("SEK")
  /// NET = the company's own price, BASE = the wholesaler's base price before the company's discount.
  priceKind        String           @default("NET")
  /// The file's own date column when mapped, otherwise the import's date.
  priceDate        DateTime         @db.Date
  /// What the file says about the article, as CatalogueArticle held it: the discount group and the extras ("" when the file has none).
  discountGroup    String           @default("")
  packageSize      String           @default("")
  orderMultiple    String           @default("")
  minOrderQuantity String           @default("")
  stocked          String           @default("")
  status           String           @default("")
  createdAt        DateTime         @default(now())
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import           CatalogueImport  @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)
  article          WholesaleArticle @relation(fields: [seq], references: [seq], onDelete: Restrict)

  /// seq first: the lookups by article (the restrict check, "has a price", the search) and by company + article both use it.
  @@index([seq, organizationId, createdAt])
  @@index([organizationId])
  @@index([importId])
}

/// Which wholesale articles an import's file had (2026-10-17, alternativ C): a bit list over WholesaleArticle.seq – byte
/// `seq >> 3`, bit `seq & 7` counted from the least significant (the same as Postgres' get_bit on bytea) – written once when the
/// import finishes and never changed (a trigger refuses UPDATE). It replaces one confirmation row per unchanged price: "confirmed
/// on the file's date" is the latest import of the same price kind that had the bit, and "missing from the latest file" is a
/// clear bit. Removing the import removes the list. lib/catalogue/wholesale-model.ts.
model WholesaleImportSeen {
  importId       String          @id
  organizationId String
  seen           Bytes
  /// How many bits are set (the file's matched articles).
  count          Int             @default(0)
  /// The date the file was read for (the import's date): the day every article in the list was confirmed.
  confirmedDate  DateTime        @db.Date
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import         CatalogueImport @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
}

/// A column mapping the company saved for a supplier's files, suggested again when the same headings come back.
/// Prisfil utan grossistens katalog (produktägaren 2026-11-01, lib/catalogue/file-prices.ts): one row of the company's own file for a
/// wholesaler that has no working catalogue in the shared register. Needs no article of any kind and never points at WholesaleArticle:
/// the link is found when the row is read (the wholesaler's number, or the E-nummer with the same unit), so a catalogue switched on
/// later gives no duplicate and no second article row. A row is written once and goes with its file: a new file of the same supplier and
/// price kind replaces the previous one in one transaction. Copies on quotes and material rows never point here for their values.
model CatalogueFilePrice {
  /// A running number, like WholesalePrice: nothing points at a row, and a row is kept small.
  id                    BigInt            @id @default(autoincrement())
  organizationId        String
  supplierId            String
  importId              String
  /// Which wholesaler the row is from (solar/ahlsell/sonepar/rexel), as the supplier was read when the file was imported.
  wholesaler            String
  /// As in the file ("" when the file only has an E-nummer); the key is the article number, otherwise "e:" + E-nummer, as for CatalogueArticle.
  articleNo             String            @default("")
  articleKey            String
  /// articleNo folded to letters and digits (lib/catalogue/normalize.ts), for an exact hit.
  articleNoNorm         String            @default("")
  eNumber               String            @default("")
  rskNumber             String            @default("")
  gtin                  String            @default("")
  manufacturer          String            @default("")
  manufacturerArticleNo String            @default("")
  /// lib/catalogue/normalize.ts productKeyOf ("E:…", "RSK:…", "GTIN:…", "MPN:…"), "" when none: gathers the same product beside other suppliers' rows.
  productKey            String            @default("")
  name                  String
  unit                  String            @default("")
  /// One folded text (name and numbers), written with the row: read by a plain scan of the company's own rows.
  searchText            String            @default("")
  /// The price as written in the file, SEK excluding VAT, for perQuantity units; unitPrice = amount / perQuantity.
  amount                Decimal           @db.Decimal(14, 4)
  perQuantity           Int               @default(1)
  unitPrice             Decimal           @db.Decimal(14, 4)
  currency              String            @default("SEK")
  /// NET or BASE: two layers of one supplier, each replaced by a new file of its own kind.
  priceKind             String            @default("NET")
  priceDate             DateTime          @db.Date
  /// What the file says besides the price, "" when it has none (the discount letter reads discountGroup).
  discountGroup         String            @default("")
  packageSize           String            @default("")
  orderMultiple         String            @default("")
  minOrderQuantity      String            @default("")
  stocked               String            @default("")
  status                String            @default("")
  createdAt             DateTime          @default(now())
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier              CatalogueSupplier @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)
  import                CatalogueImport   @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([importId, articleKey])
  @@index([organizationId, supplierId, priceKind, articleKey], map: "CatalogueFilePrice_org_supplier_kind_key_idx")
  @@index([organizationId, wholesaler, articleNo])
  @@index([organizationId, productKey])
}

model CatalogueImportProfile {
  id             String            @id @default(cuid())
  organizationId String
  supplierId     String
  /// The file's normalised headings, joined.
  fingerprint    String
  /// Field → column heading.
  mapping        Json
  /// How the file is read (prisfiler etapp 1): headings or not, fixed-width positions, price scale, article number as E-nummer.
  format         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       CatalogueSupplier @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, supplierId, fingerprint])
}

/// Personalliggare, steg 1 (2026-10-09, docs/proposals/personalliggare-krav-2026-10-11.md): a person who can be
/// registered in the company's staff registers – a member (userId) or someone who is not (a subcontractor's staff).
/// The identity number is sealed (lib/staff-register/server.ts); the masked form and a keyed hash (to find the same
/// person again) are kept beside it. Changing a person never changes the register: each event keeps its own copy.
model StaffRegisterPerson {
  id             String               @id @default(cuid())
  organizationId String
  /// The member, or null for a person who is not a member.
  userId         String?
  name           String
  idNumberSealed String
  idNumberMasked String
  idNumberHash   String
  /// The employer, as recorded in the register (the company itself for members).
  employerName   String
  employerOrgNo  String
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  /// The latest check-in or check-out; the nightly purge removes a person unused for longer than the retention time.
  lastUsedAt     DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         StaffRegisterEvent[]

  @@unique([id, organizationId])
  @@unique([organizationId, userId])
  @@unique([organizationId, idNumberHash])
  @@index([organizationId, name])
}

enum StaffRegisterEventKind {
  IN
  OUT
  /// Only as a correction: the referenced row was registered by mistake.
  VOID
}

/// The staff register itself: append-only check-in and check-out events per person and project (the building site).
/// A database trigger refuses UPDATE, sets registeredAt to the server's time and refuses DELETE except for the nightly
/// retention purge. A correction is a new row that references the original (correctsId) with a reason.
model StaffRegisterEvent {
  id               String                 @id @default(cuid())
  organizationId   String
  projectId        String
  /// Byggarbetsplatsens id-nummer when the row was registered.
  siteId           String
  personId         String
  personName       String
  idNumberSealed   String
  idNumberMasked   String
  employerName     String
  employerOrgNo    String
  kind             StaffRegisterEventKind
  /// When the work period started or ended.
  occurredAt       DateTime
  /// When the row was registered: always the database server's time (trigger).
  registeredAt     DateTime               @default(now())
  registeredById   String
  registeredByName String
  /// A correction: the original row it replaces. Corrections never reference a correction.
  correctsId       String?
  /// Required for a correction and for a late registration.
  reason           String                 @default("")
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project                @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: NoAction)
  person           StaffRegisterPerson    @relation(fields: [personId, organizationId], references: [id, organizationId], onDelete: NoAction)
  corrects         StaffRegisterEvent?    @relation("StaffRegisterCorrection", fields: [correctsId, organizationId], references: [id, organizationId], onDelete: NoAction)
  corrections      StaffRegisterEvent[]   @relation("StaffRegisterCorrection")

  @@unique([id, organizationId])
  @@index([organizationId, projectId, occurredAt])
  @@index([organizationId, personId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([correctsId])
}

/// Offert (2026-10-09, steg B): DRAFT → SENT → ACCEPTED / DECLINED / EXPIRED.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

/// Who the quote is for (steg C, 2026-10-09): a company or a private person (only a private person may have ROT).
enum QuoteCustomerType {
  COMPANY
  PRIVATE
}

/// Offert per e-post (steg E): the customer's answer through the link.
enum QuoteDecision {
  ACCEPTED
  DECLINED
}

/// A quote line: material, arbete (hours × hourly rate) or övrigt.
enum QuoteLineKind {
  MATERIAL
  LABOUR
  OTHER
}

/// Offert (2026-10-09, steg B, docs/proposals/material-pris-offert-2026-10-09.md): the company's own quote to its
/// customer, a document of its own in the core (never in ee/). Bound to the company; customer, place and project are
/// checked by triggers (same tenant) and cleared if they are purged. A quote that is no longer a draft is locked – the
/// database refuses changes to its lines and contents (migration 20261011300000_quotes) – and a change is made as a new
/// version with the same number. Amounts are SEK excluding VAT; VAT is shown separately at `vatPercent`.
model Quote {
  id                  String            @id @default(cuid())
  organizationId      String
  /// Running number per company (shown as O-0012); every version of a quote has the same number.
  number              Int
  version             Int               @default(1)
  /// Set when a newer version of the same number was made from this one.
  supersededAt        DateTime?
  customerId          String?
  facilityId          String?
  projectId           String?
  title               String
  description         String            @default("")
  status              QuoteStatus       @default(DRAFT)
  /// YYYY-MM-DD or "".
  validUntil          String            @default("")
  /// The company's own terms, written by the company (never a template from a third party).
  terms               String            @default("")
  vatPercent          Decimal           @default(25) @db.Decimal(5, 2)
  /// Steg C + moms/ROT (2026-10-09, migration 20261012104000_quote_ata_vat_rot): the customer type, and for a
  /// private person an optional ROT deduction with the share and cap the company entered (its own figures, copied).
  customerType        QuoteCustomerType @default(COMPANY)
  rotEnabled          Boolean           @default(false)
  rotPercent          Decimal?          @db.Decimal(5, 2)
  rotCap              Decimal?          @db.Decimal(12, 2)
  /// ÄTA: the accepted version this version changes or adds to (null = an ordinary quote or version).
  changeOfVersion     Int?
  /// The latest work order made from this accepted quote; cleared if the work order is deleted.
  workOrderId         String?
  sentAt              DateTime?
  sentById            String?
  /// Kunden som den var när offerten skickades (driftklar-plan 1D, migration 20261012150000_quote_customer_snapshot):
  /// name, contact person and address from quoteCustomerDetails, written when the quote is sent and never changed after.
  /// The PDF and the customer's page read these, so a sent or accepted quote does not follow later edits of the
  /// customer register. Null on a draft and on quotes sent before the snapshot existed (they read the register).
  sentCustomerName    String?
  sentCustomerContact String?
  sentCustomerAddress String?
  decidedAt           DateTime?
  decidedById         String?
  createdById         String?
  updatedById         String?
  /// Optimistic concurrency: a save names the revision it started from.
  revision            Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facility            CustomerFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  project             Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workOrder           WorkflowTask?     @relation("QuoteWorkOrder", fields: [workOrderId, organizationId], references: [id, organizationId], onDelete: SetNull)
  lines               QuoteLine[]
  /// Offert per e-post (steg E): the links sent to the customer and the customer's answer through one of them.
  links               QuoteLink[]
  response            QuoteResponse?

  @@unique([id, organizationId])
  @@unique([organizationId, number, version])
  @@index([organizationId, workOrderId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, projectId])
}

/// One line of a quote: benämning, antal, enhet, à-pris (purchase price or hourly rate, SEK excl. VAT) and markup.
model QuoteLine {
  id             String        @id @default(cuid())
  organizationId String
  quoteId        String
  position       Int
  kind           QuoteLineKind
  name           String
  quantity       Decimal       @db.Decimal(14, 4)
  unit           String        @default("")
  /// Empty while the draft is being written; a quote is sent only when every line has a price.
  unitPrice      Decimal?      @db.Decimal(14, 4)
  markupPercent  Decimal?      @db.Decimal(7, 2)
  /// A copy of the catalogue article the price came from (lib/catalogue/snapshot.ts), never read back for values.
  catalogue      Json?
  /// ROT (2026-10-09): the line is labour cost in the ROT basis (only used on a private customer's quote with ROT).
  rotLabour      Boolean       @default(false)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote         @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, quoteId, position])
}

/// Offert per e-post (steg E, 2026-10-09, migration 20261012112000_quote_customer_link): a link mailed to the
/// customer, who opens the quote without an account and accepts or declines it. Only the sha256 of the random token
/// (32 bytes) is stored; the token itself is only in the e-mail. The link is bound to one quote version and to a
/// fingerprint of what the customer sees (lib/quotes/customer-link.ts); a newer version, changed contents, a newer link
/// or a passed valid-until date makes it unusable.
model QuoteLink {
  id               String         @id @default(cuid())
  organizationId   String
  quoteId          String
  tokenHash        String         @unique
  quoteVersion     Int
  contentHash      String
  /// How the customer confirms: "simple" (name + tick box) now; later e.g. "bankid", "esign", "sms" (lib/quotes/acceptance.ts).
  acceptanceMethod String         @default("simple")
  email            String
  /// ÅÅÅÅ-MM-DD: the quote's valid-until date when sent; the link can be answered through that day.
  validUntil       String
  sentById         String?
  sentAt           DateTime       @default(now())
  openedAt         DateTime?
  /// A newer link to the same quote was sent, or the e-mail could not be sent.
  revokedAt        DateTime?
  /// The customer answered through this link (once).
  usedAt           DateTime?
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote            Quote          @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  response         QuoteResponse?

  @@unique([id, organizationId])
  @@index([organizationId, quoteId])
}

/// The customer's answer to a quote through a link: one per quote (version) and per link, never changed (a trigger
/// refuses UPDATE). Kept as the evidence of the agreement: decision, method, the name typed, the statement ticked,
/// time, IP address and browser, and the version and content fingerprint that were answered.
model QuoteResponse {
  id               String        @id @default(cuid())
  organizationId   String
  quoteId          String        @unique
  linkId           String        @unique
  decision         QuoteDecision
  acceptanceMethod String
  signerName       String        @default("")
  reason           String        @default("")
  /// What the method proved: the statement ticked ({ statement }) now, later e.g. a signing service's reference.
  evidence         Json          @default("{}")
  quoteVersion     Int
  contentHash      String
  ipAddress        String        @default("")
  userAgent        String        @default("")
  createdAt        DateTime      @default(now())
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote            Quote         @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Cascade)
  link             QuoteLink     @relation(fields: [linkId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([quoteId, organizationId])
  @@unique([linkId, organizationId])
  @@index([organizationId, createdAt])
}

/// Radering efter avslut (2026-10-10, villkoren punkt 11): a company whose Cloud agreement has ended (billing says
/// ENDED, lib/extensions CloudAgreementState) counts down here. The owners and admins are told at once (bell and e-mail),
/// again 7 days and 1 day before the date; from `exportUntil` (or `postponedUntil` when later) the nightly job
/// `companies:closure` erases the company with lib/auth/erasure.ts eraseCompany – only while
/// SystemSettings.autoEraseEndedCompanies is on. A valid agreement again removes the row (the countdown is cancelled).
/// No foreign key: the row goes with the company's other rows when it is erased (eraseCompany), like NoticeDelivery.
model CompanyClosure {
  id             String    @id @default(cuid())
  organizationId String    @unique
  /// When the agreement ended, as billing reported it the first time the job saw it.
  endedAt        DateTime
  /// End of the export time: 30 days after the first notice (never shorter, even when the job saw the end late).
  exportUntil    DateTime
  /// Postponed by the superadmin (Skjut upp, with a reason in the administration history); null = not postponed.
  postponedUntil DateTime?
  postponeReason String    @default("")
  /// The notices sent, each once: "DAY_0", and "REMINDER_7|<date>" / "REMINDER_1|<date>" per erasure date.
  noticesSent    String[]  @default([])
  firstNoticeAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([exportUntil])
}

/// Fakturaunderlag från utfört arbete (2026-10-10, kartläggningen 5.6, migration 20261012140000_invoice_basis):
/// on a finished job or a project, reported time × the company's hourly rate + material rows (à-pris + påslag) +
/// expense rows, as an editable list exported like a quote (CSV/SIE/Fortnox). Exactly one of taskId and projectId.
enum CustomerInvoiceKind {
  INVOICE
  CREDIT
}

/// Fakturor (owner 2026-11-04, docs/beslut/faktura.md): the company's setting and number series. On for everyone (2026-11-05); no row: on, enabled=false: the company turned it off.
/// The server reads and writes it with parameterised SQL.
model CustomerInvoiceSeries {
  organizationId String       @id
  enabled        Boolean      @default(true)
  nextNumber     Int          @default(1)
  prefix         String       @default("")
  paymentDays    Int?
  lateTerms      String       @default("")
  iban           String       @default("")
  bic            String       @default("")
  useOcr         Boolean      @default(false)
  vatExempt      Boolean      @default(false)
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// An issued invoice or credit invoice: locked by a trigger except the payment mark and the sealing of the identity number.
/// `content` is the document's snapshot and never holds the identity number, which is only in `identitySealed`.
/// One invoice per basis is a partial unique index in the migration.
model CustomerInvoice {
  id                 String                 @id @default(cuid())
  organizationId     String
  number             Int
  label              String
  kind               CustomerInvoiceKind    @default(INVOICE)
  basisId            String?
  creditOfId         String?
  customerId         String?
  issuedOn           String
  dueOn              String?
  title              String
  buyerName          String                 @default("")
  content            Json
  toPay              Decimal                @db.Decimal(14, 2)
  identitySealed     String?
  identityMasked     String                 @default("")
  createdById        String?
  createdByName      String                 @default("")
  createdAt          DateTime               @default(now())
  paidOn             String?
  correctedByBasisId String?
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer?              @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Cascade)
  basis              InvoiceBasis?          @relation(fields: [basisId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Cascade)
  creditOf           CustomerInvoice?       @relation("InvoiceCredit", fields: [creditOfId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  credits            CustomerInvoice[]      @relation("InvoiceCredit")
  events             CustomerInvoiceEvent[]
  links              CustomerInvoiceLink[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@unique([organizationId, creditOfId])
  @@index([organizationId, basisId])
  @@index([organizationId, dueOn])
}

/// The secure page for an invoice with a personal number: only the token's sha256 is stored.
model CustomerInvoiceLink {
  id             String          @id @default(cuid())
  organizationId String
  invoiceId      String
  tokenHash      String          @unique
  email          String
  validUntil     String
  sentById       String?
  sentAt         DateTime        @default(now())
  openedAt       DateTime?
  revokedAt      DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        CustomerInvoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, invoiceId])
}

/// The log on an invoice: sent (date and recipient), marked paid, the mark undone. Never an identity number.
model CustomerInvoiceEvent {
  id             String          @id @default(cuid())
  organizationId String
  invoiceId      String
  action         String
  detail         String          @default("")
  actorId        String?
  actorName      String          @default("")
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        CustomerInvoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, invoiceId, createdAt])
}

enum InvoiceBasisStatus {
  /// Being checked and edited; deleting it releases everything it took.
  DRAFT
  /// Marked as invoiced (who and when): locked, and what it took can never be invoiced again.
  INVOICED
}

model InvoiceBasis {
  id               String               @id @default(cuid())
  organizationId   String
  /// Running number per company (shown as F-0001).
  number           Int
  taskId           String?
  projectId        String?
  /// The customer as it was when the basis was made (the job's or project's).
  customerId       String?
  /// Plats (Lika är rätt, 2026-11-14): the customer's place the invoice is about, optional; from the job when made on one.
  facilityId       String?
  title            String
  status           InvoiceBasisStatus   @default(DRAFT)
  vatPercent       Decimal              @default(25) @db.Decimal(5, 2)
  /// The editable list: [{ id, kind MATERIAL|LABOUR|OTHER, name, quantity, unit, unitPrice, markupPercent, sources[] }],
  /// validated by lib/invoice-basis (the same line numbers as a quote line).
  lines            Json                 @default("[]")
  note             String               @default("")
  invoicedAt       DateTime?
  invoicedById     String?
  invoicedByName   String               @default("")
  createdById      String?
  updatedById      String?
  /// Optimistic concurrency: a save names the revision it started from.
  revision         Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task             WorkflowTask?        @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Cascade)
  project          Project?             @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Cascade)
  customer         Customer?            @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Cascade)
  facility         CustomerFacility?    @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Cascade)
  sources          InvoiceBasisSource[]
  customerInvoices CustomerInvoice[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@index([organizationId, taskId])
  @@index([organizationId, projectId])
  @@index([organizationId, status, updatedAt])
}

/// What a basis has taken: a reported time entry ("time:<entryId>") or a material/expense row of a work order
/// ("row:<taskId>:<rowId>"). The unique key is what keeps anything from being invoiced twice: a second basis can never
/// take the same source, whether the first is a draft or invoiced.
model InvoiceBasisSource {
  id             String       @id @default(cuid())
  organizationId String
  basisId        String
  sourceKey      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  basis          InvoiceBasis @relation(fields: [basisId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, sourceKey])
  @@index([organizationId, basisId])
}

/// Inköp (2026-10-16, docs/proposals/inkop-och-artiklar-2026-10-16.md): the company's list of articles from one or
/// more suppliers – an underlag while it is a draft, an order once it is marked ordered. Only purchase prices; the selling
/// price belongs to the quote. Cloud only; every query is bound to the company.
enum PurchaseStatus {
  DRAFT
  ORDERED
  DELIVERED
  CANCELLED
}

model Purchase {
  id             String         @id @default(cuid())
  organizationId String
  /// Running number per company (shown as I-0007).
  number         Int
  title          String
  notes          String         @default("")
  status         PurchaseStatus @default(DRAFT)
  projectId      String?
  customerId     String?
  workOrderId    String?
  orderedAt      DateTime?
  orderedById    String?
  deliveredAt    DateTime?
  createdById    String?
  updatedById    String?
  /// Optimistic concurrency, and what a quote line linked to the purchase compares with ("Uppdatera offerten").
  revision       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  workOrder      WorkflowTask?  @relation("PurchaseWorkOrder", fields: [workOrderId], references: [id], onDelete: SetNull)
  lines          PurchaseLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@index([organizationId, updatedAt])
  @@index([organizationId, status])
  @@index([organizationId, createdById])
  @@index([organizationId, projectId])
  @@index([organizationId, workOrderId])
}

/// One article of a purchase: benämning, antal, enhet and inköpspris, with the price copy of the picked article (the same
/// JSON as a quote line's `catalogue`, lib/quotes/model.ts lineCatalogueJson) and the supplier for grouping.
model PurchaseLine {
  id             String       @id @default(cuid())
  organizationId String
  purchaseId     String
  position       Int
  name           String
  quantity       Decimal      @db.Decimal(14, 4)
  unit           String       @default("")
  unitPrice      Decimal?     @db.Decimal(14, 4)
  supplierName   String       @default("")
  catalogue      Json?
  deliveredAt    DateTime?
  deliveredById  String?
  /// The document a line was picked on ("quote"/"work_order" and its id), so that document's later changes follow it.
  sourceKind     String?
  sourceId       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase       Purchase     @relation(fields: [purchaseId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, purchaseId, position])
  @@index([organizationId, sourceKind, sourceId])
}

/// Favoriter och artikellistor (2026-10-16, docs/artikellistor.md). A favourite is one person's mark on an article
/// of the company's register (or of Solar's catalogue), within one company. It points at the product by its key
/// ("E:1234567", "RSK:…", "GTIN:…", "MPN:…") or at a supplier's own article ("A:<articleId>"), never by a foreign key, so
/// it survives a new price file (and a product that is made again) and always shows today's price from the register.
model CatalogueFavorite {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  /// lib/catalogue/lists.ts ArticleRefKey.
  refKey         String
  /// What the article was called when it was marked (name, unit, numbers, product facts), shown when it is no longer in
  /// the register; never a price.
  snapshot       Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, refKey])
  @@index([organizationId, userId, createdAt])
}

/// A company's article list ("Standard elcentral", "Laddbox-montage"): everyone who may pick articles sees and uses it;
/// the one who made it and an admin change it. Lines point at articles the way favourites do, or are free text.
model CatalogueList {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  description    String              @default("")
  createdById    String?
  updatedById    String?
  /// Optimistic concurrency for a change of the whole list.
  revision       Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          CatalogueListLine[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
}

/// One line of an article list: an article (refKey, as a favourite) or free text (refKey null), with its quantity.
model CatalogueListLine {
  id             String        @id @default(cuid())
  organizationId String
  listId         String
  position       Int
  /// null = a free-text line without an article.
  refKey         String?
  name           String
  unit           String        @default("")
  quantity       Decimal       @db.Decimal(14, 4)
  /// As the favourite's snapshot; null for a free-text line.
  snapshot       Json?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  list           CatalogueList @relation(fields: [listId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, listId, position])
}

// Maskinintag (steg S2, docs/drift/MASKININTAG.md): en maskin, en gateway eller ett lokalt analysprogram skickar larm,
// driftlägen och färdiga diagnoser till Workflow med en egen nyckel. Nyckeln hör till exakt EN källa och därmed ett
// företag; den är ingen medlem och ingen IntegrationKey (ingen enumändring, ingen "agerar som"), så den kan bara skicka
// händelser och aldrig läsa eller utföra något annat.
/// En källa som får skicka händelser. Nyckeln visas en gång, lagras bara som SHA-256-hash och kan spärras eller bytas.
model MachineSource {
  id              String                @id @default(cuid())
  organizationId  String
  name            String
  /// Hash av nyckelns hemliga del; null när nyckeln är spärrad och ingen ny gjorts.
  secretHash      String?
  displayHint     String
  keyExpiresAt    DateTime?
  keyRevokedAt    DateTime?
  keyIssuedAt     DateTime              @default(now())
  /// Senast nyckeln godkändes (skrivs högst en gång i minuten) och senast en händelse sparades ("senast hörd").
  lastUsedAt      DateTime?
  lastEventAt     DateTime?
  isActive        Boolean               @default(true)
  /// Larm blir arbetsorder (S3): off | direct (märkt arbetsorder direkt) | approval (väntar på att en administratör godkänner).
  /// En ny källa står på off (2026-11-02, ersätter direct från 2026-10-19); en befintlig behåller sitt val.
  alarmMode       String                @default("off")
  /// Minuter efter ett larmförslag innan nästa får göras för samma källa.
  cooldownMinutes Int                   @default(30)
  /// Analys (0.19.0): trösklar som justeras efter administratörens svar ({flutter, denser, silent} som tal 1-3) och senast analyserad.
  analysisTuning  Json?
  lastAnalysedAt  DateTime?
  /// Integrationsmotorn E2 (2026-10-24): hur många nya signaler som inte sparades för att taket (200 per källa, 2 000 per
  /// företag) var nått. Räknas upp, visas på källans signalsida.
  ignoredSignals  Int                   @default(0)
  /// Integrationsmotorn E4 (2026-10-24): formatprofilen som /api/ingest/v1/raw tolkar källans egen JSON med (null = inget
  /// rådata-intag). Sammansatt FK, så profilen alltid är källans företags; en profil som används kan inte tas bort.
  profileId       String?
  profile         MachineFormatProfile? @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: NoAction)
  /// "Fånga prov" till och med (24 timmar från när det slogs på); null = av.
  captureUntil    DateTime?
  /// Integrationsmotorn E1 (2026-10-24): källans standardobjekt i platsträdet (kundens eller Eget företag). Enkel FK med
  /// SET NULL och triggern MachineSource_facility_tenant (samma företag), som WorkflowTask.facilityId.
  facilityId      String?
  facility        CustomerFacility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  /// Underhåll (2026-10-30): källans standarddel i maskinträdet; ersätter facilityId (platsträdets objekt), som inte
  /// längre skrivs. Enkel FK med SET NULL och triggern MachineSource_machine_part_tenant.
  machinePartId   String?
  machinePart     MachinePart?          @relation(fields: [machinePartId], references: [id], onDelete: SetNull)
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events          MachineEvent[]
  alarmOrders     MachineAlarmOrder[]
  suggestions     MachineSuggestion[]
  signals         MachineSignal[]
  rawSamples      MachineRawSample[]
  rawDedupes      MachineRawDedupe[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@index([profileId])
  @@index([facilityId])
  @@index([machinePartId])
}

/// En mottagen händelse. `eventId` är källans eget och unikt per källa, så en omsänd batch aldrig blir en andra rad.
/// Texten kommer från kunden och visas som text, aldrig som markup.
model MachineEvent {
  id             String            @id @default(cuid())
  organizationId String
  sourceId       String
  eventId        String
  occurredAt     DateTime
  receivedAt     DateTime          @default(now())
  /// alarm | state | diagnosis
  type           String
  code           String
  /// info | warning | fault | critical
  severity       String
  /// raised | cleared (larm), running | stopped (driftläge); annars null.
  state          String?
  text           String            @default("")
  /// Valfri kort grund för en diagnos.
  basis          String?
  /// Små I/O-värden som följde med (högst 20 namn till tal, sant/falskt eller kort text); null när inga skickades.
  values         Json?
  /// Objektet som gällde när händelsen togs emot (E1): en senare ommappning eller ett maskinbyte flyttar inte gammal historik.
  facilityId     String?
  facility       CustomerFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  /// Underhåll (2026-10-30): maskindelen som gällde när händelsen togs emot (ersätter facilityId för nya händelser).
  machinePartId  String?
  machinePart    MachinePart?      @relation(fields: [machinePartId], references: [id], onDelete: SetNull)
  /// Händelsens kodsignal (`code:<kod>`, E2) när den togs emot. Enkel FK med SET NULL och triggern MachineEvent_signal_tenant
  /// (samma företag och samma källa).
  signalId       String?
  signal         MachineSignal?    @relation(fields: [signalId], references: [id], onDelete: SetNull)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         MachineSource     @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([sourceId, eventId])
  @@index([signalId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([sourceId, occurredAt])
  @@index([facilityId, occurredAt])
  @@index([machinePartId, occurredAt])
}

/// Larm blir arbetsorder (S3): ett larm som blev (eller väntar på att bli) en märkt arbetsorder. Högst EN öppen rad
/// (pending eller created) per företag och `scopeKey` (objektet, annars källan; integrationsmotorn E1), säkrat av ett
/// partiellt unikt index i migreringen. Ordern skapas av systemet ("system:machine-alarm"), planeras bara och stängs
/// aldrig automatiskt.
model MachineAlarmOrder {
  id               String            @id @default(cuid())
  organizationId   String
  sourceId         String
  /// MachineEvent.id som utlöste raden (raden överlever gallring av händelsen).
  eventRef         String
  code             String
  severity         String
  text             String            @default("")
  /// pending (väntar på godkännande) | created (arbetsorder finns) | dismissed (avvisad) | closed (ordern klar eller utgången)
  status           String
  taskId           String?
  createdAt        DateTime          @default(now())
  decidedAt        DateTime?
  decidedById      String?
  /// Spärr, vila och notis gäller per scope (E1): `facility:<id>` (objektet), `signal:<id>` (E2) eller `source:<id>`.
  scopeKey         String
  /// Objektet ordern gäller (null när källan inte har något); orderns kund hämtas från objektet.
  facilityId       String?
  facility         CustomerFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  /// Underhåll (2026-10-30): maskindelen ordern gäller (scope `part:<id>`); ordern får en underhållspost på delen.
  machinePartId    String?
  machinePart      MachinePart?      @relation(fields: [machinePartId], references: [id], onDelete: SetNull)
  /// Integrationsmotorn E6: senaste steget i eskaleringen som fått larmet (0 = första) och när; vem som kvitterade och när
  /// (Jag tar den, eller när jobbet ser att någon blivit ansvarig för ordern).
  escalationStep   Int               @default(0)
  escalatedAt      DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source           MachineSource     @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, acknowledgedAt])
  @@index([sourceId, createdAt])
  @@index([organizationId, scopeKey, createdAt])
  @@index([facilityId])
  @@index([machinePartId])
}

/// Analysförslag (0.19.0): reglerna jämför en källas händelser med dess egen historik och föreslår, till exempel att ett larm
/// fladdrar, blivit tätare eller att maskinen tystnat. Förslaget visar sitt underlag, kan avvisas och ändrar aldrig något
/// i sig. (sourceId, dedupeKey) är unikt, så samma observation ger aldrig två rader.
model MachineSuggestion {
  id             String        @id @default(cuid())
  organizationId String
  sourceId       String
  /// flutter | denser | silent
  kind           String
  dedupeKey      String
  title          String
  basis          String
  stats          Json
  /// open | dismissed | acknowledged
  status         String        @default("open")
  /// AI:ns förklaring när administratören bett om den och företaget tillåtit det; annars null.
  explanation    String?
  createdAt      DateTime      @default(now())
  decidedAt      DateTime?
  decidedById    String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         MachineSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Vad observationen gäller (E2): `facility:<id>`, `signal:<id>` eller `source:<id>`, som MachineAlarmOrder.scopeKey.
  scopeKey       String

  @@unique([sourceId, scopeKey, dedupeKey])
  @@index([organizationId, status, createdAt])
}

/// Signalkatalogen (integrationsmotorn E2, 2026-10-24 beslut 4): varje värdenamn och varje kod (`code:<kod>`) som en
/// källa skickat, upptäckt av sig själv. En upptäckt signal (`discovered`) påverkar ingenting förrän en administratör
/// aktiverar den (`active`) eller kopplar den till ett objekt; `ignored` gör att den inte räknas (en ignorerad larmkod ger
/// ingen order). Högst 200 per källa och 2 000 per företag. Bara senaste värdet sparas, inga tidsserier (svar 2).
model MachineSignal {
  id             String              @id @default(cuid())
  organizationId String
  sourceId       String
  /// Värdets namn (som i `values`) eller `code:<kod>`.
  key            String
  /// number | boolean | text | code
  kind           String
  /// discovered | active | ignored
  status         String              @default("discovered")
  name           String              @default("")
  unit           String              @default("")
  /// Signalens eget objekt (enkel FK med SET NULL och triggern MachineSignal_facility_tenant); annars gäller källans.
  facilityId     String?
  /// Underhåll (2026-10-30): signalens egen maskindel (enkel FK med SET NULL och triggern MachineSignal_machine_part_tenant);
  /// annars gäller källans. Ersätter facilityId, som inte längre skrivs.
  machinePartId  String?
  /// Dödband för tal: ett nytt värde inom bandet skrivs inte förrän minuten gått (null = varje ändring).
  deadband       Float?
  /// Drifttimmar från PLC (2026-11-02): signalens värde matar drifttimmarna på signalens egen maskindel
  /// (lib/machine/run-hours.ts). Bara en aktiv talsignal med egen del; högst en signal per del.
  runHoursFeed   Boolean             @default(false)
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  /// Senaste värdet (tal, sant/falskt eller kort text; för en kod dess läge) och när det gällde.
  lastValue      Json?
  lastValueAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         MachineSource       @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  facility       CustomerFacility?   @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  machinePart    MachinePart?        @relation(fields: [machinePartId], references: [id], onDelete: SetNull)
  events         MachineEvent[]
  rules          MachineSignalRule[]

  @@unique([sourceId, key])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([facilityId])
  @@index([machinePartId])
}

/// Formatprofil (integrationsmotorn E4, beslut 3): hur en enhets egen JSON läses – var posterna, tiden, id:t och värdena
/// finns. Data, inte kod: en stängd struktur som valideras (lib/machine/raw-profile.ts), inga uttryck och inga
/// kundskrivna reguljära uttryck. Inga tillverkarnamn i HINTEK:s exempel.
model MachineFormatProfile {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  /// Ökar vid varje ändring.
  version        Int             @default(1)
  /// Den validerade definitionen ({ profileVersion: 1, records?, time?, id?, signals, discover? }).
  definition     Json
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources        MachineSource[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
}

/// "Fånga prov" (E4): högst 20 råa kroppar per källa (högst 64 kB), raderas efter 24 timmar. Kunddata: bara administratören
/// ser dem, och de skickas aldrig till AI.
model MachineRawSample {
  id             String        @id @default(cuid())
  organizationId String
  sourceId       String
  receivedAt     DateTime      @default(now())
  body           String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         MachineSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([sourceId, receivedAt])
  @@index([receivedAt])
}

/// Idempotens fall c (E4): en kropp utan tid i 10 minuter, som hash, så att en omsändning inte blir en ny mätning.
model MachineRawDedupe {
  organizationId String
  sourceId       String
  hash           String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         MachineSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([sourceId, hash])
  @@index([createdAt])
}

/// Regler i data (integrationsmotorn E3, beslut 1 och 6): ett villkor på en signal ger en kanonisk händelse (larm, driftläge
/// eller diagnos) som går genom samma kedja som /events – larmbeslut, arbetsorder eller förslag, notis, analys. En fast lista
/// av jämförelser, inga uttryck. Högst 50 per källa. Ändras bara efter bekräftelse inom 15 minuter (2026-10-24).
model MachineSignalRule {
  id              String            @id @default(cuid())
  organizationId  String
  signalId        String
  /// eq | neq | gt | gte | lt | lte | changed | stale
  operator        String
  /// Jämförelsevärdet (tal, sant/falskt eller text); för stale antal sekunder utan nytt värde; null för changed.
  value           Json?
  /// För gt/gte/lt/lte: hur långt tillbaka värdet måste gå innan regeln släcks (inget fladder vid brus).
  hysteresis      Float?
  /// Hur länge villkoret ska gälla i följd innan regeln slår till (sekunder, 0 = direkt).
  forSeconds      Int               @default(0)
  /// Utfallet: alarm | state | diagnosis, med kod, nivå (info/warning/fault/critical), läge för state (running/stopped) och text.
  outcomeType     String
  outcomeCode     String
  outcomeSeverity String
  outcomeState    String?
  outcomeText     String            @default("")
  isActive        Boolean           @default(true)
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signal          MachineSignal     @relation(fields: [signalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  state           MachineRuleState?

  @@unique([id, organizationId])
  @@index([signalId])
  @@index([organizationId, isActive])
}

/// Regelns nuvarande läge (E3): aktiv sedan, villkoret sant sedan (för varaktighet), senaste värde och senast prövad, så att
/// hysteres, varaktighet och "ändrad" fungerar mellan anropen och ett äldre värde aldrig prövas efter ett nyare.
model MachineRuleState {
  ruleId       String            @id
  active       Boolean           @default(false)
  activeSince  DateTime?
  pendingSince DateTime?
  lastValue    Json?
  evaluatedAt  DateTime?
  rule         MachineSignalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

/// Integrationsmotorn E6 (beslut 2026-10-18: "Ansvarig och ersättare per objekt får larm med kvittens och eskalering"): vem
/// som får ett maskinlarm först för ett objekt. En rad per objekt och roll. Sammansatta FK till objektet och till personens
/// medlemskap i samma företag, så att databasen själv nekar en person eller ett objekt i ett annat företag; raden går när
/// objektet eller medlemskapet tas bort.
model MachineAlarmContact {
  id             String             @id @default(cuid())
  organizationId String
  /// Före 2026-10-30 platsträdets objekt; nya rader har maskindelen i stället (CHECK: exakt en av dem).
  facilityId     String?
  /// Underhåll (2026-10-30): maskindelen personen har larmansvar för.
  machinePartId  String?
  /// responsible (ansvarig) | deputy (ersättare)
  role           String
  userId         String
  createdById    String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       CustomerFacility?  @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Cascade)
  machinePart    MachinePart?       @relation(fields: [machinePartId, organizationId], references: [id, organizationId], onDelete: Cascade)
  member         OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([facilityId, role])
  @@unique([machinePartId, role])
  @@index([organizationId, userId])
}

/// Integrationsmotorn E6 (beslut 2026-10-18 punkt 6: rådata 90 dagar, sammanfattning 24 månader): ett objekts dygn i siffror,
/// räknat ur händelserna varje natt innan de gallras. Underlaget för nyckeltalen när perioden är längre än händelserna finns.
model MachineDaySummary {
  id             String            @id @default(cuid())
  organizationId String
  /// Före 2026-10-30 platsträdets objekt; nya rader har maskindelen i stället (CHECK: exakt en av dem).
  facilityId     String?
  /// Underhåll (2026-10-30): maskindelens dygn.
  machinePartId  String?
  /// Svensk kalenderdag YYYY-MM-DD.
  day            String
  /// Händelser, utlösta larm, utlösta larm med nivån Fel eller Kritiskt, stopp (övergångar till Stoppad) och minuter stoppad.
  events         Int               @default(0)
  alarms         Int               @default(0)
  faults         Int               @default(0)
  stops          Int               @default(0)
  stoppedMinutes Int               @default(0)
  /// Driftläget när dygnet slutade (running | stopped | null), så att nästa dygn börjar rätt.
  endState       String?
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       CustomerFacility? @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Cascade)
  machinePart    MachinePart?      @relation(fields: [machinePartId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([facilityId, day])
  @@unique([machinePartId, day])
  @@index([organizationId, day])
}

// ---------- Underhåll (2026-10-30) ----------
// Ett eget träd av maskiner och delar (aldrig kundens platsträd), ett gemensamt förråd med saldo per förrådsplats och
// underhållsposter som gäller en maskindel och hålls av en arbetsorder. Cloud-funktion (lib/maintenance/). Allt är bundet
// till företaget: sammansatta FK där raden alltid har en förälder, annars enkla FK med SET NULL och samma-företag-triggrar
// (migreringen 20261031090000_maintenance_module).

/// En nod i maskinträdet: en rot (t.ex. Fabriken), en linje, en maskin eller en del. Roten ägs av företaget självt (customerId
/// null, "Eget") eller av en kund (bara som ägare, CHECK: bara en rot har kund). En del med något under sig, med poster eller
/// med uttag tas inte bort, den pausas.
model MachinePart {
  id                   String                @id @default(cuid())
  organizationId       String
  parentId             String?
  customerId           String?
  name                 String
  /// Platsen i underhållets platsträd (bara en rot, en maskin, CHECK). Null = Utan plats.
  placeId              String?
  /// Fri text: Pump, Motor, Transportband …
  partType             String                @default("")
  /// Märkning på plats, t.ex. P4-HP1.
  marking              String                @default("")
  /// IN_SERVICE | SERVICE_SOON | OUT_OF_SERVICE | DECOMMISSIONED (CHECK)
  status               String                @default("IN_SERVICE")
  notes                String                @default("")
  /// Drifttimmar och när de senast angavs, från en person eller en signal (MachineSignal.runHoursFeed, 2026-11-02).
  runHours             Float?
  runHoursAt           DateTime?
  /// Var värdet kom ifrån: person | machine (null: ett äldre värde, från en person).
  runHoursOrigin       String?
  /// Ett maskinvärde som inte används (lägre än delens, eller ett hopp större än tiden tillåter) och varför: lower | jump.
  /// Sänker aldrig delens timmar; visas på delen tills ett värde går att använda eller en person bestämmer.
  runHoursHeld         Float?
  runHoursHeldAt       DateTime?
  runHoursHeldReason   String?
  position             Int                   @default(0)
  isActive             Boolean               @default(true)
  version              Int                   @default(1)
  createdById          String
  updatedById          String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent               MachinePart?          @relation("MachinePartTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  children             MachinePart[]         @relation("MachinePartTree")
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  place                MaintenancePlace?     @relation(fields: [placeId, organizationId], references: [id, organizationId], onDelete: NoAction)
  images               MachinePartImage[]
  spareParts           MachinePartArticle[]
  maintenanceItems     MaintenanceItem[]
  maintenancePlans     MaintenancePlan[]
  workOrders           WorkflowTask[]
  storeTransactions    StoreTransaction[]
  machineSources       MachineSource[]
  machineSignals       MachineSignal[]
  machineEvents        MachineEvent[]
  machineAlarmOrders   MachineAlarmOrder[]
  machineAlarmContacts MachineAlarmContact[]
  machineDaySummaries  MachineDaySummary[]

  @@unique([id, organizationId])
  @@index([organizationId, parentId])
  @@index([organizationId, customerId])
  @@index([organizationId, placeId])
}

/// Underhållets platsträd (2026-10-31): Ort › Anläggning › Område › Avdelning, bara de nivåer företaget behöver.
/// Eget träd, skilt från kundregistret. level: CITY | SITE | AREA | DEPARTMENT (CHECK), alltid djupare än föräldern
/// (lib/maintenance/place-model.ts). Maskinerna (MachinePart med placeId) står på platserna.
model MaintenancePlace {
  id             String             @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  level          String             @default("SITE")
  notes          String             @default("")
  version        Int                @default(1)
  createdById    String
  updatedById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         MaintenancePlace?  @relation("MaintenancePlaceTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  children       MaintenancePlace[] @relation("MaintenancePlaceTree")
  machines       MachinePart[]

  @@unique([id, organizationId])
  @@unique([organizationId, parentId, name])
  @@index([organizationId, parentId])
}

/// En bild på en maskindel (företagets egen, aldrig tillverkarens material). Högst en huvudbild per del (partiellt unikt index).
model MachinePartImage {
  id             String       @id @default(cuid())
  organizationId String
  partId         String
  isMain         Boolean      @default(false)
  filename       String
  storagePath    String       @unique
  mimeType       String
  size           Int
  createdById    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part           MachinePart  @relation(fields: [partId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, partId])
}

/// En reservdel kopplad till en maskindel: en artikel i förrådet, med hur många som brukar gå åt.
model MachinePartArticle {
  id             String       @id @default(cuid())
  organizationId String
  partId         String
  itemId         String
  quantity       Decimal      @default(1) @db.Decimal(14, 4)
  createdById    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part           MachinePart  @relation(fields: [partId, organizationId], references: [id, organizationId], onDelete: Cascade)
  item           StoreItem    @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([partId, itemId])
  @@index([organizationId, itemId])
}

/// En förrådsplats: ett förråd eller en servicebil (kind STORE | VEHICLE) överst, och under den skåp, hyllor och hyllplatser
/// (parentId, valfritt djup, 2026-10-31). name är hela vägen ("Fabriken › Skåp 1 › Hylla 2") och unik per företag, så
/// två syskon aldrig heter likadant och alla loggar och arbetsordrar säger var det låg; label är platsens eget namn (tomt på
/// äldre rader = name). seriesStart: förrådets egen nummerserie, bara högst upp (CHECK).
model StoreLocation {
  id             String             @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  label          String             @default("")
  kind           String             @default("STORE")
  seriesStart    Int?
  isActive       Boolean            @default(true)
  position       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         StoreLocation?     @relation("StoreLocationTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  children       StoreLocation[]    @relation("StoreLocationTree")
  homeItems      StoreItem[]
  balances       StoreBalance[]
  transactions   StoreTransaction[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@unique([organizationId, seriesStart])
  @@index([organizationId, parentId])
}

/// En artikel i förrådet. Pekar på artikelregistret när den valts därifrån (articleRef = sökträffens id; articleId när det är
/// en egen registerartikel, enkel FK med SET NULL och triggern StoreItem_article_tenant), med namn, enhet och nummer kopierade
/// så att saldot och loggen överlever en ny prisfil. minQuantity: under den visas Lågt och Beställ. ownNumber är förrådets eget
/// nummer ur homeStore-förrådets serie (2026-10-31); articleNo och supplierName är raden "Beställs som" och blandas
/// aldrig med det. shelfText: hyllan som text för den som stannar vid Förråd. unitPrice: priset för en egen artikel utan register.
model StoreItem {
  id             String               @id @default(cuid())
  organizationId String
  articleRef     String?
  articleId      String?
  name           String
  unit           String               @default("st")
  articleNo      String               @default("")
  supplierName   String               @default("")
  ownNumber      Int?
  homeStoreId    String?
  shelfText      String               @default("")
  unitPrice      Decimal?             @db.Decimal(14, 4)
  minQuantity    Decimal?             @db.Decimal(14, 4)
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article        CatalogueArticle?    @relation(fields: [articleId], references: [id], onDelete: SetNull)
  homeStore      StoreLocation?       @relation(fields: [homeStoreId, organizationId], references: [id, organizationId], onDelete: NoAction)
  balances       StoreBalance[]
  transactions   StoreTransaction[]
  parts          MachinePartArticle[]

  @@unique([id, organizationId])
  @@unique([organizationId, articleRef])
  @@unique([organizationId, ownNumber])
  @@index([organizationId, name])
  @@index([organizationId, homeStoreId])
  @@index([articleId])
}

/// Saldot för en artikel på en förrådsplats (aldrig under noll, CHECK). Ändras bara tillsammans med en rad i StoreTransaction.
model StoreBalance {
  id             String        @id @default(cuid())
  organizationId String
  itemId         String
  locationId     String
  quantity       Decimal       @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item           StoreItem     @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  location       StoreLocation @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([itemId, locationId])
  @@index([organizationId, locationId])
}

/// Förrådets logg: uttag till en arbetsorder (WITHDRAWAL), återlämning (RETURN), inleverans (RECEIPT) och inventering (COUNT).
/// change är ändringen (negativ vid uttag), balanceAfter saldot efteråt; unitPrice är artikelns pris vid uttaget (för kostnaden).
model StoreTransaction {
  id                String           @id @default(cuid())
  organizationId    String
  itemId            String
  locationId        String
  kind              String
  change            Decimal          @db.Decimal(14, 4)
  balanceAfter      Decimal          @db.Decimal(14, 4)
  unitPrice         Decimal?         @db.Decimal(14, 4)
  workOrderId       String?
  maintenanceItemId String?
  machinePartId     String?
  note              String           @default("")
  userId            String
  createdAt         DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item              StoreItem        @relation(fields: [itemId, organizationId], references: [id, organizationId], onDelete: NoAction)
  location          StoreLocation    @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  workOrder         WorkflowTask?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  maintenanceItem   MaintenanceItem? @relation(fields: [maintenanceItemId], references: [id], onDelete: SetNull)
  machinePart       MachinePart?     @relation(fields: [machinePartId], references: [id], onDelete: SetNull)

  @@index([organizationId, itemId, createdAt])
  @@index([organizationId, workOrderId])
  @@index([organizationId, machinePartId])
  @@index([maintenanceItemId])
}

/// En underhållspost (2026-10-30): underhållsfälten (lib/workflow/maintenance.ts) för EN maskindel, hållen av en
/// arbetsorder som en uppgift. Utan arbetsorder är den ett utkast (t.ex. en felanmälan som väntar). source: MANUAL |
/// MACHINE_ALARM | OPERATOR. status: OPEN | DONE | CANCELLED. Stilleståndet räknas ur stoppedAt/restoredAt, lagras aldrig.
model MaintenanceItem {
  id                  String             @id @default(cuid())
  organizationId      String
  partId              String
  workOrderId         String?
  type                String             @default("")
  priority            String             @default("")
  criticality         String             @default("")
  marking             String             @default("")
  fault               String             @default("")
  cause               String             @default("")
  causeNote           String             @default("")
  reportedAt          DateTime?
  stoppedAt           DateTime?
  restoredAt          DateTime?
  status              String             @default("OPEN")
  source              String             @default("MANUAL")
  machineAlarmOrderId String?
  reportedById        String?
  completedAt         DateTime?
  version             Int                @default(1)
  createdById         String
  updatedById         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part                MachinePart        @relation(fields: [partId, organizationId], references: [id, organizationId], onDelete: NoAction)
  workOrder           WorkflowTask?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  storeTransactions   StoreTransaction[]

  @@unique([id, organizationId])
  @@index([organizationId, partId, createdAt])
  @@index([organizationId, workOrderId])
  @@index([organizationId, status])
}

/// Återkommande underhåll (2026-10-30, lib/maintenance/plan-model.ts): a plan for one machine part – what is done and
/// how often. Calendar time (unit DAY | WEEK | MONTH, `every`) keeps vilande work orders a year ahead (at most 12); drifttimmar
/// (RUN_HOURS) makes one work order when the part reaches nextRunHours, none ahead. The next occurrence counts from when the
/// previous one was actually done. CHECKs in the migration.
model MaintenancePlan {
  id               String         @id @default(cuid())
  organizationId   String
  partId           String
  name             String
  description      String         @default("")
  /// DAY | WEEK | MONTH | RUN_HOURS (CHECK)
  unit             String
  every            Int
  /// The first occurrence (YYYY-MM-DD) for calendar time.
  startDate        String
  /// RUN_HOURS: the part's drifttimmar at which the next work order is made; NULL while one is open.
  nextRunHours     Float?
  assignedToUserId String?
  assignedToName   String         @default("")
  estimatedMinutes Int?
  isActive         Boolean        @default(true)
  version          Int            @default(1)
  createdById      String
  updatedById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part             MachinePart    @relation(fields: [partId, organizationId], references: [id, organizationId], onDelete: Cascade)
  workOrders       WorkflowTask[]

  @@unique([id, organizationId])
  @@index([organizationId, partId])
}

/// Operatörssidan (2026-10-30, lib/operator): one row per company. The page's address carries `pageKey` (a random key,
/// never the company's name), so the sign-in screen knows its company without an account. The company's own causes, whether
/// a fault report becomes a work order directly or waits in the approval list, how long an operator may be inactive, the
/// Microsoft group (off by default) and the AI troubleshooting switch (off by default). CHECKs in the migration.
model OperatorSettings {
  organizationId     String       @id
  pageKey            String       @unique
  /// The company's causes as text, in order (lib/operator/rules.ts DEFAULT_CAUSES until the admin changes them).
  causes             Json         @default("[]")
  /// order (a new work order directly) | approval (the company's approval list first)
  intake             String       @default("order")
  inactivityMinutes  Int          @default(15)
  /// Microsoft-grupp: members of one group in the company's own Entra directory sign in as operators. Off by default.
  microsoftEnabled   Boolean      @default(false)
  microsoftTenantId  String?
  microsoftGroupId   String?
  microsoftGroupName String       @default("")
  /// When the directory's administrator gave the app its consent (the admin-consent answer), and the latest check.
  microsoftConsentAt DateTime?
  microsoftCheck     Json         @default("{}")
  /// AI-felsökning före felanmälan: off by default; shown only when the product owner's switch is on too.
  aiTroubleshooting  Boolean      @default(false)
  updatedAt          DateTime     @updatedAt
  updatedById        String?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Operatörskonto (2026-10-30): never a User – an account that only reports faults on the machines the admin chose
/// and sees its own reports. A password account (an e-mail address or a name such as "Press 4") or a Microsoft account made
/// at its first sign-in through the company's group (identity = tid + oid, never the e-mail address). `usernameKey` is the
/// name in lower case; a Microsoft account's is `microsoft:<oid>` (a typed name can never hold a colon).
model OperatorAccount {
  id                String                   @id @default(cuid())
  organizationId    String
  username          String
  usernameKey       String
  /// password | microsoft
  kind              String                   @default("password")
  passwordHash      String?
  microsoftTenantId String?
  microsoftObjectId String?
  displayName       String                   @default("")
  /// A shared terminal account asks for "Ditt namn" on every report.
  shared            Boolean                  @default(true)
  active            Boolean                  @default(true)
  /// Every session that started before this has ended (Spärra, a new password, Ta bort).
  sessionsRevokedAt DateTime?
  lastLoginAt       DateTime?
  createdById       String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  machines          OperatorAccountMachine[]
  sessions          OperatorSession[]
  reports           OperatorFaultReport[]

  @@unique([organizationId, usernameKey])
  @@unique([organizationId, microsoftTenantId, microsoftObjectId])
  @@unique([id, organizationId])
}

/// Which machines an operator account sees: a node of the maintenance module's machine tree and everything under it. No
/// foreign key to the tree yet (lib/operator/machines.ts is the interface; the tree is the maintenance module's). None by default.
model OperatorAccountMachine {
  accountId      String
  organizationId String
  nodeId         String
  createdAt      DateTime        @default(now())
  account        OperatorAccount @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([accountId, nodeId])
  @@index([organizationId, nodeId])
}

/// An operator's sign-in on one device: the token only as a hash, the device as the hash of its own cookie. Ends after the
/// company's inactivity time, after OPERATOR_SESSION_MAX_HOURS, when revoked, or when the account is blocked or removed.
model OperatorSession {
  id             String          @id @default(cuid())
  tokenHash      String          @unique
  accountId      String
  organizationId String
  deviceHash     String
  /// password | microsoft
  method         String
  client         String          @default("")
  createdAt      DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  revokedAt      DateTime?
  account        OperatorAccount @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@index([lastSeenAt])
}

/// Felanmälan från operatörssidan. The machine as the tree's node id and a copy of its name (the report stays readable when
/// the tree changes). status: received (a work order was made) | pending (in the approval list) | rejected. `onCall` is set
/// when Akut, or Hög outside the company's workday, went the on-call way (MACHINE_ALARM notices with acknowledgement and
/// escalation, lib/operator/on-call-store.ts); the acknowledgement is kept here.
model OperatorFaultReport {
  id                String               @id @default(cuid())
  organizationId    String
  accountId         String?
  accountName       String
  reporterName      String               @default("")
  machineNodeId     String
  machineLabel      String
  /// The object whose alarm contacts (ansvarig, ersättare) are told first; null = everyone who gets machine alarms.
  alarmFacilityId   String?
  cause             String
  text              String               @default("")
  /// LOW | NORMAL | HIGH | ACUTE
  severity          String
  status            String               @default("received")
  taskId            String?
  workOrderLabel    String               @default("")
  maintenanceItemId String?
  onCall            Boolean              @default(false)
  escalationStep    Int                  @default(0)
  escalatedAt       DateTime?
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  decidedAt         DateTime?
  decidedById       String?
  createdAt         DateTime             @default(now())
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SET NULL on the id only (the report stays when the account is removed); trigger OperatorFaultReport_account_tenant keeps it in the company.
  account           OperatorAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  photos            OperatorFaultPhoto[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([accountId, createdAt])
  @@index([organizationId, taskId])
  @@index([organizationId, status])
  @@index([onCall, acknowledgedAt])
}

/// A photo on a fault report (the same handling as a work order's attachments: lib/workflow/attachment-file.ts).
model OperatorFaultPhoto {
  id             String              @id @default(cuid())
  organizationId String
  reportId       String
  filename       String
  storagePath    String              @unique
  mimeType       String
  size           Int
  createdAt      DateTime            @default(now())
  report         OperatorFaultReport @relation(fields: [reportId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, reportId])
}

/// Serverjobb (2026-11-14, lib/ops/server-jobs.ts): one row per scheduled job the app server's cron runs in the app,
/// made by the first run. `paused` makes cron's runs stop at once (recorded as skipped_paused, exit 0); `lockedUntil` and
/// `runId` are the running run's lease (renewed every minute), so Kör nu and cron never run the same job twice at once. Only
/// the installation's own state: no company's data, a short output line at most.
model ServerJob {
  key              String    @id
  paused           Boolean   @default(false)
  pausedById       String?
  pausedAt         DateTime?
  runRequestedAt   DateTime?
  runRequestedById String?
  runId            String?
  lockedUntil      DateTime?
  lastTrigger      String?
  lastStartedAt    DateTime?
  lastFinishedAt   DateTime?
  lastStatus       String?
  lastMessage      String?
  lastDurationMs   Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Tavlor och skärmar, etapp 1 (2026-11-18, docs/beslut/tavlor-och-skarmar.md, lib/boards/): a company's dashboard. `draft` is the
/// editor's layout (lib/boards/model.ts, autosaved with `revision` as the version check); screens, links and Presentera show only a
/// published, locked BoardVersion (`publishedVersionId`). Removed boards keep their row with `deletedAt` until the company is erased.
model Board {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String         @default("")
  draft              Json
  revision           Int            @default(1)
  publishedVersionId String?
  createdById        String
  updatedById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  versions           BoardVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, deletedAt, updatedAt])
}

/// A published, locked version of a board: the layout as it was, and `visibility` – what the publisher chose for each card's
/// personal data outside the app (hidden, initials or names; hidden is the default). The figures are counted as `publishedById`.
model BoardVersion {
  id             String   @id @default(cuid())
  organizationId String
  boardId        String
  number         Int
  layout         Json
  visibility     Json     @default("{}")
  publishedById  String
  publishedAt    DateTime @default(now())
  board          Board    @relation(fields: [boardId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([boardId, number])
  @@unique([id, organizationId])
  @@index([organizationId, boardId])
}

/// A data source of the boards that holds its own rows. Etapp 1 has the kind "table" (Egen tabell, written by hand); file import,
/// push and HTTP sources (etapp 3) add kinds to the same row. `columns` is the table's columns (lib/boards/table.ts).
model BoardDataSource {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String         @default("table")
  name           String
  description    String         @default("")
  columns        Json
  config         Json           @default("{}")
  revision       Int            @default(1)
  createdById    String
  updatedById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  rows           BoardDataRow[]

  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
}

/// One row of a board table: the values by column key. `observedAt` lets the same table be a time series (etapp 3).
model BoardDataRow {
  id             String          @id @default(cuid())
  organizationId String
  sourceId       String
  position       Int             @default(0)
  values         Json
  observedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  source         BoardDataSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, sourceId, position])
}

/// A picture on a board's image card (Bild): uploaded by the company, kept in the app's own storage (lib/kfid/storage.ts) and
/// shown only through Workflow's own routes, never from a third party.
model BoardImage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filename       String
  storagePath    String
  mimeType       String
  size           Int
  createdById    String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Tavlor och skärmar, etapp 2 (2026-11-18): a spellista – boards shown in turn, each for its own number of seconds (`items`,
/// lib/boards/playlist.ts). A screen or a link shows one board or one playlist.
model BoardPlaylist {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  items          Json
  createdById    String
  updatedById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
}

/// One way in for a board without a person's sign-in (etapp 2): a connected screen (`kind` screen) or a shared link (`kind` link).
/// Only the hash of its secret is stored; a link's optional code is stored as a salted scrypt hash, five wrong codes lock it 15
/// minutes. It shows the published version of `boardId` or of the boards in `playlistId`, counted as their publisher, and can
/// never reach /api (lib/boards/guard.ts). `revokedAt` blocks it at the next fetch.
model BoardAccess {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String
  name           String       @default("")
  boardId        String?
  playlistId     String?
  tokenHash      String       @unique
  codeHash       String?
  failedCodes    Int          @default(0)
  lockedUntil    DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  screen         Screen?

  @@unique([id, organizationId])
  @@index([organizationId, kind])
}

/// A connected screen (etapp 2): its name, its settings (theme, rotation, nightly reload, burn-in), when it was last heard from and
/// a keyed hash of its network (never the address). `command` is a one-time order from Skärmar (reload, identify), taken at the
/// next fetch. A screen not heard from in 30 days is disconnected.
model Screen {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessId        String       @unique
  access          BoardAccess  @relation(fields: [accessId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name            String
  placeName       String       @default("")
  settings        Json         @default("{}")
  status          String       @default("active")
  deviceInfo      Json         @default("{}")
  lastSeenAt      DateTime?
  lastNetworkHash String?
  command         Json?
  approvedById    String
  approvedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([accessId, organizationId])
  @@index([organizationId, status])
}

/// A screen asking to be connected (etapp 2, the pattern of RFC 8628): the short code shown on the screen and the screen's own
/// secret, both only as hashes, for ten minutes. Approved inside Workflow by a person with the right Skärmar, it gets
/// `organizationId` and `screenId`; the screen then exchanges its secret for its screen key once. Old rows are removed nightly.
model ScreenPairing {
  id               String    @id @default(cuid())
  userCodeHash     String    @unique
  deviceSecretHash String    @unique
  status           String    @default("pending")
  expiresAt        DateTime
  requestInfo      Json      @default("{}")
  networkHash      String?
  organizationId   String?
  screenId         String?
  approvedAt       DateTime?
  lastPollAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
}

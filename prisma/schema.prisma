  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice              BillingInvoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  purchase             CreditPurchase?         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  sourcePaymentEvent   PaymentEvent?           @relation(fields: [sourcePaymentEventId], references: [id], onDelete: SetNull)

  @@index([organizationId, kind, status, createdAt])
  @@index([invoiceId])
  @@index([purchaseId])
  @@index([sourcePaymentEventId])
}

model PaymentEvent {
  id                 String              @id @default(cuid())
  organizationId     String?
  providerEventId    String              @unique
  eventType          String
  payloadHash        String?
  status             PaymentEventStatus  @default(RECEIVED)
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  cloudEntitlements  CloudEntitlement[]
  billingAdjustments BillingAdjustment[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model GeneratedResult {
  id             String   @id @default(cuid())
  organizationId String
  controlId      String
  requestKey     String   @unique
  kind           String
  status         String   @default("PENDING")
  content        String?
  storagePath    String?
  mimeType       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  control        Control  @relation(fields: [controlId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, controlId])
}

model WorkspaceSettings {
  id             String  @id @default(cuid())
  organizationId String  @unique
  companyName    String  @default("")
  contactEmail   String  @default("")
  logoPath       String?
  themePrimary   String?
  reportPrimary  String  @default("#174C72")
  reportAccent   String  @default("#2E7EAA")
  reportSoft     String  @default("#EDF5F9")
  suggestions    Json    @default("{}")
  profile        Json    @default("{}")
  aiPolicy       Json    @default("{}")
}

model UserPreferences {
  userId String @id
  data   Json   @default("{}")
}

/// One short digest per company and day (plan 2026-10-01, fas 4): what the rules counted (facts) and the text, written
/// by the AI model (source AI) or by the rules when it could not run (RULES). Numbers and project names only.
model AiDailyDigest {
  id             String   @id @default(cuid())
  organizationId String
  /// The Swedish calendar day the digest is about, YYYY-MM-DD.
  day            String
  text           String
  facts          Json
  source         String
  runId          String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, day])
  @@index([organizationId, createdAt])
}

model AdministrationEvent {
  id             String   @id @default(cuid())
  actorId        String
  organizationId String
  action         String
  detail         String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model SystemSettings {
  id          String @id @default("global")
  suggestions Json   @default("{}")
  commercial  Json   @default("{}")
  /// E-post settings made in the app (lib/mail/settings.ts); empty = the server's .env values.
  mail        Json   @default("{}")
  /// HINTEK AI credit settings made in the app (ee/ai/credit-settings.ts); empty = the defaults.
  ai          Json   @default("{}")
}

model ControlVisit {
  userId         String
  organizationId String
  controlId      String
  openedAt       DateTime @default(now())

  @@id([userId, organizationId, controlId])
  @@index([userId, organizationId, openedAt])
}

// Forms (2026-09-26, design v2): published centrally by the superadmin, not tenant-bound, and never customer
// data. A version is append-only (a database trigger refuses updates and deletes); protocols point to their version.
model FormTemplate {
  id               String                @id @default(cuid())
  // Company forms (2026-09-27): NULL = HINTEK's forms, shown to everyone; otherwise only that company's.
  organizationId   String?
  publisherName    String                @default("HINTEK")
  // Who made the form (2026-09-28): HINTEK, the company, or – later – a community author with a licence.
  origin           String                @default("COMPANY")
  authorName       String                @default("")
  authorUrl        String                @default("")
  license          String                @default("")
  // An imported form: the original publisher, whether the file's signature was verified, and the source form.
  importedFrom     Json?
  // A company's own version of a HINTEK original (2026-09-27): the original and the published version it started from.
  baseTemplateId   String?
  baseVersion      Int?
  // Whose permission governs the protocols: forms, kfid (Kontroll före idrifttagning) or risk-assessment.
  permissionArea   String                @default("forms")
  name             String
  description      String                @default("")
  color            String                @default("green")
  displayName      String                @default("")
  internalNote     String                @default("")
  icon             String                @default("file-spreadsheet")
  category         String                @default("OTHER")
  allowStandalone  Boolean               @default(true)
  allowInProject   Boolean               @default(true)
  status           String                @default("DRAFT")
  draft            Json
  draftRevision    Int                   @default(1)
  publishedVersion Int?
  createdBy        String
  updatedBy        String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  versions         FormTemplateVersion[]
  events           FormTemplateEvent[]
  organization     Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseTemplate     FormTemplate?         @relation("FormTemplateCopies", fields: [baseTemplateId], references: [id], onDelete: SetNull)
  copies           FormTemplate[]        @relation("FormTemplateCopies")

  @@unique([organizationId, baseTemplateId])
  @@index([status, updatedAt])
  @@index([organizationId, status, updatedAt])
}

model FormTemplateVersion {
  id              String         @id @default(cuid())
  templateId      String
  version         Int
  name            String
  description     String         @default("")
  color           String         @default("green")
  displayName     String         @default("")
  icon            String         @default("file-spreadsheet")
  category        String         @default("OTHER")
  allowStandalone Boolean        @default(true)
  allowInProject  Boolean        @default(true)
  document        Json
  hash            String
  publishedBy     String
  publisherName   String         @default("HINTEK")
  importedFrom    Json?
  createdAt       DateTime       @default(now())
  template        FormTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  protocols       WorkflowTask[]

  @@unique([templateId, version])
}

model FormTemplateEvent {
  id          String       @id @default(cuid())
  templateId  String
  action      String
  summary     String
  actorUserId String
  actorName   String
  createdAt   DateTime     @default(now())
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
}

/// Limit profiles (2026-09-28): a company's own limit values for one form family at one facility, optionally per
/// object there (objectName, e.g. unit G1). The form only names the limits; the numbers belong to the facility.
model FormLimitProfile {
  id             String           @id @default(cuid())
  organizationId String
  // The form family: the HINTEK original's id also for a company's version of it. No foreign key, so the values
  // survive a deleted or replaced form.
  templateId     String
  facilityId     String
  objectName     String           @default("")
  values         Json
  version        Int              @default(1)
  updatedBy      String
  updatedByName  String           @default("")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       CustomerFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, templateId, facilityId, objectName])
  @@index([organizationId, facilityId])
}

/// Återkommande kontroller (2026-09-28): a round of one form at a facility, customer or project, repeated daily,
/// weekly or monthly (rule, lib/workflow/form-schedule.ts). Protocols are made when a round is started and carry
/// the schedule and the day in their answers (values.round); nothing is created in advance.
model FormSchedule {
  id               String            @id @default(cuid())
  organizationId   String
  templateId       String
  title            String
  customerId       String?
  facilityId       String?
  projectId        String?
  assignedToUserId String?
  assignedToName   String            @default("")
  rule             Json
  // Round reminders (2026-09-30): { bell, email }.
  reminders        Json              @default("{}")
  active           Boolean           @default(true)
  version          Int               @default(1)
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facility         CustomerFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  reminderDeliveries RoundReminderDelivery[]

  @@index([organizationId, active, deletedAt])
  @@index([organizationId, facilityId])
}

/// One e-mail reminder per round, day and recipient (2026-09-30), so the job never sends twice.
model RoundReminderDelivery {
  id             String       @id @default(cuid())
  organizationId String
  scheduleId     String
  occurrence     String
  userId         String
  status         String
  failure        String?
  createdAt      DateTime     @default(now())
  schedule       FormSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, occurrence, userId])
  @@index([organizationId, createdAt])
}

/// HINTEK AI memory (2026-09-30): the company's general memory (scope COMPANY, subject "company") and a
/// pseudonymised memory per user (scope USER, subject = keyed hash of company and user). At most 2000 characters.
model AiMemory {
  id             String       @id @default(cuid())
  organizationId String
  scope          String
  subject        String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, subject])
}

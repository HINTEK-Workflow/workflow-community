generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  STAFF
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationInvitationStatus {
  PREPARED
  PENDING
  ACCEPTED
  REVOKED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  DPA
  CREDIT_TERMS
}

enum LegalDocumentScope {
  INDIVIDUAL
  ORGANIZATION
}

enum LegalDocumentStatus {
  DRAFT
  PUBLISHED
  REVOKED
}

enum DataStorageMode {
  LOCAL
  HINTEK_CLOUD
}

enum CloudSubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
  CREDITED
}

enum BillingNoticeStage {
  DUE_TODAY
  DAY_3_REMINDER
  DAY_7_FINAL_WARNING
  DAY_8_WRITE_PAUSED
}

enum BillingNoticeEmailStatus {
  NOT_REQUESTED
  QUEUED
  SENDING
  SENT
  CANCELED
  FAILED
}

enum CreditExpiryNoticeStage {
  DAY_30
  DAY_7
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum BillingPaymentMode {
  CARD
  INVOICE_PREPAID
  INVOICE_CREDIT
}

enum BillingOrderStatus {
  DRAFT
  PENDING_PAYMENT
  OPEN
  PAID
  CANCELED
  REFUNDED
}

enum BillingAdjustmentKind {
  REFUND
  CREDIT_NOTE
}

enum BillingAdjustmentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  VOID
}

enum BillingOrderItemKind {
  CLOUD
  CREDIT_PACKAGE
}

enum BankPaymentStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  ALLOCATED
  OVERPAYMENT
  REFUNDED
}

enum CloudEntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum CloudEntitlementSource {
  CARD_PAYMENT
  INVOICE_PREPAID_PAYMENT
  INVOICE_CREDIT_FINALIZED
  ADMIN_CORRECTION
}

enum CreditLotOrigin {
  PURCHASE
  COMPENSATION
  LEGACY
}

enum AiRunStatus {
  RESERVED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  APPLIED
  EXPIRED
  /// An applied proposal whose result the person took back (fas 2).
  UNDONE
}

model User {
  id                      String                  @id @default(cuid())
  importedFiles           ImportedFile[]
  name                    String?
  image                   String?
  email                   String                  @unique
  passwordHash            String?
  role                    UserRole                @default(STAFF)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  isActive                Boolean                 @default(true)
  activeOrganizationId    String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  activeOrganization      Organization?           @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  authAccounts            AuthAccount[]
  organizationMemberships OrganizationMember[]
  verificationTokens      VerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  legalAcceptances        LegalAcceptance[]
  aiRuns                  AiRun[]
  aiConversations         AiConversation[]        @relation("AiConversationCreator")
  aiMessages              AiMessage[]             @relation("AiMessageAuthor")
  reviewedAiProposals     AiProposal[]            @relation("AiProposalReviewer")
  localWorkspaceBindings  LocalWorkspaceBinding[]
}

model AuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  hostedDomain      String?
  avatarUrl         String?
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, email])
}

model Organization {
  id                      String                     @id @default(cuid())
  name                    String
  slug                    String                     @unique
  domain                  String?
  isActive                Boolean                    @default(true)
  storageMode             DataStorageMode            @default(LOCAL)
  weeklyWorkMinutes       Int                        @default(2400)
  // History kept for a selectable time (2026-09-30); null keeps it until deleted by hand.
  historyRetentionMonths  Int?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  activeUsers             User[]                     @relation("ActiveOrganization")
  members                 OrganizationMember[]
  customers               Customer[]
  customerFacilities      CustomerFacility[]
  projects                Project[]
  controls                Control[]
  workflowTasks           WorkflowTask[]
  plannedActivities       PlannedActivity[]
  plannedActivityEvents   PlannedActivityEvent[]
  workflowTaskAttachments WorkflowTaskAttachment[]
  importedFiles           ImportedFile[]
  sites                  Site[]
  departments             Department[]
  wallet                  CreditWallet?
  invitations             OrganizationInvitation[]
  legalAcceptances        LegalAcceptance[]
  cloudSubscriptions      CloudSubscription[]
  billingInvoices         BillingInvoice[]
  billingNotices          BillingNotice[]
  creditExpiryNotices     CreditExpiryNotice[]
  creditPurchases         CreditPurchase[]
  paymentEvents           PaymentEvent[]
  billingPolicy           OrganizationBillingPolicy?
  stripeCustomers         StripeCustomer[]
  billingOrders           BillingOrder[]
  priceChangeNotices      PriceChangeNotice[]
  integrationKeys         IntegrationKey[]
  aiMemories              AiMemory[]
  bankPayments            BankPayment[]
  cloudEntitlements       CloudEntitlement[]
  billingAuditEvents      BillingAuditEvent[]
  billingAdjustments      BillingAdjustment[]
  cloudImports            CloudImport[]
  aiRuns                  AiRun[]
  aiRunEvents             AiRunEvent[]
  aiConversations         AiConversation[]
  aiMessages              AiMessage[]
  aiProposals             AiProposal[]
  workScheduleEvents      WorkScheduleEvent[]
  timeEntryEvents         WorkflowTimeEntryEvent[]
  localWorkspaceBindings  LocalWorkspaceBinding[]
  formTemplates           FormTemplate[]
  formLimitProfiles       FormLimitProfile[]
  formSchedules           FormSchedule[]
}

model OrganizationMember {
  canDeleteControls          Boolean                     @default(false)
  workflowPermissions        Json?
  weeklyWorkMinutes          Int?
  isActive                   Boolean                     @default(true)
  id                         String                      @id @default(cuid())
  organizationId             String
  userId                     String
  role                       OrganizationMemberRole      @default(MEMBER)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workScheduleEvents         WorkScheduleEvent[]         @relation("WorkScheduleMember")
  plannedActivityAssignments PlannedActivityAssignment[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId])
}

model WorkScheduleEvent {
  id              String              @id @default(cuid())
  organizationId  String
  memberId        String?
  scope           String
  previousMinutes Int?
  nextMinutes     Int?
  actorName       String              @default("")
  createdAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member          OrganizationMember? @relation("WorkScheduleMember", fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, memberId, createdAt])
}

model LocalWorkspaceBinding {
  id                               String       @id @default(cuid())
  organizationId                   String
  userId                           String
  localIdentityId                  String
  memberWeeklyWorkMinutesAtBinding Int?
  scheduleBaselineCapturedAt       DateTime?
  lastLocalScheduleUpdatedAt       DateTime?
  lastScheduleSyncedAt             DateTime?
  createdAt                        DateTime     @default(now())
  revokedAt                        DateTime?
  revokedByUserId                  String?
  organization                     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, localIdentityId])
  @@index([organizationId, userId, revokedAt])
}

model Site {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    Department[]
  controls       Control[]
  workflowTasks  WorkflowTask[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, isActive, name])
}

model Department {
  id             String         @id @default(cuid())
  organizationId String
  siteId         String
  name           String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site           @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  controls       Control[]
  workflowTasks  WorkflowTask[]

  @@unique([id, organizationId])
  @@unique([id, siteId, organizationId])
  @@unique([siteId, name])
  @@index([organizationId, siteId, isActive, name])
}

model OrganizationInvitation {
  id                  String                       @id @default(cuid())
  organizationId      String
  email               String
  name                String
  role                OrganizationMemberRole       @default(MEMBER)
  canDeleteControls   Boolean                      @default(false)
  workflowPermissions Json?
  status              OrganizationInvitationStatus @default(PREPARED)
  activeKey           String?                      @unique
  tokenHash           String?                      @unique
  expiresAt           DateTime?
  sentAt              DateTime?
  acceptedAt          DateTime?
  revokedAt           DateTime?
  invitedBy           String
  acceptedUserId      String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@index([expiresAt])
}

model LegalDocument {
  id          String              @id @default(cuid())
  type        LegalDocumentType
  scope       LegalDocumentScope
  status      LegalDocumentStatus @default(DRAFT)
  version     String
  title       String
  content     String
  contentHash String
  validFrom   DateTime?
  publishedAt DateTime?
  revokedAt   DateTime?
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@index([status, type, publishedAt])
}

model LegalAcceptance {
  id                  String        @id @default(cuid())
  documentId          String
  scopeKey            String
  userId              String
  organizationId      String?
  organizationRole    String?
  documentVersion     String
  documentContentHash String
  acceptedAt          DateTime      @default(now())
  document            LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([documentId, scopeKey])
  @@index([userId, acceptedAt])
  @@index([organizationId, acceptedAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  sentTo    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  sentTo    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  company        String             @default("")
  address        String             @default("")
  postalCode     String             @default("")
  city           String             @default("")
  email          String             @default("")
  phone          String             @default("")
  mobile         String             @default("")
  lat            Float?
  lng            Float?
  notes          String             @default("")
  version        Int                @default(1)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  controls       Control[]
  workflowTasks  WorkflowTask[]
  projects       Project[]
  facilities     CustomerFacility[]
  formSchedules  FormSchedule[]

  @@index([organizationId, deletedAt, name])
}

// A customer's facility (2026-09-26, decision 11/D9 B): a property, switchgear or other object under the
// customer that projects, work orders, risk assessments and controls can be linked to. The organization's own
// places are Site ("Platser"). Paused rather than deleted so that linked work keeps its reference; purging the
// customer removes its facilities and clears the links. Same-tenant links are enforced by a database trigger.
model CustomerFacility {
  id             String             @id @default(cuid())
  organizationId String
  customerId     String
  name           String
  address        String             @default("")
  postalCode     String             @default("")
  city           String             @default("")
  description    String             @default("")
  isActive       Boolean            @default(true)
  version        Int                @default(1)
  createdBy      String
  updatedBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projects       Project[]
  workflowTasks  WorkflowTask[]
  controls       Control[]
  limitProfiles  FormLimitProfile[]
  formSchedules  FormSchedule[]

  @@unique([id, organizationId])
  @@index([organizationId, customerId, isActive])
}

model Project {
  id                String            @id @default(cuid())
  organizationId    String
  customerId        String?
  name              String
  description       String            @default("")
  // The project's frame (2026-09-26): start and end, Swedish calendar days; both are required for new projects.
  startDate         String            @default("")
  dueDate           String            @default("")
  // Fixed project fields shown read-only in every task and printed in reports; description is the work description.
  client            String            @default("")
  contactPerson     String            @default("")
  reference         String            @default("")
  workSite          String            @default("")
  taskTypes         Json              @default("[]")
  workMoments       Json              @default("[]")
  responsibleUserId String?
  responsibleName   String            @default("")
  timeBudgetMinutes Int               @default(0)
  archivedAt        DateTime?
  // Manual "Avsluta projekt" (2026-09-26); only allowed when every task is completed and no planning is active.
  closedAt          DateTime?
  closedBy          String?
  createdBy         String
  updatedBy         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Same-tenant customer is enforced by the database trigger from migration 20260925180000_tenant_hardening;
  // a single-column FK is kept so purging a customer still only clears customerId.
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facilityId        String?
  facility          CustomerFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  controls          Control[]
  workflowTasks     WorkflowTask[]
  events            ProjectEvent[]
  decisions         ProjectDecision[]
  plannedActivities PlannedActivity[]

  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, customerId])
}

model ProjectEvent {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  kind           String
  summary        String
  taskId         String?
  actorName      String   @default("")
  createdBy      String?
  createdAt      DateTime @default(now())
  // Composite key: a history row can only belong to a project in the same organization.
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}

// The project's decision log (2026-09-26): date, text and who decided. Append-only; never edited or deleted.
model ProjectDecision {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  decidedOn      String
  text           String
  decidedBy      String
  createdBy      String
  actorName      String   @default("")
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, projectId, decidedOn])
}

model WorkflowTask {
  id                  String                   @id @default(cuid())
  organizationId      String
  projectId           String?
  customerId          String?
  siteId              String?
  departmentId        String?
  kind                String
  title               String
  description         String                   @default("")
  status              String                   @default("PLANNED")
  progress            Int                      @default(0)
  assignedToUserId    String?
  assignedToName      String                   @default("")
  dueDate             String                   @default("")
  data                Json
  version             Int                      @default(1)
  startedAt           DateTime?
  completedAt         DateTime?
  createdBy           String
  updatedBy           String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?                 @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer            Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  facilityId          String?
  facility            CustomerFacility?        @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  site                Site?                    @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department          Department?              @relation(fields: [departmentId, siteId, organizationId], references: [id, siteId, organizationId], onDelete: Restrict)
  revisions           WorkflowTaskRevision[]
  timeEntries         WorkflowTimeEntry[]
  attachments         WorkflowTaskAttachment[]
  plannedActivities   PlannedActivity[]
  // A protocol from a published form (kind FORM): the exact template version it was created from.
  formTemplateId      String?
  // The permission area of the protocol's form (forms, kfid or risk-assessment); NULL is forms.
  formArea            String?
  formTemplateVersion Int?
  formVersion         FormTemplateVersion?     @relation(fields: [formTemplateId, formTemplateVersion], references: [templateId, version], onDelete: SetNull)

  @@unique([id, organizationId])
  @@index([organizationId, formTemplateId])
  @@index([organizationId, kind, status, updatedAt])
  @@index([organizationId, projectId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, siteId, departmentId])
}

model WorkflowTaskRevision {
  id        String       @id @default(cuid())
  taskId    String
  version   Int
  snapshot  Json
  createdBy String
  createdAt DateTime     @default(now())
  task      WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([taskId, createdAt])
}

// A time entry belongs to exactly one work order/risk assessment (taskId) or one commissioning control (controlId,
// 2026-09-26 decision 13: manual registration only, controls have no start/pause). A CHECK constraint in the
// migration enforces exactly one of the two.
model WorkflowTimeEntry {
  id          String        @id @default(cuid())
  taskId      String?
  controlId   String?
  userId      String
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int           @default(0)
  note        String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  task        WorkflowTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  control     Control?      @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@index([controlId, startedAt])
  @@index([userId, startedAt])
}

// Append-only audit of manual time registration and corrections. Deliberately not a foreign key
// to WorkflowTimeEntry so the history survives deletion of the entry or its task.
model WorkflowTimeEntryEvent {
  id             String       @id @default(cuid())
  organizationId String
  entryId        String
  userId         String
  action         String
  previous       Json?
  next           Json?
  reason         String       @default("")
  actorUserId    String
  actorName      String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entryId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model PlannedActivity {
  id               String                      @id @default(cuid())
  organizationId   String
  projectId        String?
  workflowTaskId   String?
  controlId        String?
  title            String
  description      String                      @default("")
  kind             String                      @default("TASK")
  status           String                      @default("PLANNED")
  startsAt         DateTime
  endsAt           DateTime
  assignedToUserId String?
  assignedToName   String                      @default("")
  version          Int                         @default(1)
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?                    @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workflowTask     WorkflowTask?               @relation(fields: [workflowTaskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  control          Control?                    @relation(fields: [controlId, organizationId], references: [id, organizationId], onDelete: Restrict)
  events           PlannedActivityEvent[]
  assignments      PlannedActivityAssignment[]

  @@unique([id, organizationId])
  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, projectId, startsAt])
  @@index([organizationId, workflowTaskId, startsAt])
  @@index([organizationId, controlId, startsAt])
  @@index([organizationId, assignedToUserId, startsAt])
}

model PlannedActivityAssignment {
  id                String             @id @default(cuid())
  organizationId    String
  plannedActivityId String
  memberId          String
  plannedMinutes    Int?
  startsAt          DateTime?
  endsAt            DateTime?
  plannedActivity   PlannedActivity    @relation(fields: [plannedActivityId, organizationId], references: [id, organizationId], onDelete: Cascade)
  member            OrganizationMember @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([plannedActivityId, memberId])
  @@index([organizationId, memberId, plannedActivityId])
}

model PlannedActivityEvent {
  id                String          @id @default(cuid())
  organizationId    String
  plannedActivityId String
  kind              String
  summary           String
  snapshot          Json
  actorName         String          @default("")
  createdBy         String?
  createdAt         DateTime        @default(now())
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plannedActivity   PlannedActivity @relation(fields: [plannedActivityId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, plannedActivityId, createdAt])
}

model WorkflowTaskAttachment {
  id             String       @id @default(cuid())
  organizationId String
  taskId         String
  filename       String
  storagePath    String       @unique
  mimeType       String
  size           Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           WorkflowTask @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, taskId])
}

// A file saved from the Import page that is not on a task yet: private to the person who uploaded it until it is
// attached to a task or removed (2026-10-02: the file is saved first, the person chooses where later).
model ImportedFile {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  filename       String
  storagePath    String       @unique
  mimeType       String
  size           Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
}

model Control {
  id                String              @id @default(cuid())
  number            Int                 @unique @default(autoincrement())
  organizationId    String
  customerId        String?
  projectId         String?
  siteId            String?
  departmentId      String?
  title             String
  project           String              @default("")
  performer         String              @default("")
  date              String              @default("")
  status            String              @default("DRAFT")
  data              Json
  version           Int                 @default(1)
  createdBy         String
  updatedBy         String
  lockToken         String?
  lockedBy          String?

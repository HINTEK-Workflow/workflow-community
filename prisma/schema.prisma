model User {
  id                            String                         @id @default(cuid())
  importedFiles                 ImportedFile[]
  oauthCodes                    OAuthAuthorizationCode[]
  oauthGrants                   OAuthGrant[]
  name                          String?
  image                         String?
  email                         String                         @unique
  passwordHash                  String?
  role                          UserRole                       @default(STAFF)
  emailVerifiedAt               DateTime?
  lastLoginAt                   DateTime?
  // A password change or reset ends every session started before it (2026-10-02).
  passwordChangedAt             DateTime?
  /// Logga ut överallt (2026-10-10): every session started before it has ended, also tokens without a session row.
  sessionsRevokedAt             DateTime?
  /// Tvåstegsverifiering (TOTP, 2026-10-10): the secret sealed like the server keys (lib/mail/settings.ts sealPassword).
  totpSecret                    String?
  /// A secret shown as a QR code but not yet confirmed with a code; it becomes totpSecret only after a valid code.
  totpPendingSecret             String?
  totpEnabledAt                 DateTime?
  /// The last accepted 30-second step, so the same code can never be used twice.
  totpLastStep                  Int?
  // Nyhetsutskick (2026-10-03): when the person said yes to news about changes and improvements; null = no.
  newsletterOptInAt             DateTime?
  isActive                      Boolean                        @default(true)
  activeOrganizationId          String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  activeOrganization            Organization?                  @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  authAccounts                  AuthAccount[]
  organizationMemberships       OrganizationMember[]
  verificationTokens            VerificationToken[]
  passwordResetTokens           PasswordResetToken[]
  legalAcceptances              LegalAcceptance[]
  aiRuns                        AiRun[]
  aiConversations               AiConversation[]               @relation("AiConversationCreator")
  aiMessages                    AiMessage[]                    @relation("AiMessageAuthor")
  reviewedAiProposals           AiProposal[]                   @relation("AiProposalReviewer")
  localWorkspaceBindings        LocalWorkspaceBinding[]
  selfInspectionCredentials     SelfInspectionCredential[]
  backupCodes                   UserBackupCode[]
  sessions                      UserSession[]
  passkeys                      UserPasskey[]
  selfInspectionCompetenceCards SelfInspectionCompetenceCard[]
  catalogueFavorites            CatalogueFavorite[]
}

/// Passkeys (2026-10-11): WebAuthn credentials the person registered under Mina inställningar → Säkerhet, for signing
/// in with Face ID, fingerprint, Windows Hello or a security key. Only the public key, the signature counter and what
/// the browser said about transports and backup are kept; the private key never leaves the person's device. The name
/// is the person's own label. Removed with the person (cascade and lib/auth/erasure.ts).
model UserPasskey {
  id           String    @id @default(cuid())
  userId       String
  /// The credential id, base64url, as the browser returns it; unique across the installation.
  credentialId String    @unique
  publicKey    Bytes
  /// The authenticator's signature counter (uint32); most synced passkeys always send 0.
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// singleDevice or multiDevice (synced), and whether it is backed up, as the authenticator reported at registration.
  deviceType   String    @default("")
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// WebAuthn challenges (2026-10-11): one row per started passkey ceremony, single use (deleted when used) and short
/// lived; the random id travels in the httpOnly cookie wf-passkey. purpose is login, register or reauth; userId is set
/// for register and reauth. Expired rows are removed when new ones are made and by the nightly cleanup.
model WebAuthnChallenge {
  id        String   @id
  purpose   String
  userId    String?
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Reservkoder (2026-10-10): ten one-time codes for two-factor sign-in, stored only as a keyed hash and marked used.
model UserBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

/// Aktiva inloggningar (2026-10-10): one row per signed-in browser. The JWT carries the row's id; the jwt callback
/// refuses a token whose row is revoked or gone. A coarse device text and a keyed hash of the IP address only.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  /// password, password+totp, password+backup or google
  method     String
  client     String    @default("")
  ipHash     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Färsk inloggning: when the person last confirmed with password or code in this session.
  reauthAt   DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

/// Säkerhetslogg (2026-10-10): sign-ins, two-factor changes, password changes, ended sessions and API keys. No
/// passwords, codes, tokens or free text from people; the IP address only as a keyed HMAC (pseudonymised, not
/// anonymous) and a coarse browser text. organizationId is set for company events (API keys, the company's rule, an
/// admin's sign-out of a member); platform marks installation-level events the superadmin may see. Removed after 12
/// months by the nightly system cleanup and with the person or the company.
model SecurityEvent {
  id             String   @id @default(cuid())
  type           String
  userId         String?
  actorId        String?
  organizationId String?
  platform       Boolean  @default(false)
  client         String   @default("")
  ipHash         String?
  detail         String   @default("")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([platform, createdAt])
  @@index([createdAt])
}

model AuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  hostedDomain      String?
  avatarUrl         String?
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, email])
}


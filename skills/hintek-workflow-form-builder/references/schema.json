{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hintek-workflow-forms:format-1",
  "title": "Form file (hintek-workflow-forms, formatVersion 1)",
  "description": "A form file for the Workflow form import. Generated from the import's own validation; objects accept no other keys. Leave out \"signature\": only Workflow signs files.",
  "x-skill-version": "1.0.0",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "hintek-workflow-forms"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "exportedBy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "hintek": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "hintek"
      ],
      "additionalProperties": false
    },
    "forms": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceTemplateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sourceVersion": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "publisherName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "meta": {
            "type": "object",
            "properties": {
              "name": {
                "default": "",
                "type": "string",
                "maxLength": 120
              },
              "displayName": {
                "default": "",
                "type": "string",
                "maxLength": 120
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 500
              },
              "color": {
                "default": "green",
                "type": "string",
                "enum": [
                  "green",
                  "blue",
                  "violet",
                  "amber",
                  "rose",
                  "cyan"
                ]
              },
              "icon": {
                "default": "file-spreadsheet",
                "type": "string",
                "enum": [
                  "file-spreadsheet",
                  "clipboard-check",
                  "list-checks",
                  "gauge",
                  "zap",
                  "plug",
                  "wrench",
                  "shield-check",
                  "shield-alert",
                  "flame",
                  "thermometer",
                  "camera",
                  "building"
                ]
              },
              "category": {
                "default": "OTHER",
                "type": "string",
                "enum": [
                  "ELECTRICAL",
                  "POWER",
                  "INDUSTRY",
                  "ROUNDS",
                  "PROPERTY",
                  "SAFETY",
                  "OTHER"
                ]
              },
              "allowStandalone": {
                "default": true,
                "type": "boolean"
              },
              "allowInProject": {
                "default": true,
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "document": {
            "type": "object",
            "properties": {
              "schema": {
                "default": 1,
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  }
                ]
              },
              "blocks": {
                "maxItems": 300,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Block"
                    },
                    {
                      "$ref": "#/$defs/ColumnsBlock"
                    },
                    {
                      "$ref": "#/$defs/Section"
                    }
                  ]
                }
              },
              "report": {
                "default": {
                  "title": "",
                  "code": "",
                  "taskFacts": true
                },
                "$ref": "#/$defs/Report"
              },
              "moments": {
                "default": {
                  "label": "Moment",
                  "requireOne": false,
                  "placement": "top"
                },
                "$ref": "#/$defs/Moments"
              },
              "task": {
                "default": {
                  "layout": "panel",
                  "titleKey": "",
                  "requiredMarks": true,
                  "newTitle": "",
                  "tagline": ""
                },
                "$ref": "#/$defs/Task"
              },
              "limits": {
                "default": [],
                "maxItems": 100,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Limit"
                }
              },
              "limitObjectKey": {
                "default": "",
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "blocks"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "sourceTemplateId",
          "sourceVersion",
          "publisherName",
          "meta",
          "document"
        ],
        "additionalProperties": false
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "exportedAt",
    "exportedBy",
    "forms"
  ],
